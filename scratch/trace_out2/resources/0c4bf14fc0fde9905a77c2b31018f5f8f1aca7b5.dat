pe":null,"validation_description":null,"subheading":"Share your honest view","placeholder":"Mention the most important gap or action, if one stands out.","minChar":10,"maxChar":500,"allow_multiple_answers":null,"start_range":null,"end_range":null,"low_rating_label":null,"high_rating_label":null,"options":null,"dropdown_options":null,"fields":null,"super_j_question_id":null,"ranking_groups":null,"next":null,"complete":["__ALWAYS__"],"terminate":null,"expectedAnswer":[],"validationQuestion":false,"filterFrom":null,"filterOut":null,"filterFromConfig":null,"filterOutConfig":null,"showIf":null,"showIfElse":null,"showIfLogic":null,"shuffle":null,"break_heading":null,"break_message":null,"breakVariant":null,"progress_percent":null,"keyboardType":null,"flow_key":"COMPENSATION_FAIRNESS","business_role":"close","route_group":"recognition_fairness","analysis_tags":["compensation_fairness","support_awareness","support_access","support_usefulness","support_unmet_need","policy_priority","urgent_problem","greatest_impact_action","open_ended_theme","workplace_pain_point_frequency","workplace_pain_point_severity","flexibility_request_comfort","team_support","workplace_pride"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null}],"media_request":null,"research_brief":null,"research_framework":null,"context_request":null,"qna_context":null,"audience_payload":{"Nccs":{"A1":20,"A2":20,"A3":15,"B1":25,"B2":20},"Pune":{"tier":"tier1","total":100},"male":250,"24-35":{"total":300},"35-45":{"total":200},"Delhi":{"tier":"tier1","total":100},"title":"The New Parent Workday","total":500,"Mumbai":{"tier":"tier1","total":100},"female":250,"Bangalore":{"tier":"tier1","total":100},"Hyderabad":{"tier":"tier1","total":100},"checkCity":true,"Attributes":{"Currently employed in a paid role":100,"Remote, hybrid, or office-based workers":100,"Expecting parents or parents of young children":100},"created_by":"hercules","previousstate":{}},"cta_buttons":null,"end_message":null,"see_why":null,"superJSurveyId":"6a7ecf7415203e92a622fd3a","superJSurveyName":"Are Workplaces Ready for New Parents?","businessId":null,"error":null,"changes_detected":true,"log_message":null,"exhausted":false,"usage_info":{"tier_type":"FREE","daily_limit":null,"tokens_used_today":0,"tokens_remaining":0,"chat_context_limit":400000,"chat_tokens_used":0,"chat_tokens_remaining":400000,"monthly_chat_limit":10,"chats_created_this_month":1,"chats_remaining":9,"exhausted":false,"exhausted_reason":null},"business_flow":{"text":"{\n  \"version\": \"1.0\",\n  \"source\": \"generated\",\n  \"locked_predefined_design\": false,\n  \"study_type\": \"Employee engagement and organizational health study among expecting parents and parents of young children\",\n  \"research_design\": {\n    \"design\": \"linear\",\n    \"stimulus_count\": 0,\n    \"cells\": [],\n    \"rotation\": \"none\",\n    \"justification\": \"The brief specifies a linear, modular funnel with zero discrete stimuli and no experimental cells. The flow moves from eligibility and current work context through engagement, role and growth, manager, team, culture, wellbeing, and recognition measures.\"\n  },\n  \"business_goal\": \"Determine which workplace policies, manager practices, team norms, and benefits employers should prioritise to reduce workplace friction for expecting parents and parents of young children across remote, hybrid, and office-based work. Results will inform decisions on flexible-work policy, schedule predictability, manager accountability, childcare support, career protection, and implementation of existing benefits.\",\n  \"questionnaire_intent\": \"Use an empathetic, anonymous, mobile-friendly organizational-health questionnaire with exactly 20 respondent-facing question keys. The flow begins with parent eligibility and current work model, then measures engagement, role and growth, manager and team experience, culture, wellbeing, and recognition; compact grids and targeted open-ended components capture the broader parent-workplace diagnostic within the fixed budget.\",\n  \"survey_objectives\": [\n    {\n      \"objective\": \"Measure overall workplace engagement, pride, retention intent, and recommendation likelihood among eligible working parents to establish the organizational-health baseline.\",\n      \"importance\": \"Leadership needs a common outcome benchmark against which workplace pain points, flexibility experiences, and support interventions can be evaluated.\"\n    },\n    {\n      \"objective\": \"Measure current work model and parent-life-stage eligibility across remote, hybrid, and mainly office-based respondents to compare workplace experiences by work arrangement and caregiving situation.\",\n      \"importance\": \"The business must distinguish location-related problems from broader flexibility and caregiving barriers.\"\n    },\n    {\n      \"objective\": \"Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children.\",\n      \"importance\": \"Career penalties may create longer-term retention and equity risks even when day-to-day flexibility is available.\"\n    },\n    {\n      \"objective\": \"Measure manager effectiveness, psychological safety, comfort raising caregiving needs, and manager behaviours that should be amplified.\",\n      \"importance\": \"Formal flexibility may remain unusable if managers respond negatively or inconsistently to caregiving needs.\"\n    },\n    {\n      \"objective\": \"Measure belonging and teamwork quality to assess whether team norms and collaboration practices create avoidable friction for working parents.\",\n      \"importance\": \"Team behaviour can determine whether flexible arrangements work in practice.\"\n    },\n    {\n      \"objective\": \"Measure alignment with organizational values, perceptions of culture, and the single cultural or policy change respondents most want.\",\n      \"importance\": \"The business needs bottom-up evidence to design credible, parent-supportive culture and policy changes.\"\n    },\n    {\n      \"objective\": \"Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items.\",\n      \"importance\": \"These measures identify whether workplace practices are damaging wellbeing, concentration, productivity, and the ability to disconnect.\"\n    },\n    {\n      \"objective\": \"Measure whether contributions are recognized and whether workplace fairness is perceived, including compensation and treatment of employees using flexibility.\",\n      \"importance\": \"Perceived unfairness can weaken engagement and increase the risk that parents leave the organization.\"\n    },\n    {\n      \"objective\": \"Capture awareness, access, usefulness, unmet need, policy priorities, the most urgent workplace problem, the highest-impact employer action, and concrete examples through compact sub-items within the closing measures.\",\n      \"importance\": \"Leadership requires a practical action roadmap rather than only diagnostic engagement scores.\"\n    }\n  ],\n  \"targeted_insights\": [\n    {\n      \"insight\": \"Which workplace conditions are most strongly associated with low engagement, poor work-life balance, and intention to leave among expecting parents and parents of young children.\",\n      \"linked_objectives\": [\n        \"Measure overall workplace engagement, pride, retention intent, and recommendation likelihood among eligible working parents to establish the organizational-health baseline.\",\n        \"Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items.\",\n        \"Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children.\"\n      ],\n      \"decision_impact\": \"Prioritise the workplace conditions most likely to improve retention and employee experience.\"\n    },\n    {\n      \"insight\": \"Whether remote, hybrid, or office-based work is associated with different levels of schedule friction, care conflict, productivity difficulty, and engagement.\",\n      \"linked_objectives\": [\n        \"Measure current work model and parent-life-stage eligibility across remote, hybrid, and mainly office-based respondents to compare workplace experiences by work arrangement and caregiving situation.\",\n        \"Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items.\"\n      ],\n      \"decision_impact\": \"Set work-location and hybrid-attendance policies based on actual parent experience rather than assumptions about remote work.\"\n    },\n    {\n      \"insight\": \"Whether manager support and team norms matter more than the formal availability of flexible work.\",\n      \"linked_objectives\": [\n        \"Measure manager effectiveness, psychological safety, comfort raising caregiving needs, and manager behaviours that should be amplified.\",\n        \"Measure belonging and teamwork quality to assess whether team norms and collaboration practices create avoidable friction for working parents.\",\n        \"Capture awareness, access, usefulness, unmet need, policy priorities, the most urgent workplace problem, the highest-impact employer action, and concrete examples through compact sub-items within the closing measures.\"\n      ],\n      \"decision_impact\": \"Choose between manager training, team-norm interventions, policy redesign, or improved communication and access.\"\n    },\n    {\n      \"insight\": \"How workplace barriers differ between expecting parents, parents of infants, parents of older young children, and different work models.\",\n      \"linked_objectives\": [\n        \"Measure current work model and parent-life-stage eligibility across remote, hybrid, and mainly office-based respondents to compare workplace experiences by work arrangement and caregiving situation.\",\n        \"Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items.\",\n        \"Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children.\"\n      ],\n      \"decision_impact\": \"Develop life-stage-specific and situation-specific support rather than a single universal parent policy.\"\n    },\n    {\n      \"insight\": \"The most urgent workplace problem and the employer action respondents believe would have the greatest practical impact.\",\n      \"linked_objectives\": [\n        \"Measure alignment with organizational values, perceptions of culture, and the single cultural or policy change respondents most want.\",\n        \"Capture awareness, access, usefulness, unmet need, policy priorities, the most urgent workplace problem, the highest-impact employer action, and concrete examples through compact sub-items within the closing measures.\"\n      ],\n      \"decision_impact\": \"Create the immediate employer action roadmap and prioritize investment.\"\n    },\n    {\n      \"insight\": \"Whether career visibility, recognition, and fairness concerns create a distinct risk for parents using or seeking flexible work.\",\n      \"linked_objectives\": [\n        \"Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children.\",\n        \"Measure whether contributions are recognized and whether workplace fairness is perceived, including compensation and treatment of employees using flexibility.\"\n      ],\n      \"decision_impact\": \"Design career-protection, evaluation, promotion, recognition, and fairness safeguards.\"\n    }\n  ],\n  \"respondent_segments\": [\n    {\n      \"key\": \"expecting_parent\",\n      \"definition\": \"Currently working in a paid role and expecting a child or planning parental leave.\",\n      \"qualification_rule\": \"PARENT_STATUS = Expecting a child or planning parental leave\",\n      \"expected_path\": \"Eligibility and work model, followed by all seven organizational-health sections with expecting-parent-specific sub-items shown where relevant.\"\n    },\n    {\n      \"key\": \"parent_of_infant\",\n      \"definition\": \"Currently working in a paid role and caring for a child in the infant age band.\",\n      \"qualification_rule\": \"PARENT_STATUS = Parent of an infant or young child AND parent-life-stage sub-item = Infant\",\n      \"expected_path\": \"Eligibility and work model, followed by all seven organizational-health sections with current-child and childcare sub-items shown where relevant.\"\n    },\n    {\n      \"key\": \"parent_of_older_young_child\",\n      \"definition\": \"Currently working in a paid role and caring for an older young child within the study definition.\",\n      \"qualification_rule\": \"PARENT_STATUS = Parent of an infant or young child AND parent-life-stage sub-item = Older young child\",\n      \"expected_path\": \"Eligibility and work model, followed by all seven organizational-health sections with current-child and childcare sub-items shown where relevant.\"\n    },\n    {\n      \"key\": \"not_currently_working\",\n      \"definition\": \"Respondent does not currently work in a paid role.\",\n      \"qualification_rule\": \"PARENT_STATUS = Not currently working in a paid role\",\n      \"expected_path\": \"Terminate immediately as ineligible.\"\n    },\n    {\n      \"key\": \"not_eligible_parent\",\n      \"definition\": \"Respondent is working but is neither expecting a child, planning parental leave, nor parenting a young child.\",\n      \"qualification_rule\": \"PARENT_STATUS = None of these\",\n      \"expected_path\": \"Terminate immediately as ineligible.\"\n    },\n    {\n      \"key\": \"unsupported_work_model\",\n      \"definition\": \"Eligible parent whose current work arrangement is outside remote, hybrid, or mainly office-based work.\",\n      \"qualification_rule\": \"CURRENT_WORK_MODEL = Other arrangement\",\n      \"expected_path\": \"Terminate immediately as outside the defined work-model audience.\"\n    }\n  ],\n  \"questionnaire_sections\": [\n    {\n      \"key\": \"overall_engagement\",\n      \"purpose\": \"Establish parent eligibility, current work model, overall engagement, pride, and retention baseline. Supports objectives 1 and 2.\",\n      \"question_keys\": [\n        \"PARENT_STATUS\",\n        \"CURRENT_WORK_MODEL\",\n        \"ENPS_SCORE\",\n        \"WORKPLACE_PRIDE\",\n        \"RETENTION_INTENT\"\n      ]\n    },\n    {\n      \"key\": \"role_growth\",\n      \"purpose\": \"Measure role clarity, growth, career visibility, practical flexibility, pain-point frequency and severity, caregiving context, childcare access, and policy barriers using compact sub-items within the three mandated questions. Supports objectives 2, 3, 7, and 9.\",\n      \"question_keys\": [\n        \"ROLE_CLARITY\",\n        \"GROWTH_OPPORTUNITY\",\n        \"UNSupported_GOALS\"\n      ]\n    },\n    {\n      \"key\": \"manager_relationship\",\n      \"purpose\": \"Measure manager effectiveness, psychological safety, comfort requesting flexibility, responses to caregiving needs, and positive manager behaviours through the mandated manager measures. Supports objective 4.\",\n      \"question_keys\": [\n        \"MANAGER_EFFECTIVENESS\",\n        \"SAFETY_COMFORT\",\n        \"MANAGER_STRENGTHS\"\n      ]\n    },\n    {\n      \"key\": \"team_collaboration\",\n      \"purpose\": \"Measure belonging, teamwork quality, meeting norms, collaboration friction, and team support for caregiving through the two mandated team measures. Supports objective 5.\",\n      \"question_keys\": [\n        \"TEAM_BELONGING\",\n        \"TEAMWORK_QUALITY\"\n      ]\n    },\n    {\n      \"key\": \"culture_values\",\n      \"purpose\": \"Measure value alignment, culture perception, the most urgent cultural change, and bottom-up policy or manager ideas through the mandated culture measures. Supports objectives 6 and 9.\",\n      \"question_keys\": [\n        \"VALUE_ALIGNMENT\",\n        \"CULTURE_WORDS\",\n        \"CULTURE_CHANGE\"\n      ]\n    },\n    {\n      \"key\": \"wellbeing_workload\",\n      \"purpose\": \"Measure workload manageability, boundary erosion, care interruptions, productivity barriers, work-life balance, wellbeing, and work-care overlap through compact sub-items within the two mandated measures. Supports objectives 7 and 8.\",\n      \"question_keys\": [\n        \"WORKLOAD_MANAGEABLE\",\n        \"WORKLIFE_BALANCE\"\n      ]\n    },\n    {\n      \"key\": \"recognition_fairness\",\n      \"purpose\": \"Measure recognition, fairness, support awareness and usefulness, unmet needs, policy priorities, urgent problem, greatest-impact action, and a concise concrete example through compact sub-items within the two mandated measures. Supports objectives 8 and 9 and closes the survey.\",\n      \"question_keys\": [\n        \"CONTRIBUTION_RECOGNIZED\",\n        \"COMPENSATION_FAIRNESS\"\n      ]\n    }\n  ],\n  \"business_rules\": [\n    {\n      \"id\": \"BR1\",\n      \"plain_english\": \"Use PARENT_STATUS as the combined eligibility and parent-life-stage screener. Terminate respondents who are not currently working in a paid role or who are neither expecting a child, planning parental leave, nor parenting a young child.\"\n    },\n    {\n      \"id\": \"BR2\",\n      \"plain_english\": \"If CURRENT_WORK_MODEL is Other arrangement, terminate as outside the defined remote, hybrid, or mainly office-based audience.\"\n    },\n    {\n      \"id\": \"BR3\",\n      \"plain_english\": \"Show only the pregnancy, leave, return-to-work, childcare, child-age, and care-interruption sub-items relevant to the respondent's PARENT_STATUS and parent-life-stage response; skip irrelevant sub-items without creating additional respondent-facing question keys.\"\n    },\n    {\n      \"id\": \"BR4\",\n      \"plain_english\": \"Use ROLE_CLARITY, GROWTH_OPPORTUNITY, and UNSupported_GOALS as compact grids or structured modules to stay within the exact 20-question budget while retaining measures of schedule control, pain-point frequency and severity, career visibility, support gaps, and policy barriers.\"\n    },\n    {\n      \"id\": \"BR5\",\n      \"plain_english\": \"Use WORKLOAD_MANAGEABLE and WORKLIFE_BALANCE as compact grids containing boundary erosion, after-hours work, meeting spillover, care interruptions, productivity barriers, wellbeing, and work-care overlap items.\"\n    },\n    {\n      \"id\": \"BR6\",\n      \"plain_english\": \"Use CULTURE_CHANGE and the closing recognition/fairness module to capture forced prioritisation, the most urgent problem, greatest-impact employer action, support-policy awareness/access/usefulness, and one bottom-up example.\"\n    },\n    {\n      \"id\": \"BR7\",\n      \"plain_english\": \"Ask sensitive workplace and caregiving items using empathetic, no-blame wording and reassure respondents that answers are anonymous and reported in aggregate.\"\n    },\n    {\n      \"id\": \"BR8\",\n      \"plain_english\": \"Do not ask age, gender, city, residence, income, NCCS, or other database-known targeting variables; use audience-payload fields for those analyses.\"\n    },\n    {\n      \"id\": \"BR9\",\n      \"plain_english\": \"Place behavior and experience measures before evaluations and prioritisation. Use fully labelled five-point scales, limited grids, balanced prioritisation, and targeted open-ended components.\"\n    },\n    {\n      \"id\": \"BR10\",\n      \"plain_english\": \"Apply attention checks, speedster detection, straight-line detection, duplicate/inconsistency screening, and open-ended quality review. Quality failures are quality terminates, not ordinary screen-outs.\"\n    },\n    {\n      \"id\": \"BR11\",\n      \"plain_english\": \"After respondents complete RECOGNITION_FAIRNESS, including support evaluation, prioritisation, urgent problem, greatest-impact action, and bottom-up example components, complete the survey.\"\n    }\n  ],\n  \"dynamic_lists\": [],\n  \"branch_blocks\": [],\n  \"termination_and_completion_policy\": [\n    {\n      \"condition\": \"PARENT_STATUS indicates that the respondent is not currently working in a paid role.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"PARENT_STATUS indicates None of these: the respondent is neither expecting a child, planning parental leave, nor parenting a young child.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"CURRENT_WORK_MODEL indicates Other arrangement.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"A pregnancy, child-age, childcare, leave, return-to-work, care-interruption, or career-risk sub-item does not apply to the respondent's parent-life-stage or reported experience.\",\n      \"outcome\": \"skip\"\n    },\n    {\n      \"condition\": \"Respondent fails an attention check or quality screen based on speed, straight-lining, duplication, inconsistency, or unusable open-ended content.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"Respondent completes all applicable content through the recognition, support, prioritisation, and decision-close components within RECOGNITION_FAIRNESS.\",\n      \"outcome\": \"complete\"\n    }\n  ],\n  \"question_generation_instructions\": [\n    \"METHODOLOGY: Employee Engagement — Organizational Health Methodology. Preserve the seven sections and exact order: Overall Engagement, Role & Growth, Manager Relationship, Team & Collaboration, Culture & Values, Wellbeing & Workload, and Recognition & Fairness. Use exactly 20 respondent-facing question keys, with no stimuli or experimental cells.\",\n    \"Use the mandated flow keys exactly as provided. Do not add demographic targeting keys or additional respondent-facing keys.\",\n    \"Use PARENT_STATUS as a combined eligibility and life-stage screener so the exact 20-question budget is maintained. Include expecting-parent, current-parent, not-working, and none-of-these response paths.\",\n    \"Keep the tone empathetic, anonymous, neutral, and no-blame. Avoid leading agree/disagree batteries.\",\n    \"Use compact grids and structured sub-items to capture current/preferred work arrangement, schedule control, childcare access, care interruptions, pain-point frequency and severity, boundary erosion, productivity barriers, career visibility, policy awareness/access/usefulness, and unmet need without adding question keys.\",\n    \"Implement the advanced techniques: include a stay/leave or retention-risk signal through RETENTION_INTENT, a workplace/career risk signal within ROLE_CLARITY or GROWTH_OPPORTUNITY, and a bottom-up policy or manager-behaviour example within CULTURE_CHANGE or the closing recognition/fairness module.\",\n    \"Measure behavior before attitudes, attitudes before prioritisation, and place the most valuable open-ended example late in the questionnaire.\",\n    \"Use fully labelled five-point scales, behavioral anchors, limited grids, forced prioritisation, and concise open-ended probes suitable for an 8–12 minute mobile survey.\",\n    \"Cross-tab results by current work model, parent life stage, caregiving situation, childcare access, and audience-payload age/gender fields without recollecting those database variables.\",\n    \"Complete the survey after the Recognition & Fairness section. Quality failures must be classified separately from ordinary eligibility screen-outs.\"\n  ],\n  \"analysis_tags\": [\n    \"eligibility_status\",\n    \"parent_status\",\n    \"parent_life_stage\",\n    \"pregnancy_stage\",\n    \"child_age_group\",\n    \"caregiving_role\",\n    \"childcare_access\",\n    \"care_interruption_frequency\",\n    \"leave_status\",\n    \"current_work_model\",\n    \"preferred_work_model\",\n    \"work_arrangement_gap\",\n    \"office_attendance_predictability\",\n    \"schedule_control\",\n    \"meeting_schedule_control\",\n    \"temporary_schedule_control\",\n    \"workplace_pain_point_frequency\",\n    \"workplace_pain_point_severity\",\n    \"boundary_erosion\",\n    \"productivity_barriers\",\n    \"workload_pressure\",\n    \"manager_effectiveness\",\n    \"flexibility_request_comfort\",\n    \"manager_care_response\",\n    \"psychological_safety\",\n    \"team_support\",\n    \"meeting_norms\",\n    \"career_visibility_risk\",\n    \"promotion_confidence\",\n    \"performance_evaluation_concern\",\n    \"important_work_access\",\n    \"support_awareness\",\n    \"support_access\",\n    \"support_usefulness\",\n    \"support_unmet_need\",\n    \"policy_priority\",\n    \"urgent_problem\",\n    \"greatest_impact_action\",\n    \"workplace_pride\",\n    \"retention_intent\",\n    \"stay_leave_driver\",\n    \"wellbeing_impact\",\n    \"productivity_impact\",\n    \"worklife_balance\",\n    \"culture_perception\",\n    \"bottom_up_idea\",\n    \"open_ended_theme\",\n    \"quality_status\"\n  ],\n  \"assumptions\": [\n    \"PARENT_STATUS will include combined employment eligibility and parent-life-stage options so the binding 20-question budget can be met without adding a separate paid-work screener.\",\n    \"The exact definition and age bands for infant and older young child will be finalised before scripting.\",\n    \"Multi-item grids and sub-items within the mandated flow keys count as one respondent-facing question key.\",\n    \"Age, gender, city, and NCCS are supplied by the audience system and will not be recollected.\",\n    \"The final support-policy and intervention labels will be balanced, concise, and suitable for compact awareness, usefulness, and prioritisation components.\"\n  ],\n  \"ambiguities\": [\n    \"The brief does not specify the exact age cut-off for young child or the infant-versus-older-young-child bands.\",\n    \"The brief does not define whether planning parental leave may include caregiving leave unrelated to an expected child; the final PARENT_STATUS options must resolve this.\",\n    \"The fixed 20-question budget requires several objectives to be measured as compact grids or sub-items within the mandated methodology keys rather than as standalone questions.\"\n  ]\n}","model":"openai.gpt-5.6-luna","sources":[],"data":{"version":"1.0","source":"generated","locked_predefined_design":false,"study_type":"Employee engagement and organizational health study among expecting parents and parents of young children","research_design":{"design":"linear","stimulus_count":0,"cells":[],"rotation":"none","justification":"The brief specifies a linear, modular funnel with zero discrete stimuli and no experimental cells. The flow moves from eligibility and current work context through engagement, role and growth, manager, team, culture, wellbeing, and recognition measures."},"business_goal":"Determine which workplace policies, manager practices, team norms, and benefits employers should prioritise to reduce workplace friction for expecting parents and parents of young children across remote, hybrid, and office-based work. Results will inform decisions on flexible-work policy, schedule predictability, manager accountability, childcare support, career protection, and implementation of existing benefits.","questionnaire_intent":"Use an empathetic, anonymous, mobile-friendly organizational-health questionnaire with exactly 20 respondent-facing question keys. The flow begins with parent eligibility and current work model, then measures engagement, role and growth, manager and team experience, culture, wellbeing, and recognition; compact grids and targeted open-ended components capture the broader parent-workplace diagnostic within the fixed budget.","survey_objectives":[{"objective":"Measure overall workplace engagement, pride, retention intent, and recommendation likelihood among eligible working parents to establish the organizational-health baseline.","importance":"Leadership needs a common outcome benchmark against which workplace pain points, flexibility experiences, and support interventions can be evaluated."},{"objective":"Measure current work model and parent-life-stage eligibility across remote, hybrid, and mainly office-based respondents to compare workplace experiences by work arrangement and caregiving situation.","importance":"The business must distinguish location-related problems from broader flexibility and caregiving barriers."},{"objective":"Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children.","importance":"Career penalties may create longer-term retention and equity risks even when day-to-day flexibility is available."},{"objective":"Measure manager effectiveness, psychological safety, comfort raising caregiving needs, and manager behaviours that should be amplified.","importance":"Formal flexibility may remain unusable if managers respond negatively or inconsistently to caregiving needs."},{"objective":"Measure belonging and teamwork quality to assess whether team norms and collaboration practices create avoidable friction for working parents.","importance":"Team behaviour can determine whether flexible arrangements work in practice."},{"objective":"Measure alignment with organizational values, perceptions of culture, and the single cultural or policy change respondents most want.","importance":"The business needs bottom-up evidence to design credible, parent-supportive culture and policy changes."},{"objective":"Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items.","importance":"These measures identify whether workplace practices are damaging wellbeing, concentration, productivity, and the ability to disconnect."},{"objective":"Measure whether contributions are recognized and whether workplace fairness is perceived, including compensation and treatment of employees using flexibility.","importance":"Perceived unfairness can weaken engagement and increase the risk that parents leave the organization."},{"objective":"Capture awareness, access, usefulness, unmet need, policy priorities, the most urgent workplace problem, the highest-impact employer action, and concrete examples through compact sub-items within the closing measures.","importance":"Leadership requires a practical action roadmap rather than only diagnostic engagement scores."}],"targeted_insights":[{"insight":"Which workplace conditions are most strongly associated with low engagement, poor work-life balance, and intention to leave among expecting parents and parents of young children.","linked_objectives":["Measure overall workplace engagement, pride, retention intent, and recommendation likelihood among eligible working parents to establish the organizational-health baseline.","Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items.","Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children."],"decision_impact":"Prioritise the workplace conditions most likely to improve retention and employee experience."},{"insight":"Whether remote, hybrid, or office-based work is associated with different levels of schedule friction, care conflict, productivity difficulty, and engagement.","linked_objectives":["Measure current work model and parent-life-stage eligibility across remote, hybrid, and mainly office-based respondents to compare workplace experiences by work arrangement and caregiving situation.","Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items."],"decision_impact":"Set work-location and hybrid-attendance policies based on actual parent experience rather than assumptions about remote work."},{"insight":"Whether manager support and team norms matter more than the formal availability of flexible work.","linked_objectives":["Measure manager effectiveness, psychological safety, comfort raising caregiving needs, and manager behaviours that should be amplified.","Measure belonging and teamwork quality to assess whether team norms and collaboration practices create avoidable friction for working parents.","Capture awareness, access, usefulness, unmet need, policy priorities, the most urgent workplace problem, the highest-impact employer action, and concrete examples through compact sub-items within the closing measures."],"decision_impact":"Choose between manager training, team-norm interventions, policy redesign, or improved communication and access."},{"insight":"How workplace barriers differ between expecting parents, parents of infants, parents of older young children, and different work models.","linked_objectives":["Measure current work model and parent-life-stage eligibility across remote, hybrid, and mainly office-based respondents to compare workplace experiences by work arrangement and caregiving situation.","Measure workload manageability and work-life balance, including schedule unpredictability, boundary erosion, care interruptions, productivity barriers, wellbeing impact, and work-care overlap through compact sub-items.","Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children."],"decision_impact":"Develop life-stage-specific and situation-specific support rather than a single universal parent policy."},{"insight":"The most urgent workplace problem and the employer action respondents believe would have the greatest practical impact.","linked_objectives":["Measure alignment with organizational values, perceptions of culture, and the single cultural or policy change respondents most want.","Capture awareness, access, usefulness, unmet need, policy priorities, the most urgent workplace problem, the highest-impact employer action, and concrete examples through compact sub-items within the closing measures."],"decision_impact":"Create the immediate employer action roadmap and prioritize investment."},{"insight":"Whether career visibility, recognition, and fairness concerns create a distinct risk for parents using or seeking flexible work.","linked_objectives":["Measure role clarity, growth opportunity, career visibility, and progression concerns among expecting parents and parents of young children.","Measure whether contributions are recognized and whether workplace fairness is perceived, including compensation and treatment of employees using flexibility."],"decision_impact":"Design career-protection, evaluation, promotion, recognition, and fairness safeguards."}],"respondent_segments":[{"key":"expecting_parent","definition":"Currently working in a paid role and expecting a child or planning parental leave.","qualification_rule":"PARENT_STATUS = Expecting a child or planning parental leave","expected_path":"Eligibility and work model, followed by all seven organizational-health sections with expecting-parent-specific sub-items shown where relevant."},{"key":"parent_of_infant","definition":"Currently working in a paid role and caring for a child in the infant age band.","qualification_rule":"PARENT_STATUS = Parent of an infant or young child AND parent-life-stage sub-item = Infant","expected_path":"Eligibility and work model, followed by all seven organizational-health sections with current-child and childcare sub-items shown where relevant."},{"key":"parent_of_older_young_child","definition":"Currently working in a paid role and caring for an older young child within the study definition.","qualification_rule":"PARENT_STATUS = Parent of an infant or young child AND parent-life-stage sub-item = Older young child","expected_path":"Eligibility and work model, followed by all seven organizational-health sections with current-child and childcare sub-items shown where relevant."},{"key":"not_currently_working","definition":"Respondent does not currently work in a paid role.","qualification_rule":"PARENT_STATUS = Not currently working in a paid role","expected_path":"Terminate immediately as ineligible."},{"key":"not_eligible_parent","definition":"Respondent is working but is neither expecting a child, planning parental leave, nor parenting a young child.","qualification_rule":"PARENT_STATUS = None of these","expected_path":"Terminate immediately as ineligible."},{"key":"unsupported_work_model","definition":"Eligible parent whose current work arrangement is outside remote, hybrid, or mainly office-based work.","qualification_rule":"CURRENT_WORK_MODEL = Other arrangement","expected_path":"Terminate immediately as outside the defined work-model audience."}],"questionnaire_sections":[{"key":"overall_engagement","purpose":"Establish parent eligibility, current work model, overall engagement, pride, and retention baseline. Supports objectives 1 and 2.","question_keys":["PARENT_STATUS","CURRENT_WORK_MODEL","ENPS_SCORE","WORKPLACE_PRIDE","RETENTION_INTENT"]},{"key":"role_growth","purpose":"Measure role clarity, growth, career visibility, practical flexibility, pain-point frequency and severity, caregiving context, childcare access, and policy barriers using compact sub-items within the three mandated questions. Supports objectives 2, 3, 7, and 9.","question_keys":["ROLE_CLARITY","GROWTH_OPPORTUNITY","UNSupported_GOALS"]},{"key":"manager_relationship","purpose":"Measure manager effectiveness, psychological safety, comfort requesting flexibility, responses to caregiving needs, and positive manager behaviours through the mandated manager measures. Supports objective 4.","question_keys":["MANAGER_EFFECTIVENESS","SAFETY_COMFORT","MANAGER_STRENGTHS"]},{"key":"team_collaboration","purpose":"Measure belonging, teamwork quality, meeting norms, collaboration friction, and team support for caregiving through the two mandated team measures. Supports objective 5.","question_keys":["TEAM_BELONGING","TEAMWORK_QUALITY"]},{"key":"culture_values","purpose":"Measure value alignment, culture perception, the most urgent cultural change, and bottom-up policy or manager ideas through the mandated culture measures. Supports objectives 6 and 9.","question_keys":["VALUE_ALIGNMENT","CULTURE_WORDS","CULTURE_CHANGE"]},{"key":"wellbeing_workload","purpose":"Measure workload manageability, boundary erosion, care interruptions, productivity barriers, work-life balance, wellbeing, and work-care overlap through compact sub-items within the two mandated measures. Supports objectives 7 and 8.","question_keys":["WORKLOAD_MANAGEABLE","WORKLIFE_BALANCE"]},{"key":"recognition_fairness","purpose":"Measure recognition, fairness, support awareness and usefulness, unmet needs, policy priorities, urgent problem, greatest-impact action, and a concise concrete example through compact sub-items within the two mandated measures. Supports objectives 8 and 9 and closes the survey.","question_keys":["CONTRIBUTION_RECOGNIZED","COMPENSATION_FAIRNESS"]}],"business_rules":[{"id":"BR1","plain_english":"Use PARENT_STATUS as the combined eligibility and parent-life-stage screener. Terminate respondents who are not currently working in a paid role or who are neither expecting a child, planning parental leave, nor parenting a young child."},{"id":"BR2","plain_english":"If CURRENT_WORK_MODEL is Other arrangement, terminate as outside the defined remote, hybrid, or mainly office-based audience."},{"id":"BR3","plain_english":"Show only the pregnancy, leave, return-to-work, childcare, child-age, and care-interruption sub-items relevant to the respondent's PARENT_STATUS and parent-life-stage response; skip irrelevant sub-items without creating additional respondent-facing question keys."},{"id":"BR4","plain_english":"Use ROLE_CLARITY, GROWTH_OPPORTUNITY, and UNSupported_GOALS as compact grids or structured modules to stay within the exact 20-question budget while retaining measures of schedule control, pain-point frequency and severity, career visibility, support gaps, and policy barriers."},{"id":"BR5","plain_english":"Use WORKLOAD_MANAGEABLE and WORKLIFE_BALANCE as compact grids containing boundary erosion, after-hours work, meeting spillover, care interruptions, productivity barriers, wellbeing, and work-care overlap items."},{"id":"BR6","plain_english":"Use CULTURE_CHANGE and the closing recognition/fairness module to capture forced prioritisation, the most urgent problem, greatest-impact employer action, support-policy awareness/access/usefulness, and one bottom-up example."},{"id":"BR7","plain_english":"Ask sensitive workplace and caregiving items using empathetic, no-blame wording and reassure respondents that answers are anonymous and reported in aggregate."},{"id":"BR8","plain_english":"Do not ask age, gender, city, residence, income, NCCS, or other database-known targeting variables; use audience-payload fields for those analyses."},{"id":"BR9","plain_english":"Place behavior and experience measures before evaluations and prioritisation. Use fully labelled five-point scales, limited grids, balanced prioritisation, and targeted open-ended components."},{"id":"BR10","plain_english":"Apply attention checks, speedster detection, straight-line detection, duplicate/inconsistency screening, and open-ended quality review. Quality failures are quality terminates, not ordinary screen-outs."},{"id":"BR11","plain_english":"After respondents complete RECOGNITION_FAIRNESS, including support evaluation, prioritisation, urgent problem, greatest-impact action, and bottom-up example components, complete the survey."}],"dynamic_lists":[],"branch_blocks":[],"termination_and_completion_policy":[{"condition":"PARENT_STATUS indicates that the respondent is not currently working in a paid role.","outcome":"terminate"},{"condition":"PARENT_STATUS indicates None of these: the respondent is neither expecting a child, planning parental leave, nor parenting a young child.","outcome":"terminate"},{"condition":"CURRENT_WORK_MODEL indicates Other arrangement.","outcome":"terminate"},{"condition":"A pregnancy, child-age, childcare, leave, return-to-work, care-interruption, or career-risk sub-item does not apply to the respondent's parent-life-stage or reported experience.","outcome":"skip"},{"condition":"Respondent fails an attention check or quality screen based on speed, straight-lining, duplication, inconsistency, or unusable open-ended content.","outcome":"terminate"},{"condition":"Respondent completes all applicable content through the recognition, support, prioritisation, and decision-close components within RECOGNITION_FAIRNESS.","outcome":"complete"}],"question_generation_instructions":["METHODOLOGY: Employee Engagement — Organizational Health Methodology. Preserve the seven sections and exact order: Overall Engagement, Role & Growth, Manager Relationship, Team & Collaboration, Culture & Values, Wellbeing & Workload, and Recognition & Fairness. Use exactly 20 respondent-facing question keys, with no stimuli or experimental cells.","Use the mandated flow keys exactly as provided. Do not add demographic targeting keys or additional respondent-facing keys.","Use PARENT_STATUS as a combined eligibility and life-stage screener so the exact 20-question budget is maintained. Include expecting-parent, current-parent, not-working, and none-of-these response paths.","Keep the tone empathetic, anonymous, neutral, and no-blame. Avoid leading agree/disagree batteries.","Use compact grids and structured sub-items to capture current/preferred work arrangement, schedule control, childcare access, care interruptions, pain-point frequency and severity, boundary erosion, productivity barriers, career visibility, policy awareness/access/usefulness, and unmet need without adding question keys.","Implement the advanced techniques: include a stay/leave or retention-risk signal through RETENTION_INTENT, a workplace/career risk signal within ROLE_CLARITY or GROWTH_OPPORTUNITY, and a bottom-up policy or manager-behaviour example within CULTURE_CHANGE or the closing recognition/fairness module.","Measure behavior before attitudes, attitudes before prioritisation, and place the most valuable open-ended example late in the questionnaire.","Use fully labelled five-point scales, behavioral anchors, limited grids, forced prioritisation, and concise open-ended probes suitable for an 8–12 minute mobile survey.","Cross-tab results by current work model, parent life stage, caregiving situation, childcare access, and audience-payload age/gender fields without recollecting those database variables.","Complete the survey after the Recognition & Fairness section. Quality failures must be classified separately from ordinary eligibility screen-outs."],"analysis_tags":["eligibility_status","parent_status","parent_life_stage","pregnancy_stage","child_age_group","caregiving_role","childcare_access","care_interruption_frequency","leave_status","current_work_model","preferred_work_model","work_arrangement_gap","office_attendance_predictability","schedule_control","meeting_schedule_control","temporary_schedule_control","workplace_pain_point_frequency","workplace_pain_point_severity","boundary_erosion","productivity_barriers","workload_pressure","manager_effectiveness","flexibility_request_comfort","manager_care_response","psychological_safety","team_support","meeting_norms","career_visibility_risk","promotion_confidence","performance_evaluation_concern","important_work_access","support_awareness","support_access","support_usefulness","support_unmet_need","policy_priority","urgent_problem","greatest_impact_action","workplace_pride","retention_intent","stay_leave_driver","wellbeing_impact","productivity_impact","worklife_balance","culture_perception","bottom_up_idea","open_ended_theme","quality_status"],"assumptions":["PARENT_STATUS will include combined employment eligibility and parent-life-stage options so the binding 20-question budget can be met without adding a separate paid-work screener.","The exact definition and age bands for infant and older young child will be finalised before scripting.","Multi-item grids and sub-items within the mandated flow keys count as one respondent-facing question key.","Age, gender, city, and NCCS are supplied by the audience system and will not be recollected.","The final support-policy and intervention labels will be balanced, concise, and suitable for compact awareness, usefulness, and prioritisation components."],"ambiguities":["The brief does not specify the exact age cut-off for young child or the infant-versus-older-young-child bands.","The brief does not define whether planning parental leave may include caregiving leave unrelated to an expected child; the final PARENT_STATUS options must resolve this.","The fixed 20-question budget requires several objectives to be measured as compact grids or sub-items within the mandated methodology keys rather than as standalone questions."]},"version":"1.0","source":"generated","locked_predefined_design":false,"study_type":"Employee engagement and organizational health study among expecting parents and parents of young children","research_design":{"design":"linear","stimulus_count":0,"cells":[],"rotation":"none","justification":"The brief specifies a linear, modular funnel with zero discrete stimuli and no experimental cells. The flow moves from eligibility and current work context through engagement, role and growth, manager, team, culture, wellbeing, and recognition measures."},"business_goal":"Determine which workplace policies, manager practices, team norms, and benefits employers should prioritise to reduce workplace friction for expecting parents and parents of young children across remote, hybrid, and office-based work. Results will inform decisions on flexible-work policy, schedule predictability, manager accountability, childcare support, career protection, and implementation of existing benefits.","questionnaire_intent":"Use an empathetic, anonymous, mobile-friendly organizational-health questionnaire with exactly 20 respondent-facing question keys. The flow begins with parent eligibility and current work model, then measures engagement, role and growth, manager and team experience, culture, wellbeing, and recognition; compact grids and targeted open-ended components capture the broader parent-workplace diagnostic within the fixed budget.","survey_objectives":[{"objective":"Measure overall workplace engagement, pride, retention intent, and recommendation likelihood among eligible working parents to establish the organizational-health baseline.","importance":"Leadership needs a common outcome benchmark against which workplace pain points, flexibility experiences, and support interventions can be evaluated."},{"objective":"Measure current work model and parent-life-stage eligibility across remote, hybrid, and mainly office-based respondents to compare workplace experiences by work arrangement and caregiving situation.","importance":"The business must distinguish location-related problems from broader flexibility and caregivi