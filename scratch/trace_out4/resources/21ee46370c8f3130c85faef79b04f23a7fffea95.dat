data: {"type":"final","sequence":0,"request_id":"c36fb404-18c7-4c75-9c4e-84062f07ad0a","status":true,"message":"Chat turn processed successfully.","timestamp":"2026-08-14T09:08:14.094516+00:00","data":{"ai_message":"I understand the survey is about dietary habits, meal preparation, and interest in new features. I need a little more context to design the right research approach.","chat_id":"e024bd98-0387-4ac2-87a9-434265ef3921","guest_id":null,"chat_turn_id":"63978d8a-8b19-47bf-a83f-f32d55e504da","chat_name":"New Chat (2026-08-14 09:08)","turn_number":0,"survey_turn_number":null,"questions":[],"media_request":null,"research_brief":null,"research_framework":null,"context_request":[{"question":"What product, service, app, or platform will these new features belong to? Please describe what it currently offers and what you are considering adding.","options":null,"multi_select":false},{"question":"Which feature areas should the survey explore? Select all that apply.","options":["Meal planning and recipe suggestions","Grocery lists, shopping, or delivery","Nutrition, calorie, or dietary tracking","Personalised plans based on goals or restrictions"],"multi_select":true},{"question":"Who should answer the survey? Select all that apply.","options":["People who regularly cook at home","People who meal-prep in advance","People following a specific diet or nutrition goal","Existing users of the product or service","Potential users who do not use it today"],"multi_select":true},{"question":"What is the single most important decision this research should support?","options":["Prioritize which features to build first","Understand unmet meal-preparation needs","Estimate interest before launching new features","Improve the existing product experience"],"multi_select":false},{"question":"What should the survey mainly measure? Select all that apply.","options":["Current dietary habits and meal-prep routines","Pain points and barriers","Interest in proposed features","Willingness to pay or preferred pricing","Differences between user segments"],"multi_select":true},{"question":"What is the timeline for this research?","options":["Immediate (within days)","Short-term (1-2 weeks)","Medium-term (about 1 month)","No strict deadline"],"multi_select":false}],"qna_context":null,"audience_payload":null,"cta_buttons":null,"end_message":null,"see_why":null,"superJSurveyId":null,"superJSurveyName":null,"businessId":null,"error":null,"changes_detected":true,"log_message":null,"exhausted":false,"usage_info":{"tier_type":"FREE","daily_limit":null,"tokens_used_today":0,"tokens_remaining":0,"chat_context_limit":400000,"chat_tokens_used":0,"chat_tokens_remaining":400000,"monthly_chat_limit":10,"chats_created_this_month":1,"chats_remaining":9,"exhausted":false,"exhausted_reason":null},"business_flow":null,"routing_logic":null,"route_logs":[],"urls_referred":[]},"require_auth":false}

