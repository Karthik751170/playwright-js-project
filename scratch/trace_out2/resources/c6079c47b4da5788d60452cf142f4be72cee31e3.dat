data: {"type":"final","sequence":0,"request_id":"6991fce6-0080-456a-9a94-008cdc41d686","status":true,"message":"Chat turn processed successfully.","timestamp":"2026-08-14T08:13:38.458757+00:00","data":{"ai_message":"Remote work preferences among new parents is a clear topic. I have a few targeted questions so the research focuses on the right pain points and decisions.","chat_id":"3d8e21ef-ce02-415d-9269-bef93fb1ce61","guest_id":null,"chat_turn_id":"ad5c0c75-0177-49ae-82cb-b7c4da0369e6","chat_name":"New Chat (2026-08-14 08:13)","turn_number":0,"survey_turn_number":null,"questions":[],"media_request":null,"research_brief":null,"research_framework":null,"context_request":[{"question":"What is the main purpose of this survey? For example, improving workplace policy, designing employee benefits, planning office attendance, or understanding general work preferences.","options":["Improve remote or hybrid work policy","Design better support for working parents","Plan office attendance or workplace facilities","Understand general preferences and pain points"],"multi_select":false},{"question":"Who should answer the survey? Select all that apply.","options":["New parents currently working remotely","New parents working in a hybrid model","New parents working mainly from an office","Expecting parents or parents planning leave"],"multi_select":true},{"question":"How should we define “new parents” for this study?","options":["Parents of children under 1 year","Parents of children under 2 years","Parents of children under 5 years","Expecting parents and parents of young children"],"multi_select":false},{"question":"Which pain points should the survey explore? Select all that apply.","options":["Childcare and interruptions","Work-life boundaries and working hours","Productivity and concentration","Manager or team expectations","Career growth and visibility","Technology, workspace, or connectivity"],"multi_select":true},{"question":"What is the single most important decision the findings should support?","options":["Choose the best remote or hybrid work arrangement","Identify the biggest sources of stress","Prioritize employer support or policy changes","Compare preferences across different parent groups"],"multi_select":false},{"question":"What is your preferred timeline for this short survey?","options":["Immediate, within a few days","Within 1-2 weeks","Within a month","No strict deadline"],"multi_select":false}],"qna_context":null,"audience_payload":null,"cta_buttons":null,"end_message":null,"see_why":null,"superJSurveyId":null,"superJSurveyName":null,"businessId":null,"error":null,"changes_detected":true,"log_message":null,"exhausted":false,"usage_info":{"tier_type":"FREE","daily_limit":null,"tokens_used_today":0,"tokens_remaining":0,"chat_context_limit":400000,"chat_tokens_used":0,"chat_tokens_remaining":400000,"monthly_chat_limit":10,"chats_created_this_month":1,"chats_remaining":9,"exhausted":false,"exhausted_reason":null},"business_flow":null,"routing_logic":null,"route_logs":[],"urls_referred":[]},"require_auth":false}

