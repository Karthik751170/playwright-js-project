e":null,"breakVariant":null,"progress_percent":null,"keyboardType":null,"flow_key":"NON_PAYER_SPENDING_BARRIERS","business_role":"branch_followup","route_group":"LOYALTY_ADVOCACY","analysis_tags":["spending_barrier","price_sensitivity","non_payer_segment","main_brand","brand_value","payer_status","purchase_frequency","recent_purchase","purchase_category","purchase_occasion","purchase_value","advocacy_driver","payer_segment"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null},{"id":"preview_question_22","qId":"b2911f84-e0ee-493a-9531-12e63af1df54","text":"How likely are you to recommend Fortnite to a friend?","type":"number_rating","audio_url":null,"image_url":null,"video_url":null,"watch_only":null,"file_type":null,"validation_description":null,"subheading":"1 = Not at all likely, 10 = Extremely likely","placeholder":null,"minChar":null,"maxChar":null,"allow_multiple_answers":null,"start_range":1,"end_range":10,"low_rating_label":"Not at all likely","high_rating_label":"Extremely likely","options":null,"dropdown_options":null,"fields":null,"super_j_question_id":null,"ranking_groups":null,"next":null,"complete":["__ALWAYS__"],"terminate":null,"expectedAnswer":[],"validationQuestion":false,"filterFrom":null,"filterOut":null,"filterFromConfig":null,"filterOutConfig":null,"showIf":null,"showIfElse":null,"showIfLogic":null,"shuffle":null,"break_heading":null,"break_message":null,"breakVariant":null,"progress_percent":null,"keyboardType":null,"flow_key":"NPS_SCORE","business_role":"close","route_group":"LOYALTY_ADVOCACY","analysis_tags":["nps","recommendation_intent","quality_status","fortnite_share_of_play","fortnite_status","current_fortnite_player","lapsed_fortnite_player","advocacy_driver"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null}],"media_request":null,"research_brief":null,"research_framework":null,"context_request":null,"qna_context":null,"audience_payload":{"Nccs":{"A1":10,"A2":15,"A3":15,"B1":20,"B2":20,"B3":15,"C1":5},"Pune":{"tier":"tier1","total":90},"male":225,"18-24":{"total":180},"24-35":{"total":170},"35-45":{"total":100},"Delhi":{"tier":"tier1","total":90},"title":"Fortnite India: The Ultimate Player Pulse","total":450,"Mumbai":{"tier":"tier1","total":90},"female":225,"Bangalore":{"tier":"tier1","total":90},"Hyderabad":{"tier":"tier1","total":90},"checkCity":true,"Attributes":{"Non-payers":35,"Lapsed mobile gamers":15,"Frequent mobile gamers":40,"In-app purchase payers":25,"Current Fortnite players":35,"Occasional mobile gamers":25,"Competitor battle royale players":30},"created_by":"hercules","previousstate":{}},"cta_buttons":null,"end_message":null,"see_why":null,"superJSurveyId":"6a7ed25e15203e92a622fd59","superJSurveyName":"Is Fortnite Winning India’s Gamers?","businessId":null,"error":null,"changes_detected":true,"log_message":null,"exhausted":false,"usage_info":{"tier_type":"FREE","daily_limit":null,"tokens_used_today":0,"tokens_remaining":0,"chat_context_limit":400000,"chat_tokens_used":0,"chat_tokens_remaining":400000,"monthly_chat_limit":10,"chats_created_this_month":1,"chats_remaining":9,"exhausted":false,"exhausted_reason":null},"business_flow":{"text":"{\n  \"version\": \"1.0\",\n  \"source\": \"generated\",\n  \"locked_predefined_design\": false,\n  \"study_type\": \"Brand health tracking with usage and attitude, competitive benchmarking, loyalty, engagement, switching, and monetisation measures\",\n  \"research_design\": {\n    \"design\": \"linear\",\n    \"stimulus_count\": 0,\n    \"cells\": [],\n    \"rotation\": \"none\",\n    \"justification\": \"The brief specifies a zero-stimulus modular tracking design with a stable wave-to-wave KPI core. Respondents report existing gaming behavior, brand perceptions, engagement, loyalty, and spending; no concepts, advertisements, price cells, or other discrete stimuli are evaluated.\"\n  },\n  \"business_goal\": \"Establish a repeatable brand-health tracker to determine how Epic Games and Fortnite are gaining or losing salience, usage, preference, loyalty, advocacy, and competitive share among Indian mobile gamers. The business will use wave-level results to prioritise acquisition, retention, win-back, competitive-conquest, creator, community, live-service, partnership, and monetisation strategies.\",\n  \"questionnaire_intent\": \"The questionnaire follows the mandated Brand Equity Funnel: unaided recall precedes aided awareness and the non-aware termination gate, followed by familiarity and usage, perception and equity, emotional connection, and loyalty and advocacy. Conditional modules capture current-player engagement, lapsed-player return barriers, competitor conquest opportunities, and payer/non-payer monetisation behavior while maintaining exactly 22 respondent-facing questions.\",\n  \"survey_objectives\": [\n    {\n      \"objective\": \"Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.\",\n      \"importance\": \"Salience is the first indicator of brand health and identifies whether Fortnite is mentally available before prompting or losing reach to competitors.\"\n    },\n    {\n      \"objective\": \"Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.\",\n      \"importance\": \"These measures distinguish superficial awareness from meaningful participation and identify high-value, occasional, lapsed, and conquestable players.\"\n    },\n    {\n      \"objective\": \"Measure consideration, preference, current and recent usage, and Fortnite choice relative to tracked competitors.\",\n      \"importance\": \"Funnel conversion identifies where Fortnite gains or loses players and whether acquisition should focus on awareness, consideration, trial, or competitive choice.\"\n    },\n    {\n      \"objective\": \"Measure Fortnite and competitor associations across fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness, including comparative quality, value, trust, and innovation ratings.\",\n      \"importance\": \"Perceptual ownership determines the positioning and product-experience territories that should receive investment.\"\n    },\n    {\n      \"objective\": \"Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity.\",\n      \"importance\": \"The business needs to identify which ecosystem and social experiences are associated with stronger engagement, loyalty, advocacy, and monetisation.\"\n    },\n    {\n      \"objective\": \"Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite.\",\n      \"importance\": \"These findings inform retention, reactivation, win-back, and competitive-conquest interventions.\"\n    },\n    {\n      \"objective\": \"Measure emotional connection, projective personality, aspiration gap, and emotional associations with Fortnite and relevant alternatives.\",\n      \"importance\": \"Emotional and aspirational measures reveal whether Fortnite has a distinctive relationship with players beyond functional gameplay.\"\n    },\n    {\n      \"objective\": \"Measure likelihood to continue, recommend, invite friends, choose Fortnite over alternatives, and NPS among relevant respondents.\",\n      \"importance\": \"These forward-looking measures provide leading indicators of retention, organic acquisition, advocacy, and competitive resilience.\"\n    },\n    {\n      \"objective\": \"Measure payer incidence, purchase behavior, broad INR spending, purchase value, and barriers to in-app spending among mobile gamers.\",\n      \"importance\": \"The business needs to tailor payer conversion, offer, pricing, content-value, and non-payer strategies.\"\n    },\n    {\n      \"objective\": \"Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes.\",\n      \"importance\": \"Segment comparisons identify priority audiences and determine where interventions must differ by lifecycle and commercial value.\"\n    }\n  ],\n  \"targeted_insights\": [\n    {\n      \"insight\": \"Fortnite's unaided awareness, aided awareness, familiarity, consideration, trial, usage, preference, and loyalty conversion relative to BGMI/PUBG, Free Fire, Apex Legends, and other tracked titles.\",\n      \"linked_objectives\": [\n        \"Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.\",\n        \"Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.\",\n        \"Measure consideration, preference, current and recent usage, and Fortnite choice relative to tracked competitors.\"\n      ],\n      \"decision_impact\": \"Determine whether brand investment should focus on salience, consideration conversion, trial, acquisition, or competitive choice.\"\n    },\n    {\n      \"insight\": \"The competitors most frequently played alongside Fortnite and those most associated with substitution, switching, or share-of-play loss.\",\n      \"linked_objectives\": [\n        \"Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.\",\n        \"Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite.\"\n      ],\n      \"decision_impact\": \"Prioritise competitive-conquest messaging and defensive retention actions against the highest-risk titles.\"\n    },\n    {\n      \"insight\": \"The attributes and emotional territories Fortnite owns versus competitors, particularly creativity, ecosystem breadth, social experience, collaborations, live events, competition, and value.\",\n      \"linked_objectives\": [\n        \"Measure Fortnite and competitor associations across fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness, including comparative quality, value, trust, and innovation ratings.\",\n        \"Measure emotional connection, projective personality, aspiration gap, and emotional associations with Fortnite and relevant alternatives.\"\n      ],\n      \"decision_impact\": \"Select the positioning, communication, partnership, and product-experience territories to emphasise.\"\n    },\n    {\n      \"insight\": \"Which live-service, social, creator, community, esports, and collaboration experiences are associated with stronger continued usage, recommendation, invitation, and NPS.\",\n      \"linked_objectives\": [\n        \"Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity.\",\n        \"Measure likelihood to continue, recommend, invite friends, choose Fortnite over alternatives, and NPS among relevant respondents.\"\n      ],\n      \"decision_impact\": \"Allocate investment across live-service content, creators, collaborations, esports, social features, and community programs.\"\n    },\n    {\n      \"insight\": \"The strongest triggers and barriers for stopping, uninstalling, switching away from, returning to, or trying Fortnite.\",\n      \"linked_objectives\": [\n        \"Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite.\"\n      ],\n      \"decision_impact\": \"Design targeted churn-prevention, win-back, reactivation, and conquest interventions.\"\n    },\n    {\n      \"insight\": \"Payer incidence, purchase frequency, spending bands, content categories, perceived value, and spending barriers by play intensity, engagement type, loyalty status, and player lifecycle.\",\n      \"linked_objectives\": [\n        \"Measure payer incidence, purchase behavior, broad INR spending, purchase value, and barriers to in-app spending among mobile gamers.\",\n        \"Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes.\"\n      ],\n      \"decision_impact\": \"Tailor cosmetic, collaboration, event, pricing, value-communication, and payer-conversion strategies.\"\n    },\n    {\n      \"insight\": \"Differences in brand health, engagement, loyalty, advocacy, switching, and monetisation across current, lapsed, competitor-only, frequent, occasional, payer, non-payer, creator, and community segments.\",\n      \"linked_objectives\": [\n        \"Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes.\"\n      ],\n      \"decision_impact\": \"Set segment-specific acquisition, retention, win-back, community, and monetisation priorities.\"\n    },\n    {\n      \"insight\": \"Wave-level movement in brand-health KPIs interpreted against seasonal launches, collaborations, campaigns, esports moments, and market events.\",\n      \"linked_objectives\": [\n        \"Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.\",\n        \"Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity.\"\n      ],\n      \"decision_impact\": \"Separate durable brand movement from event-driven spikes and refine future tracking-wave planning.\"\n    }\n  ],\n  \"respondent_segments\": [\n    {\n      \"key\": \"brand_aware\",\n      \"definition\": \"Respondents selecting at least one tracked gaming brand or title in aided awareness.\",\n      \"qualification_rule\": \"BRAND_AWARENESS_AIDED contains one or more options other than None of these.\",\n      \"expected_path\": \"Continue through the applicable familiarity, usage, perception, emotional, loyalty, and monetisation path.\"\n    },\n    {\n      \"key\": \"non_aware\",\n      \"definition\": \"Respondents who do not recognise any tracked gaming brand or title in aided awareness.\",\n      \"qualification_rule\": \"BRAND_AWARENESS_AIDED selects None of these and no other option.\",\n      \"expected_path\": \"Terminate immediately after SALIENCE.\"\n    },\n    {\n      \"key\": \"current_fortnite_player\",\n      \"definition\": \"Brand-aware respondents who play Fortnite within the defined current-use window.\",\n      \"qualification_rule\": \"FORTNITE_STATUS selects Current Fortnite player.\",\n      \"expected_path\": \"Receive current-player engagement module, shared emotional and loyalty measures, and payer routing.\"\n    },\n    {\n      \"key\": \"lapsed_fortnite_player\",\n      \"definition\": \"Respondents who previously played Fortnite but do not play within the defined current-use window.\",\n      \"qualification_rule\": \"FORTNITE_STATUS selects Lapsed/former Fortnite player.\",\n      \"expected_path\": \"Receive lapsed stopping, switching, churn, and return module, followed by shared emotional and loyalty measures.\"\n    },\n    {\n      \"key\": \"competitor_only_player\",\n      \"definition\": \"Respondents who play tracked competitors but have never played Fortnite.\",\n      \"qualification_rule\": \"FORTNITE_STATUS selects Competitor player who has never played Fortnite.\",\n      \"expected_path\": \"Receive competitor conquest and Fortnite trial-barrier module, followed by shared emotional and loyalty measures where applicable.\"\n    },\n    {\n      \"key\": \"aware_non_player\",\n      \"definition\": \"Brand-aware respondents without current, lapsed, or competitor-only Fortnite status.\",\n      \"qualification_rule\": \"FORTNITE_STATUS selects Aware but not a current, lapsed, or competitor-only player.\",\n      \"expected_path\": \"Skip lifecycle-specific modules and continue through shared brand, emotional, loyalty, and payer measures.\"\n    },\n    {\n      \"key\": \"payer\",\n      \"definition\": \"Respondents who made an in-app purchase in the defined recent purchase window.\",\n      \"qualification_rule\": \"PAYER_STATUS selects Yes, made an in-app purchase.\",\n      \"expected_path\": \"Receive payer purchase behavior and value module.\"\n    },\n    {\n      \"key\": \"non_payer\",\n      \"definition\": \"Respondents with no in-app purchase in the defined recent purchase window.\",\n      \"qualification_rule\": \"PAYER_STATUS selects No purchase in the recent period.\",\n      \"expected_path\": \"Receive spending-barrier and value module.\"\n    }\n  ],\n  \"questionnaire_sections\": [\n    {\n      \"key\": \"SALIENCE\",\n      \"purpose\": \"Measure spontaneous and prompted brand awareness before any detailed brand evaluation, supporting the salience and funnel objectives.\",\n      \"question_keys\": [\n        \"BRAND_RECALL_UNAIDED\",\n        \"BRAND_AWARENESS_AIDED\"\n      ]\n    },\n    {\n      \"key\": \"FAMILIARITY_USAGE\",\n      \"purpose\": \"Measure familiarity, competitive trial and repertoire, usage intensity, platform behavior, and Fortnite lifecycle status, supporting the funnel, competitive, behavioral, and segment-comparison objectives.\",\n      \"question_keys\": [\n        \"BRAND_FAMILIARITY\",\n        \"BRAND_TRIAL\",\n        \"USAGE_PROFILE\",\n        \"FORTNITE_STATUS\"\n      ]\n    },\n    {\n      \"key\": \"PERCEPTION_EQUITY\",\n      \"purpose\": \"Measure consideration, comparative brand equity, attributes, current-player engagement, lapsed-player return barriers, and competitor conquest opportunities.\",\n      \"question_keys\": [\n        \"BRAND_ATTRIBUTES\",\n        \"COMPETITOR_RATING_GRID\",\n        \"BRAND_FUNNEL_CONSIDERATION\",\n        \"CURRENT_FORTNITE_ENGAGEMENT\",\n        \"LAPSED_FORTNITE_RETURN\",\n        \"COMPETITOR_CONQUEST\"\n      ]\n    },\n    {\n      \"key\": \"EMOTIONAL_CONNECTION\",\n      \"purpose\": \"Measure projective personality, emotional association, and aspiration gap to identify Fortnite's emotional and aspirational territory.\",\n      \"question_keys\": [\n        \"BRAND_PERSONALITY\",\n        \"BRAND_EMOTION\",\n        \"ASPIRATION_GAP\"\n      ]\n    },\n    {\n      \"key\": \"LOYALTY_ADVOCACY\",\n      \"purpose\": \"Measure churn risk, advocacy, continuation, competitive choice, payer status, monetisation, spending barriers, and NPS before the final completion point.\",\n      \"question_keys\": [\n        \"CHURN_RISK\",\n        \"RECOMMEND_AND_INVITE\",\n        \"CONTINUE_AND_CHOOSE\",\n        \"PAYER_STATUS\",\n        \"PAYER_PURCHASE_VALUE\",\n        \"NON_PAYER_SPENDING_BARRIERS\",\n        \"NPS_SCORE\"\n      ]\n    }\n  ],\n  \"business_rules\": [\n    {\n      \"id\": \"BR1\",\n      \"plain_english\": \"Ask BRAND_RECALL_UNAIDED before showing any aided brand list or naming the detailed tracked brands.\"\n    },\n    {\n      \"id\": \"BR2\",\n      \"plain_english\": \"BRAND_AWARENESS_AIDED must include an exclusive None of these option. If None of these is selected with no other option, terminate immediately as non-aware and ineligible.\"\n    },\n    {\n      \"id\": \"BR3\",\n      \"plain_english\": \"If at least one tracked brand or title is selected in BRAND_AWARENESS_AIDED, classify the respondent as brand_aware and continue.\"\n    },\n    {\n      \"id\": \"BR4\",\n      \"plain_english\": \"Use BRAND_TRIAL to measure the competitive repertoire and carry only selected trial brands, in the same option order, into COMPETITOR_RATING_GRID.\"\n    },\n    {\n      \"id\": \"BR5\",\n      \"plain_english\": \"Use USAGE_PROFILE to capture bundled frequency, recency, session duration, platform mix, multiplayer behavior, and Fortnite share-of-play indicators without adding separate questions beyond the 22-question budget.\"\n    },\n    {\n      \"id\": \"BR6\",\n      \"plain_english\": \"Use FORTNITE_STATUS to route current players to current engagement, lapsed players to stopping and return diagnostics, competitor-only players to conquest diagnostics, and other aware respondents past lifecycle-specific modules.\"\n    },\n    {\n      \"id\": \"BR7\",\n      \"plain_english\": \"Use recency anchoring consistently for play, stopping, switching, returning, and purchasing measures across all waves.\"\n    },\n    {\n      \"id\": \"BR8\",\n      \"plain_english\": \"Use stable wording and scales for core tracking KPIs. Any wave-specific campaign, collaboration, seasonal, creator, esports, or competitor content must be incorporated without changing the core order or question budget.\"\n    },\n    {\n      \"id\": \"BR9\",\n      \"plain_english\": \"Use PAYER_STATUS to route purchasers to purchase behavior and value measures and non-payers to spending barriers and value measures.\"\n    },\n    {\n      \"id\": \"BR10\",\n      \"plain_english\": \"Use projective personality, aspiration gap, and a price-anchor approach within the declared questions; the price anchor must not create price cells or experimental assignment.\"\n    },\n    {\n      \"id\": \"BR11\",\n      \"plain_english\": \"Apply external quality controls for attention, speed, straight-lining, open-end quality, duplicate records, and implausible behavior. Failed quality cases are quality terminates and must not be classified as non-aware screen-outs.\"\n    },\n    {\n      \"id\": \"BR12\",\n      \"plain_english\": \"After NPS_SCORE, complete every respondent who has reached the final loyalty path. No mandatory questions or modules may follow NPS_SCORE.\"\n    }\n  ],\n  \"dynamic_lists\": [\n    {\n      \"id\": \"DL1\",\n      \"source_question_key\": \"BRAND_TRIAL\",\n      \"target_question_key\": \"COMPETITOR_RATING_GRID\",\n      \"mode\": \"selected\",\n      \"purpose\": \"Show only brands selected as used in BRAND_TRIAL, preserving the exact option labels and order for comparative quality, value, trust, and innovation ratings.\"\n    }\n  ],\n  \"branch_blocks\": [\n    {\n      \"id\": \"BB1\",\n      \"source_question_key\": \"FORTNITE_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Current Fortnite player\",\n          \"member_question_keys\": [\n            \"CURRENT_FORTNITE_ENGAGEMENT\"\n          ]\n        },\n        {\n          \"option_label\": \"Lapsed/former Fortnite player\",\n          \"member_question_keys\": [\n            \"LAPSED_FORTNITE_RETURN\"\n          ]\n        },\n        {\n          \"option_label\": \"Competitor player who has never played Fortnite\",\n          \"member_question_keys\": [\n            \"COMPETITOR_CONQUEST\"\n          ]\n        },\n        {\n          \"option_label\": \"Aware but not a current, lapsed, or competitor-only player\",\n          \"member_question_keys\": []\n        }\n      ],\n      \"rejoin_question_key\": \"BRAND_PERSONALITY\"\n    },\n    {\n      \"id\": \"BB2\",\n      \"source_question_key\": \"PAYER_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Yes, made an in-app purchase\",\n          \"member_question_keys\": [\n            \"PAYER_PURCHASE_VALUE\"\n          ]\n        },\n        {\n          \"option_label\": \"No purchase in the recent period\",\n          \"member_question_keys\": [\n            \"NON_PAYER_SPENDING_BARRIERS\"\n          ]\n        }\n      ],\n      \"rejoin_question_key\": \"NPS_SCORE\"\n    }\n  ],\n  \"termination_and_completion_policy\": [\n    {\n      \"condition\": \"BRAND_AWARENESS_AIDED selects None of these and no other aided-awareness option.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"A respondent fails an attention, speed, consistency, duplicate, open-end quality, or implausible-behavior validation.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"A brand-aware respondent does not qualify for a current-player, lapsed-player, or competitor-only module.\",\n      \"outcome\": \"skip\"\n    },\n    {\n      \"condition\": \"A respondent is not a current Fortnite player.\",\n      \"outcome\": \"skip\"\n    },\n    {\n      \"condition\": \"A respondent is not a payer in the defined recent purchase window.\",\n      \"outcome\": \"skip\"\n    },\n    {\n      \"condition\": \"A brand-aware respondent completes the applicable path through NPS_SCORE.\",\n      \"outcome\": \"complete\"\n    }\n  ],\n  \"question_generation_instructions\": [\n    \"METHODOLOGY: Brand Tracking — Brand Equity Funnel. Use the mandated order: unaided recall, aided awareness with non-aware termination, familiarity and usage, perception and equity, emotional connection, then loyalty and advocacy.\",\n    \"Generate exactly 22 respondent-facing questions using only the declared flow_keys. Do not add demographic, quota, or database-known targeting questions.\",\n    \"Keep core wording, response scales, brand lists, and KPI definitions stable across waves. Use compact bundled questions where a flow_key explicitly covers multiple related metrics.\",\n    \"BRAND_RECALL_UNAIDED must be open text and must precede BRAND_AWARENESS_AIDED. BRAND_AWARENESS_AIDED must be multi-select with an exclusive None of these option.\",\n    \"Use BRAND_TRIAL as a multi-select source and carry its selected options, in identical labels and order, into the vertical-ranking COMPETITOR_RATING_GRID.\",\n    \"Use recency anchoring for usage, recent play, stopping, switching, return, and purchase measures. Preserve the same time windows across waves.\",\n    \"Use BRAND_ATTRIBUTES as a concise multi-select association measure covering fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness.\",\n    \"Use BRAND_PERSONALITY with the projective prompt 'If [Brand] were a person...' and BRAND_EMOTION with at least Excited, Trusted, Indifferent, and Disappointed.\",\n    \"Use ASPIRATION_GAP to compare the current Fortnite or mobile-gaming experience with the experience respondents ideally want.\",\n    \"Use a price-anchor technique within PAYER_PURCHASE_VALUE or NON_PAYER_SPENDING_BARRIERS without creating price cells or turning the study into a pricing experiment.\",\n    \"Route current, lapsed, competitor-only, payer, and non-payer respondents through the declared branch blocks. Do not create duplicate per-question show-if logic.\",\n    \"Use NPS_SCORE as a 0–10 number rating and place it as the final respondent-facing question and completion point.\",\n    \"Ensure the data supports funnel conversion, competitive repertoire, share of play, usage intensity, brand differentiation, live-service engagement, switching, return, advocacy, monetisation, and segment-comparison analysis.\"\n  ],\n  \"analysis_tags\": [\n    \"wave_id\",\n    \"field_period\",\n    \"brand_aware_status\",\n    \"unaided_awareness\",\n    \"aided_awareness\",\n    \"familiarity\",\n    \"brand_trial\",\n    \"competitive_repertoire\",\n    \"main_brand\",\n    \"usage_frequency\",\n    \"gaming_recency\",\n    \"session_duration\",\n    \"fortnite_share_of_play\",\n    \"platform_mix\",\n    \"game_genre\",\n    \"multiplayer_participation\",\n    \"squad_play\",\n    \"current_usage\",\n    \"recent_usage\",\n    \"fortnite_status\",\n    \"current_fortnite_player\",\n    \"lapsed_fortnite_player\",\n    \"competitor_only_player\",\n    \"consideration\",\n    \"preference\",\n    \"competitive_choice\",\n    \"brand_attributes\",\n    \"brand_quality\",\n    \"brand_value\",\n    \"brand_trust\",\n    \"brand_innovation\",\n    \"brand_differentiation\",\n    \"ecosystem_perception\",\n    \"social_experience\",\n    \"creativity_perception\",\n    \"live_service_engagement\",\n    \"seasonal_update_engagement\",\n    \"collaboration_engagement\",\n    \"creator_experience_engagement\",\n    \"esports_engagement\",\n    \"streaming_engagement\",\n    \"sharing_behavior\",\n    \"community_participation\",\n    \"switching_status\",\n    \"switch_out\",\n    \"switch_in\",\n    \"uninstall_status\",\n    \"churn_risk\",\n    \"return_trigger\",\n    \"return_intent\",\n    \"continued_usage_intent\",\n    \"brand_personality\",\n    \"brand_emotion\",\n    \"aspiration_gap\",\n    \"recommendation_intent\",\n    \"invite_friends_intent\",\n    \"nps\",\n    \"payer_status\",\n    \"purchase_frequency\",\n    \"recent_purchase\",\n    \"spend_band_inr\",\n    \"purchase_category\",\n    \"purchase_occasion\",\n    \"purchase_value\",\n    \"price_sensitivity\",\n    \"spending_barrier\",\n    \"retention_driver\",\n    \"advocacy_driver\",\n    \"frequent_gamer\",\n    \"occasional_gamer\",\n    \"payer_segment\",\n    \"non_payer_segment\",\n    \"segment_comparison\",\n    \"quality_status\"\n  ],\n  \"assumptions\": [\n    \"The aided-awareness list includes Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, Other, and an exclusive None of these option.\",\n    \"The recent-use, current-use, lapsed-use, switching, return, and purchase windows will be fixed before fielding and held constant across waves.\",\n    \"The 22-question budget is binding; bundled flow_keys capture multiple closely related metrics where specified.\",\n    \"Age, gender, city, residence, NCCS, income, education, and quota controls are supplied by the audience payload and are not collected in the questionnaire.\",\n    \"The rotating wave module is optional and must fit within the declared question budget without altering stable core KPI wording.\",\n    \"NPS_SCORE is the final question and completion point.\"\n  ],\n  \"ambiguities\": []\n}","model":"openai.gpt-5.6-luna","sources":[],"data":{"version":"1.0","source":"generated","locked_predefined_design":false,"study_type":"Brand health tracking with usage and attitude, competitive benchmarking, loyalty, engagement, switching, and monetisation measures","research_design":{"design":"linear","stimulus_count":0,"cells":[],"rotation":"none","justification":"The brief specifies a zero-stimulus modular tracking design with a stable wave-to-wave KPI core. Respondents report existing gaming behavior, brand perceptions, engagement, loyalty, and spending; no concepts, advertisements, price cells, or other discrete stimuli are evaluated."},"business_goal":"Establish a repeatable brand-health tracker to determine how Epic Games and Fortnite are gaining or losing salience, usage, preference, loyalty, advocacy, and competitive share among Indian mobile gamers. The business will use wave-level results to prioritise acquisition, retention, win-back, competitive-conquest, creator, community, live-service, partnership, and monetisation strategies.","questionnaire_intent":"The questionnaire follows the mandated Brand Equity Funnel: unaided recall precedes aided awareness and the non-aware termination gate, followed by familiarity and usage, perception and equity, emotional connection, and loyalty and advocacy. Conditional modules capture current-player engagement, lapsed-player return barriers, competitor conquest opportunities, and payer/non-payer monetisation behavior while maintaining exactly 22 respondent-facing questions.","survey_objectives":[{"objective":"Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.","importance":"Salience is the first indicator of brand health and identifies whether Fortnite is mentally available before prompting or losing reach to competitors."},{"objective":"Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.","importance":"These measures distinguish superficial awareness from meaningful participation and identify high-value, occasional, lapsed, and conquestable players."},{"objective":"Measure consideration, preference, current and recent usage, and Fortnite choice relative to tracked competitors.","importance":"Funnel conversion identifies where Fortnite gains or loses players and whether acquisition should focus on awareness, consideration, trial, or competitive choice."},{"objective":"Measure Fortnite and competitor associations across fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness, including comparative quality, value, trust, and innovation ratings.","importance":"Perceptual ownership determines the positioning and product-experience territories that should receive investment."},{"objective":"Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity.","importance":"The business needs to identify which ecosystem and social experiences are associated with stronger engagement, loyalty, advocacy, and monetisation."},{"objective":"Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite.","importance":"These findings inform retention, reactivation, win-back, and competitive-conquest interventions."},{"objective":"Measure emotional connection, projective personality, aspiration gap, and emotional associations with Fortnite and relevant alternatives.","importance":"Emotional and aspirational measures reveal whether Fortnite has a distinctive relationship with players beyond functional gameplay."},{"objective":"Measure likelihood to continue, recommend, invite friends, choose Fortnite over alternatives, and NPS among relevant respondents.","importance":"These forward-looking measures provide leading indicators of retention, organic acquisition, advocacy, and competitive resilience."},{"objective":"Measure payer incidence, purchase behavior, broad INR spending, purchase value, and barriers to in-app spending among mobile gamers.","importance":"The business needs to tailor payer conversion, offer, pricing, content-value, and non-payer strategies."},{"objective":"Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes.","importance":"Segment comparisons identify priority audiences and determine where interventions must differ by lifecycle and commercial value."}],"targeted_insights":[{"insight":"Fortnite's unaided awareness, aided awareness, familiarity, consideration, trial, usage, preference, and loyalty conversion relative to BGMI/PUBG, Free Fire, Apex Legends, and other tracked titles.","linked_objectives":["Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.","Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.","Measure consideration, preference, current and recent usage, and Fortnite choice relative to tracked competitors."],"decision_impact":"Determine whether brand investment should focus on salience, consideration conversion, trial, acquisition, or competitive choice."},{"insight":"The competitors most frequently played alongside Fortnite and those most associated with substitution, switching, or share-of-play loss.","linked_objectives":["Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.","Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite."],"decision_impact":"Prioritise competitive-conquest messaging and defensive retention actions against the highest-risk titles."},{"insight":"The attributes and emotional territories Fortnite owns versus competitors, particularly creativity, ecosystem breadth, social experience, collaborations, live events, competition, and value.","linked_objectives":["Measure Fortnite and competitor associations across fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness, including comparative quality, value, trust, and innovation ratings.","Measure emotional connection, projective personality, aspiration gap, and emotional associations with Fortnite and relevant alternatives."],"decision_impact":"Select the positioning, communication, partnership, and product-experience territories to emphasise."},{"insight":"Which live-service, social, creator, community, esports, and collaboration experiences are associated with stronger continued usage, recommendation, invitation, and NPS.","linked_objectives":["Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity.","Measure likelihood to continue, recommend, invite friends, choose Fortnite over alternatives, and NPS among relevant respondents."],"decision_impact":"Allocate investment across live-service content, creators, collaborations, esports, social features, and community programs."},{"insight":"The strongest triggers and barriers for stopping, uninstalling, switching away from, returning to, or trying Fortnite.","linked_objectives":["Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite."],"decision_impact":"Design targeted churn-prevention, win-back, reactivation, and conquest interventions."},{"insight":"Payer incidence, purchase frequency, spending bands, content categories, perceived value, and spending barriers by play intensity, engagement type, loyalty status, and player lifecycle.","linked_objectives":["Measure payer incidence, purchase behavior, broad INR spending, purchase value, and barriers to in-app spending among mobile gamers.","Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes."],"decision_impact":"Tailor cosmetic, collaboration, event, pricing, value-communication, and payer-conversion strategies."},{"insight":"Differences in brand health, engagement, loyalty, advocacy, switching, and monetisation across current, lapsed, competitor-only, frequent, occasional, payer, non-payer, creator, and community segments.","linked_objectives":["Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes."],"decision_impact":"Set segment-specific acquisition, retention, win-back, community, and monetisation priorities."},{"insight":"Wave-level movement in brand-health KPIs interpreted against seasonal launches, collaborations, campaigns, esports moments, and market events.","linked_objectives":["Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.","Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity."],"decision_impact":"Separate durable brand movement from event-driven spikes and refine future tracking-wave planning."}],"respondent_segments":[{"key":"brand_aware","definition":"Respondents selecting at least one tracked gaming brand or title in aided awareness.","qualification_rule":"BRAND_AWARENESS_AIDED contains one or more options other than None of these.","expected_path":"Continue through the applicable familiarity, usage, perception, emotional, loyalty, and monetisation path."},{"key":"non_aware","definition":"Respondents who do not recognise any tracked gaming brand or title in aided awareness.","qualification_rule":"BRAND_AWARENESS_AIDED selects None of these and no other option.","expected_path":"Terminate immediately after SALIENCE."},{"key":"current_fortnite_player","definition":"Brand-aware respondents who play Fortnite within the defined current-use window.","qualification_rule":"FORTNITE_STATUS selects Current Fortnite player.","expected_path":"Receive current-player engagement module, shared emotional and loyalty measures, and payer routing."},{"key":"lapsed_fortnite_player","definition":"Respondents who previously played Fortnite but do not play within the defined current-use window.","qualification_rule":"FORTNITE_STATUS selects Lapsed/former Fortnite player.","expected_path":"Receive lapsed stopping, switching, churn, and return module, followed by shared emotional and loyalty measures."},{"key":"competitor_only_player","definition":"Respondents who play tracked competitors but have never played Fortnite.","qualification_rule":"FORTNITE_STATUS selects Competitor player who has never played Fortnite.","expected_path":"Receive competitor conquest and Fortnite trial-barrier module, followed by shared emotional and loyalty measures where applicable."},{"key":"aware_non_player","definition":"Brand-aware respondents without current, lapsed, or competitor-only Fortnite status.","qualification_rule":"FORTNITE_STATUS selects Aware but not a current, lapsed, or competitor-only player.","expected_path":"Skip lifecycle-specific modules and continue through shared brand, emotional, loyalty, and payer measures."},{"key":"payer","definition":"Respondents who made an in-app purchase in the defined recent purchase window.","qualification_rule":"PAYER_STATUS selects Yes, made an in-app purchase.","expected_path":"Receive payer purchase behavior and value module."},{"key":"non_payer","definition":"Respondents with no in-app purchase in the defined recent purchase window.","qualification_rule":"PAYER_STATUS selects No purchase in the recent period.","expected_path":"Receive spending-barrier and value module."}],"questionnaire_sections":[{"key":"SALIENCE","purpose":"Measure spontaneous and prompted brand awareness before any detailed brand evaluation, supporting the salience and funnel objectives.","question_keys":["BRAND_RECALL_UNAIDED","BRAND_AWARENESS_AIDED"]},{"key":"FAMILIARITY_USAGE","purpose":"Measure familiarity, competitive trial and repertoire, usage intensity, platform behavior, and Fortnite lifecycle status, supporting the funnel, competitive, behavioral, and segment-comparison objectives.","question_keys":["BRAND_FAMILIARITY","BRAND_TRIAL","USAGE_PROFILE","FORTNITE_STATUS"]},{"key":"PERCEPTION_EQUITY","purpose":"Measure consideration, comparative brand equity, attributes, current-player engagement, lapsed-player return barriers, and competitor conquest opportunities.","question_keys":["BRAND_ATTRIBUTES","COMPETITOR_RATING_GRID","BRAND_FUNNEL_CONSIDERATION","CURRENT_FORTNITE_ENGAGEMENT","LAPSED_FORTNITE_RETURN","COMPETITOR_CONQUEST"]},{"key":"EMOTIONAL_CONNECTION","purpose":"Measure projective personality, emotional association, and aspiration gap to identify Fortnite's emotional and aspirational territory.","question_keys":["BRAND_PERSONALITY","BRAND_EMOTION","ASPIRATION_GAP"]},{"key":"LOYALTY_ADVOCACY","purpose":"Measure churn risk, advocacy, continuation, competitive choice, payer status, monetisation, spending barriers, and NPS before the final completion point.","question_keys":["CHURN_RISK","RECOMMEND_AND_INVITE","CONTINUE_AND_CHOOSE","PAYER_STATUS","PAYER_PURCHASE_VALUE","NON_PAYER_SPENDING_BARRIERS","NPS_SCORE"]}],"business_rules":[{"id":"BR1","plain_english":"Ask BRAND_RECALL_UNAIDED before showing any aided brand list or naming the detailed tracked brands."},{"id":"BR2","plain_english":"BRAND_AWARENESS_AIDED must include an exclusive None of these option. If None of these is selected with no other option, terminate immediately as non-aware and ineligible."},{"id":"BR3","plain_english":"If at least one tracked brand or title is selected in BRAND_AWARENESS_AIDED, classify the respondent as brand_aware and continue."},{"id":"BR4","plain_english":"Use BRAND_TRIAL to measure the competitive repertoire and carry only selected trial brands, in the same option order, into COMPETITOR_RATING_GRID."},{"id":"BR5","plain_english":"Use USAGE_PROFILE to capture bundled frequency, recency, session duration, platform mix, multiplayer behavior, and Fortnite share-of-play indicators without adding separate questions beyond the 22-question budget."},{"id":"BR6","plain_english":"Use FORTNITE_STATUS to route current players to current engagement, lapsed players to stopping and return diagnostics, competitor-only players to conquest diagnostics, and other aware respondents past lifecycle-specific modules."},{"id":"BR7","plain_english":"Use recency anchoring consistently for play, stopping, switching, returning, and purchasing measures across all waves."},{"id":"BR8","plain_english":"Use stable wording and scales for core tracking KPIs. Any wave-specific campaign, collaboration, seasonal, creator, esports, or competitor content must be incorporated without changing the core order or question budget."},{"id":"BR9","plain_english":"Use PAYER_STATUS to route purchasers to purchase behavior and value measures and non-payers to spending barriers and value measures."},{"id":"BR10","plain_english":"Use projective personality, aspiration gap, and a price-anchor approach within the declared questions; the price anchor must not create price cells or experimental assignment."},{"id":"BR11","plain_english":"Apply external quality controls for attention, speed, straight-lining, open-end quality, duplicate records, and implausible behavior. Failed quality cases are quality terminates and must not be classified as non-aware screen-outs."},{"id":"BR12","plain_english":"After NPS_SCORE, complete every respondent who has reached the final loyalty path. No mandatory questions or modules may follow NPS_SCORE."}],"dynamic_lists":[{"id":"DL1","source_question_key":"BRAND_TRIAL","target_question_key":"COMPETITOR_RATING_GRID","mode":"selected","purpose":"Show only brands selected as used in BRAND_TRIAL, preserving the exact option labels and order for comparative quality, value, trust, and innovation ratings."}],"branch_blocks":[{"id":"BB1","source_question_key":"FORTNITE_STATUS","selection_mode":"single","blocks":[{"option_label":"Current Fortnite player","member_question_keys":["CURRENT_FORTNITE_ENGAGEMENT"]},{"option_label":"Lapsed/former Fortnite player","member_question_keys":["LAPSED_FORTNITE_RETURN"]},{"option_label":"Competitor player who has never played Fortnite","member_question_keys":["COMPETITOR_CONQUEST"]},{"option_label":"Aware but not a current, lapsed, or competitor-only player","member_question_keys":[]}],"rejoin_question_key":"BRAND_PERSONALITY"},{"id":"BB2","source_question_key":"PAYER_STATUS","selection_mode":"single","blocks":[{"option_label":"Yes, made an in-app purchase","member_question_keys":["PAYER_PURCHASE_VALUE"]},{"option_label":"No purchase in the recent period","member_question_keys":["NON_PAYER_SPENDING_BARRIERS"]}],"rejoin_question_key":"NPS_SCORE"}],"termination_and_completion_policy":[{"condition":"BRAND_AWARENESS_AIDED selects None of these and no other aided-awareness option.","outcome":"terminate"},{"condition":"A respondent fails an attention, speed, consistency, duplicate, open-end quality, or implausible-behavior validation.","outcome":"terminate"},{"condition":"A brand-aware respondent does not qualify for a current-player, lapsed-player, or competitor-only module.","outcome":"skip"},{"condition":"A respondent is not a current Fortnite player.","outcome":"skip"},{"condition":"A respondent is not a payer in the defined recent purchase window.","outcome":"skip"},{"condition":"A brand-aware respondent completes the applicable path through NPS_SCORE.","outcome":"complete"}],"question_generation_instructions":["METHODOLOGY: Brand Tracking — Brand Equity Funnel. Use the mandated order: unaided recall, aided awareness with non-aware termination, familiarity and usage, perception and equity, emotional connection, then loyalty and advocacy.","Generate exactly 22 respondent-facing questions using only the declared flow_keys. Do not add demographic, quota, or database-known targeting questions.","Keep core wording, response scales, brand lists, and KPI definitions stable across waves. Use compact bundled questions where a flow_key explicitly covers multiple related metrics.","BRAND_RECALL_UNAIDED must be open text and must precede BRAND_AWARENESS_AIDED. BRAND_AWARENESS_AIDED must be multi-select with an exclusive None of these option.","Use BRAND_TRIAL as a multi-select source and carry its selected options, in identical labels and order, into the vertical-ranking COMPETITOR_RATING_GRID.","Use recency anchoring for usage, recent play, stopping, switching, return, and purchase measures. Preserve the same time windows across waves.","Use BRAND_ATTRIBUTES as a concise multi-select association measure covering fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness.","Use BRAND_PERSONALITY with the projective prompt 'If [Brand] were a person...' and BRAND_EMOTION with at least Excited, Trusted, Indifferent, and Disappointed.","Use ASPIRATION_GAP to compare the current Fortnite or mobile-gaming experience with the experience respondents ideally want.","Use a price-anchor technique within PAYER_PURCHASE_VALUE or NON_PAYER_SPENDING_BARRIERS without creating price cells or turning the study into a pricing experiment.","Route current, lapsed, competitor-only, payer, and non-payer respondents through the declared branch blocks. Do not create duplicate per-question show-if logic.","Use NPS_SCORE as a 0–10 number rating and place it as the final respondent-facing question and completion point.","Ensure the data supports funnel conversion, competitive repertoire, share of play, usage intensity, brand differentiation, live-service engagement, switching, return, advocacy, monetisation, and segment-comparison analysis."],"analysis_tags":["wave_id","field_period","brand_aware_status","unaided_awareness","aided_awareness","familiarity","brand_trial","competitive_repertoire","main_brand","usage_frequency","gaming_recency","session_duration","fortnite_share_of_play","platform_mix","game_genre","multiplayer_participation","squad_play","current_usage","recent_usage","fortnite_status","current_fortnite_player","lapsed_fortnite_player","competitor_only_player","consideration","preference","competitive_choice","brand_attributes","brand_quality","brand_value","brand_trust","brand_innovation","brand_differentiation","ecosystem_perception","social_experience","creativity_perception","live_service_engagement","seasonal_update_engagement","collaboration_engagement","creator_experience_engagement","esports_engagement","streaming_engagement","sharing_behavior","community_participation","switching_status","switch_out","switch_in","uninstall_status","churn_risk","return_trigger","return_intent","continued_usage_intent","brand_personality","brand_emotion","aspiration_gap","recommendation_intent","invite_friends_intent","nps","payer_status","purchase_frequency","recent_purchase","spend_band_inr","purchase_category","purchase_occasion","purchase_value","price_sensitivity","spending_barrier","retention_driver","advocacy_driver","frequent_gamer","occasional_gamer","payer_segment","non_payer_segment","segment_comparison","quality_status"],"assumptions":["The aided-awareness list includes Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, Other, and an exclusive None of these option.","The recent-use, current-use, lapsed-use, switching, return, and purchase windows will be fixed before fielding and held constant across waves.","The 22-question budget is binding; bundled flow_keys capture multiple closely related metrics where specified.","Age, gender, city, residence, NCCS, income, education, and quota controls are supplied by the audience payload and are not collected in the questionnaire.","The rotating wave module is optional and must fit within the declared question budget without altering stable core KPI wording.","NPS_SCORE is the final question and completion point."],"ambiguities":[]},"version":"1.0","source":"generated","locked_predefined_design":false,"study_type":"Brand health tracking with usage and attitude, competitive benchmarking, loyalty, engagement, switching, and monetisation measures","research_design":{"design":"linear","stimulus_count":0,"cells":[],"rotation":"none","justification":"The brief specifies a zero-stimulus modular tracking design with a stable wave-to-wave KPI core. Respondents report existing gaming behavior, brand perceptions, engagement, loyalty, and spending; no concepts, advertisements, price cells, or other discrete stimuli are evaluated."},"business_goal":"Establish a repeatable brand-health tracker to determine how Epic Games and Fortnite are gaining or losing salience, usage, preference, loyalty, advocacy, and competitive share among Indian mobile gamers. The business will use wave-level results to prioritise acquisition, retention, win-back, competitive-conquest, creator, community, live-service, partnership, and monetisation strategies.","questionnaire_intent":"The questionnaire follows the mandated Brand Equity Funnel: unaided recall precedes aided awareness and the non-aware termination gate, followed by familiarity and usage, perception and equity, emotional connection, and loyalty and advocacy. Conditional modules capture current-player engagement, lapsed-player return barriers, competitor conquest opportunities, and payer/non-payer monetisation behavior while maintaining exactly 22 respondent-facing questions.","survey_objectives":[{"objective":"Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.","importance":"Salience is the first indicator of brand health and identifies whether Fortnite is mentally available before prompting or losing reach to competitors."},{"objective":"Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.","importance":"These measures distinguish superficial awareness from meaningful participation and identify high-value, occasional, lapsed, and conquestable players."},{"objective":"Measure consideration, preference, current and recent usage, and Fortnite choice relative to tracked competitors.","importance":"Funnel conversion identifies where Fortnite gains or loses players and whether acquisition should focus on awareness, consideration, trial, or competitive choice."},{"objective":"Measure Fortnite and competitor associations across fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness, including comparative quality, value, trust, and innovation ratings.","importance":"Perceptual ownership determines the positioning and product-experience territories that should receive investment."},{"objective":"Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity.","importance":"The business needs to identify which ecosystem and social experiences are associated with stronger engagement, loyalty, advocacy, and monetisation."},{"objective":"Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite.","importance":"These findings inform retention, reactivation, win-back, and competitive-conquest interventions."},{"objective":"Measure emotional connection, projective personality, aspiration gap, and emotional associations with Fortnite and relevant alternatives.","importance":"Emotional and aspirational measures reveal whether Fortnite has a distinctive relationship with players beyond functional gameplay."},{"objective":"Measure likelihood to continue, recommend, invite friends, choose Fortnite over alternatives, and NPS among relevant respondents.","importance":"These forward-looking measures provide leading indicators of retention, organic acquisition, advocacy, and competitive resilience."},{"objective":"Measure payer incidence, purchase behavior, broad INR spending, purchase value, and barriers to in-app spending among mobile gamers.","importance":"The business needs to tailor payer conversion, offer, pricing, content-value, and non-payer strategies."},{"objective":"Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes.","importance":"Segment comparisons identify priority audiences and determine where interventions must differ by lifecycle and commercial value."}],"targeted_insights":[{"insight":"Fortnite's unaided awareness, aided awareness, familiarity, consideration, trial, usage, preference, and loyalty conversion relative to BGMI/PUBG, Free Fire, Apex Legends, and other tracked titles.","linked_objectives":["Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.","Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.","Measure consideration, preference, current and recent usage, and Fortnite choice relative to tracked competitors."],"decision_impact":"Determine whether brand investment should focus on salience, consideration conversion, trial, acquisition, or competitive choice."},{"insight":"The competitors most frequently played alongside Fortnite and those most associated with substitution, switching, or share-of-play loss.","linked_objectives":["Measure brand familiarity, trial, competitive repertoire, main-brand status, usage frequency, recency, session intensity, platform mix, and Fortnite share of play among eligible mobile gamers.","Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite."],"decision_impact":"Prioritise competitive-conquest messaging and defensive retention actions against the highest-risk titles."},{"insight":"The attributes and emotional territories Fortnite owns versus competitors, particularly creativity, ecosystem breadth, social experience, collaborations, live events, competition, and value.","linked_objectives":["Measure Fortnite and competitor associations across fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness, including comparative quality, value, trust, and innovation ratings.","Measure emotional connection, projective personality, aspiration gap, and emotional associations with Fortnite and relevant alternatives."],"decision_impact":"Select the positioning, communication, partnership, and product-experience territories to emphasise."},{"insight":"Which live-service, social, creator, community, esports, and collaboration experiences are associated with stronger continued usage, recommendation, invitation, and NPS.","linked_objectives":["Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity.","Measure likelihood to continue, recommend, invite friends, choose Fortnite over alternatives, and NPS among relevant respondents."],"decision_impact":"Allocate investment across live-service content, creators, collaborations, esports, social features, and community programs."},{"insight":"The strongest triggers and barriers for stopping, uninstalling, switching away from, returning to, or trying Fortnite.","linked_objectives":["Measure lapsed-player stopping, uninstalling, switching, churn risk, return triggers, and likelihood to return, and measure competitor-only barriers and triggers for trying Fortnite."],"decision_impact":"Design targeted churn-prevention, win-back, reactivation, and conquest interventions."},{"insight":"Payer incidence, purchase frequency, spending bands, content categories, perceived value, and spending barriers by play intensity, engagement type, loyalty status, and player lifecycle.","linked_objectives":["Measure payer incidence, purchase behavior, broad INR spending, purchase value, and barriers to in-app spending among mobile gamers.","Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes."],"decision_impact":"Tailor cosmetic, collaboration, event, pricing, value-communication, and payer-conversion strategies."},{"insight":"Differences in brand health, engagement, loyalty, advocacy, switching, and monetisation across current, lapsed, competitor-only, frequent, occasional, payer, non-payer, creator, and community segments.","linked_objectives":["Compare current Fortnite players, lapsed players, competitor-only players, frequent gamers, occasional gamers, payers, non-payers, and socially or community-active players across brand health, engagement, loyalty, and monetisation outcomes."],"decision_impact":"Set segment-specific acquisition, retention, win-back, community, and monetisation priorities."},{"insight":"Wave-level movement in brand-health KPIs interpreted against seasonal launches, collaborations, campaigns, esports moments, and market events.","linked_objectives":["Measure unaided recall and aided awareness of Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other tracked gaming brands among Indian mobile gamers to benchmark spontaneous and total brand salience.","Measure current-player engagement with multiplayer and squad play, seasonal updates, live events, collaborations, creator experiences, esports, streaming, sharing, and community activity."],"decision_impact":"Separate durable brand movement from event-driven spikes and refine future tracking-wave planning."}],"respondent_segments":[{"key":"brand_aware","definition":"Respondents selecting at least one tracked gaming brand or title in aided awareness.","qualification_rule":"BRAND_AWARENESS_AIDED contains one or more options other than None of these.","expected_path":"Continue through the applicable familiarity, usage, perception, emotional, loyalty, and monetisation path."},{"key":"non_aware","definition":"Respondents who do not recognise any tracked gaming brand or title in aided awareness.","qualification_rule":"BRAND_AWARENESS_AIDED selects None of these and no other option.","expected_path":"Terminate immediately after SALIENCE."},{"key":"current_fortnite_player","definition":"Brand-aware respondents who play Fortnite within the defined current-use window.","qualification_rule":"FORTNITE_STATUS selects Current Fortnite player.","expected_path":"Receive current-player engagement module, shared emotional and loyalty measures, and payer routing."},{"key":"lapsed_fortnite_player","definition":"Respondents who previously played Fortnite but do not play within the defined current-use window.","qualification_rule":"FORTNITE_STATUS selects Lapsed/former Fortnite player.","expected_path":"Receive lapsed stopping, switching, churn, and return module, followed by shared emotional and loyalty measures."},{"key":"competitor_only_player","definition":"Respondents who play tracked competitors but have never played Fortnite.","qualification_rule":"FORTNITE_STATUS selects Competitor player who has never played Fortnite.","expected_path":"Receive competitor conquest and Fortnite trial-barrier module, followed by shared emotional and loyalty measures where applicable."},{"key":"aware_non_player","definition":"Brand-aware respondents without current, lapsed, or competitor-only Fortnite status.","qualification_rule":"FORTNITE_STATUS selects Aware but not a current, lapsed, or competitor-only player.","expected_path":"Skip lifecycle-specific modules and continue through shared brand, emotional, loyalty, and payer measures."},{"key":"payer","definition":"Respondents who made an in-app purchase in the defined recent purchase window.","qualification_rule":"PAYER_STATUS selects Yes, made an in-app purchase.","expected_path":"Receive payer purchase behavior and value module."},{"key":"non_payer","definition":"Respondents with no in-app purchase in the defined recent purchase window.","qualification_rule":"PAYER_STATUS selects No purchase in the recent period.","expected_path":"Receive spending-barrier and value module."}],"questionnaire_sections":[{"key":"SALIENCE","purpose":"Measure spontaneous and prompted brand awareness before any detailed brand evaluation, supporting the salience and funnel objectives.","question_keys":["BRAND_RECALL_UNAIDED","BRAND_AWARENESS_AIDED"]},{"key":"FAMILIARITY_USAGE","purpose":"Measure familiarity, competitive trial and repertoire, usage intensity, platform behavior, and Fortnite lifecycle status, supporting the funnel, competitive, behavioral, and segment-comparison objectives.","question_keys":["BRAND_FAMILIARITY","BRAND_TRIAL","USAGE_PROFILE","FORTNITE_STATUS"]},{"key":"PERCEPTION_EQUITY","purpose":"Measure consideration, comparative brand equity, attributes, current-player engagement, lapsed-player return barriers, and competitor conquest opportunities.","question_keys":["BRAND_ATTRIBUTES","COMPETITOR_RATING_GRID","BRAND_FUNNEL_CONSIDERATION","CURRENT_FORTNITE_ENGAGEMENT","LAPSED_FORTNITE_RETURN","COMPETITOR_CONQUEST"]},{"key":"EMOTIONAL_CONNECTION","purpose":"Measure projective personality, emotional association, and aspiration gap to identify Fortnite's emotional and aspirational territory.","question_keys":["BRAND_PERSONALITY","BRAND_EMOTION","ASPIRATION_GAP"]},{"key":"LOYALTY_ADVOCACY","purpose":"Measure churn risk, advocacy, continuation, competitive choice, payer status, monetisation, spending barriers, and NPS before the final completion point.","question_keys":["CHURN_RISK","RECOMMEND_AND_INVITE","CONTINUE_AND_CHOOSE","PAYER_STATUS","PAYER_PURCHASE_VALUE","NON_PAYER_SPENDING_BARRIERS","NPS_SCORE"]}],"business_rules":[{"id":"BR1","plain_english":"Ask BRAND_RECALL_UNAIDED before showing any aided brand list or naming the detailed tracked brands."},{"id":"BR2","plain_english":"BRAND_AWARENESS_AIDED must include an exclusive None of these option. If None of these is selected with no other option, terminate immediately as non-aware and ineligible."},{"id":"BR3","plain_english":"If at least one tracked brand or title is selected in BRAND_AWARENESS_AIDED, classify the respondent as brand_aware and continue."},{"id":"BR4","plain_english":"Use BRAND_TRIAL to measure the competitive repertoire and carry only selected trial brands, in the same option order, into COMPETITOR_RATING_GRID."},{"id":"BR5","plain_english":"Use USAGE_PROFILE to capture bundled frequency, recency, session duration, platform mix, multiplayer behavior, and Fortnite share-of-play indicators without adding separate questions beyond the 22-question budget."},{"id":"BR6","plain_english":"Use FORTNITE_STATUS to route current players to current engagement, lapsed players to stopping and return diagnostics, competitor-only players to conquest diagnostics, and other aware respondents past lifecycle-specific modules."},{"id":"BR7","plain_english":"Use recency anchoring consistently for play, stopping, switching, returning, and purchasing measures across all waves."},{"id":"BR8","plain_english":"Use stable wording and scales for core tracking KPIs. Any wave-specific campaign, collaboration, seasonal, creator, esports, or competitor content must be incorporated without changing the core order or question budget."},{"id":"BR9","plain_english":"Use PAYER_STATUS to route purchasers to purchase behavior and value measures and non-payers to spending barriers and value measures."},{"id":"BR10","plain_english":"Use projective personality, aspiration gap, and a price-anchor approach within the declared questions; the price anchor must not create price cells or experimental assignment."},{"id":"BR11","plain_english":"Apply external quality controls for attention, speed, straight-lining, open-end quality, duplicate records, and implausible behavior. Failed quality cases are quality terminates and must not be classified as non-aware screen-outs."},{"id":"BR12","plain_english":"After NPS_SCORE, complete every respondent who has reached the final loyalty path. No mandatory questions or modules may follow NPS_SCORE."}],"dynamic_lists":[{"id":"DL1","source_question_key":"BRAND_TRIAL","target_question_key":"COMPETITOR_RATING_GRID","mode":"selected","purpose":"Show only brands selected as used in BRAND_TRIAL, preserving the exact option labels and order for comparative quality, value, trust, and innovation ratings."}],"branch_blocks":[{"id":"BB1","source_question_key":"FORTNITE_STATUS","selection_mode":"single","blocks":[{"option_label":"Current Fortnite player","member_question_keys":["CURRENT_FORTNITE_ENGAGEMENT"]},{"option_label":"Lapsed/former Fortnite player","member_question_keys":["LAPSED_FORTNITE_RETURN"]},{"option_label":"Competitor player who has never played Fortnite","member_question_keys":["COMPETITOR_CONQUEST"]},{"option_label":"Aware but not a current, lapsed, or competitor-only player","member_question_keys":[]}],"rejoin_question_key":"BRAND_PERSONALITY"},{"id":"BB2","source_question_key":"PAYER_STATUS","selection_mode":"single","blocks":[{"option_label":"Yes, made an in-app purchase","member_question_keys":["PAYER_PURCHASE_VALUE"]},{"option_label":"No purchase in the recent period","member_question_keys":["NON_PAYER_SPENDING_BARRIERS"]}],"rejoin_question_key":"NPS_SCORE"}],"termination_and_completion_policy":[{"condition":"BRAND_AWARENESS_AIDED selects None of these and no other aided-awareness option.","outcome":"terminate"},{"condition":"A respondent fails an attention, speed, consistency, duplicate, open-end quality, or implausible-behavior validation.","outcome":"terminate"},{"condition":"A brand-aware respondent does not qualify for a current-player, lapsed-player, or competitor-only module.","outcome":"skip"},{"condition":"A respondent is not a current Fortnite player.","outcome":"skip"},{"condition":"A respondent is not a payer in the defined recent purchase window.","outcome":"skip"},{"condition":"A brand-aware respondent completes the applicable path through NPS_SCORE.","outcome":"complete"}],"question_generation_instructions":["METHODOLOGY: Brand Tracking — Brand Equity Funnel. Use the mandated order: unaided recall, aided awareness with non-aware termination, familiarity and usage, perception and equity, emotional connection, then loyalty and advocacy.","Generate exactly 22 respondent-facing questions using only the declared flow_keys. Do not add demographic, quota, or database-known targeting questions.","Keep core wording, response scales, brand lists, and KPI definitions stable across waves. Use compact bundled questions where a flow_key explicitly covers multiple related metrics.","BRAND_RECALL_UNAIDED must be open text and must precede BRAND_AWARENESS_AIDED. BRAND_AWARENESS_AIDED must be multi-select with an exclusive None of these option.","Use BRAND_TRIAL as a multi-select source and carry its selected options, in identical labels and order, into the vertical-ranking COMPETITOR_RATING_GRID.","Use recency anchoring for usage, recent play, stopping, switching, return, and purchase measures. Preserve the same time windows across waves.","Use BRAND_ATTRIBUTES as a concise multi-select association measure covering fun, creativity, social connection, variety, competition, cultural relevance, trust, value, and distinctiveness.","Use BRAND_PERSONALITY with the projective prompt 'If [Brand] were a person...' and BRAND_EMOTION with at least Excited, Trusted, Indifferent, and Disappointed.","Use ASPIRATION_GAP to compare the current Fortnite or mobile-gaming experience with the experience respondents ideally want.","Use a price-anchor technique within PAYER_PURCHASE_VALUE or NON_PAYER_SPENDING_BARRIERS without creating price cells or turning the study into a pricing experiment.","Route current, lapsed, competitor-only, payer, and non-payer respondents through the declared branch blocks. Do not create duplicate per-question show-if logic.","Use NPS_SCORE as a 0–10 number rating and place it as the final respondent-facing question and completion point.","Ensure the data supports funnel conversion, competitive repertoire, share of play, usage intensity, brand differentiation, live-service engagement, switching, return, advocacy, monetisation, and segment-comparison analysis."],"analysis_tags":["wave_id","field_period","brand_aware_status","unaided_awareness","aided_awareness","familiarity","brand_trial","competitive_repertoire","main_brand","usage_frequency","gaming_recency","session_duration","fortnite_share_of_play","platform_mix","game_genre","multiplayer_participation","squad_play","current_usage","recent_usage","fortnite_status","current_fortnite_player","lapsed_fortnite_player","competitor_only_player","consideration","preference","competitive_choice","brand_attributes","brand_quality","brand_value","brand_trust","brand_innovation","brand_differentiation","ecosystem_perception","social_experience","creativity_perception","live_service_engagement","seasonal_update_engagement","collaboration_engagement","creator_experience_engagement","esports_engagement","streaming_engagement","sharing_behavior","community_participation","switching_status","switch_out","switch_in","uninstall_status","churn_risk","return_trigger","return_intent","continued_usage_intent","brand_personality","brand_emotion","aspiration_gap","recommendation_intent","invite_friends_intent","nps","payer_status","purchase_frequency","recent_purchase","spend_band_inr","purchase_category","purchase_occasion","purchase_value","price_sensitivity","spending_barrier","retention_driver","advocacy_driver","frequent_gamer","occasional_gamer","payer_segment","non_payer_segment","segment_comparison","quality_status"],"assumptions":["The aided-awareness list includes Epic Games, Fortnite, BGMI/PUBG, Free Fire, Apex Legends, Other, and an exclusive None of these option.","The recent-use, current-use, lapsed-use, switching, return, and purchase windows will be fixed before fielding and held constant across waves.","The 22-question budget is binding; bundled flow_keys capture multiple closely related metrics where specified.","Age, gender, city, residence, NCCS, income, education, and quota controls are supplied by the audience payload and are not collected in the questionnaire.","The rotating wave module is optional and must fit within the declared question budget without altering stable core KPI wording.","NPS_SCORE is the final question and completion point."],"ambiguities":[]},"routing_logic":{"text":"{\n  \"version\": \"1.0\",\n  \"source_business_flow_version\": \"1.0\",\n  \"question_keys\": [\n    {\n      \"key\": \"BRAND_RECALL_UNAIDED\",\n      \"expected_role\": \"screener\",\n      \"required\": true\n    },\n    {\n      \"key\": \"BRAND_AWARENESS_AIDED\",\n      \"expected_role\": \"screener\",\n      \"required\": true\n    },\n    {\n      \"key\": \"BRAND_FAMILIARITY\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"BRAND_TRIAL\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"USAGE_PROFILE\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"FORTNITE_STATUS\",\n      \"expected_role\": \"branch_gate\",\n      \"required\": true\n    },\n    {\n      \"key\": \"BRAND_ATTRIBUTES\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"COMPETITOR_RATING_GRID\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"BRAND_FUNNEL_CONSIDERATION\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"CURRENT_FORTNITE_ENGAGEMENT\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LAPSED_FORTNITE_RETURN\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"COMPETITOR_CONQUEST\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"BRAND_PERSONALITY\",\n      \"expected_role\": \"rejoin\",\n      \"required\": true\n    },\n    {\n      \"key\": \"BRAND_EMOTION\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"ASPIRATION_GAP\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"CHURN_RISK\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"RECOMMEND_AND_INVITE\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"CONTINUE_AND_CHOOSE\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"PAYER_STATUS\",\n      \"expected_role\": \"branch_gate\",\n      \"required\": true\n    },\n    {\n      \"key\": \"PAYER_PURCHASE_VALUE\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"NON_PAYER_SPENDING_BARRIERS\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"NPS_SCORE\",\n      \"expected_role\": \"close\",\n      \"required\": true\n    }\n  ],\n  \"rules\": [\n    {\n      \"id\": \"R1\",\n      \"source_question_key\": \"BRAND_AWARENESS_AIDED\",\n      \"condition\": {\n        \"operator\": \"equals\",\n        \"values\": [\n          \"None of these\"\n        ]\n      },\n      \"action\": {\n        \"type\": \"terminate\"\n      },\n      \"reason\": \"Terminate immediately when the respondent selects the exclusive non-awareness option and therefore recognises none of the tracked brands.\"\n    }\n  ],\n  \"display_rules\": [],\n  \"dynamic_filters\": [\n    {\n      \"target_question_key\": \"COMPETITOR_RATING_GRID\",\n      \"filter_from_question_key\": \"BRAND_TRIAL\",\n      \"mode\": \"selected\",\n      \"requires_same_option_order\": true,\n      \"config\": {\n        \"mode\": \"ranking\",\n        \"optMode\": \"choice\",\n        \"keepDeselectAll\": true,\n        \"enforceMinMaxFromCount\": false\n      }\n    }\n  ],\n  \"branch_blocks\": [\n    {\n      \"id\": \"BB1\",\n      \"source_question_key\": \"FORTNITE_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Current Fortnite player\",\n          \"member_question_keys\": [\n            \"CURRENT_FORTNITE_ENGAGEMENT\"\n          ]\n        },\n        {\n          \"option_label\": \"Lapsed/former Fortnite player\",\n          \"member_question_keys\": [\n            \"LAPSED_FORTNITE_RETURN\"\n          ]\n        },\n        {\n          \"option_label\": \"Competitor player who has never played Fortnite\",\n          \"member_question_keys\": [\n            \"COMPETITOR_CONQUEST\"\n          ]\n        },\n        {\n          \"option_label\": \"Aware but not a current, lapsed, or competitor-only player\",\n          \"member_question_keys\": []\n        }\n      ],\n      \"rejoin_question_key\": \"BRAND_PERSONALITY\"\n    },\n    {\n      \"id\": \"BB2\",\n      \"source_question_key\": \"PAYER_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Yes, made an in-app purchase\",\n          \"member_question_keys\": [\n            \"PAYER_PURCHASE_VALUE\"\n          ]\n        },\n        {\n          \"option_label\": \"No purchase in the recent period\",\n          \"member_question_keys\": [\n            \"NON_PAYER_SPENDING_BARRIERS\"\n          ]\n        }\n      ],\n      \"rejoin_question_key\": \"NPS_SCORE\"\n    }\n  ],\n  \"rejoin_rules\": [\n    {\n      \"branch_end_question_key\": \"CURRENT_FORTNITE_ENGAGEMENT\",\n      \"rejoin_question_key\": \"BRAND_PERSONALITY\"\n    },\n    {\n      \"branch_end_question_key\": \"LAPSED_FORTNITE_RETURN\",\n      \"rejoin_question_key\": \"BRAND_PERSONALITY\"\n    },\n    {\n      \"branch_end_question_key\": \"COMPETITOR_CONQUEST\",\n      \"rejoin_question_key\": \"BRAND_PERSONALITY\"\n    },\n    {\n      \"branch_end_question_key\": \"PAYER_PURCHASE_VALUE\",\n      \"rejoin_question_key\": \"NPS_SCORE\"\n    },\n    {\n      \"branch_end_question_key\": \"NON_PAYER_SPENDING_BARRIERS\",\n      \"rejoin_question_key\": \"NPS_SCORE\"\n    }\n  ],\n  \"completion_rules\": [\n    {\n      \"question_key\": \"NPS_SCORE\",\n      \"condition\": \"always\",\n      \"outcome\": \"complete\"\n    }\n  ],\n  \"ambiguities\": [\n    \"Quality-control termination is declared as an external validation outcome rather than a questionnaire-flow rule because no quality-control flow_key is present.\",\n    \"The business flow states that BRAND_AWARENESS_AIDED has an exclusive None of these option; the termination rule therefore treats an exact None of these response as the non-aware condition.\"\n  ],\n  \"validator_expectations\": [\n    \"All question_keys must exist in generated questions.\",\n    \"All routing references use flow_key values only; no qIds or UUIDs are permitted.\",\n    \"BRAND_RECALL_UNAIDED must precede BRAND_AWARENESS_AIDED.\",\n    \"BRAND_AWARENESS_AIDED selecting None of these must terminate before any downstream section.\",\n    \"All dynamic filters must use identical option text and option order between BRAND_TRIAL and COMPETITOR_RATING_GRID.\",\n    \"The BRAND_TRIAL to COMPETITOR_RATING_GRID dynamic filter must use selected brands only.\",\n    \"FORTNITE_STATUS branch expansion must be handled through BB1 without duplicate go_to or per-member display rules.\",\n    \"PAYER_STATUS branch expansion must be handled through BB2 without duplicate go_to or per-member display rules.\",\n    \"Only conditionally visible questions outside declared branch blocks may receive showIf protection; no display rules are required for the declared branch-block members.\",\n    \"All branch paths must rejoin at BRAND_PERSONALITY or NPS_SCORE as declared.\",\n    \"NPS_SCORE is the final respondent-facing question and the sole normal completion point.\",\n    \"The linear zero-stimulus design creates no random-cell or monadic routing.\",\n    \"No demographic or database-known targeting questions are routed.\",\n    \"Quality-control failures must remain distinct from the non-aware screen-out classification.\"\n  ]\n}","model":"openai.gpt-5.6-luna","sources":[],"data":{"version":"1.0","source_business_flow_version":"1.0","question_keys":[{"key":"BRAND_RECALL_UNAIDED","expected_role":"screener","required":true},{"key":"BRAND_AWARENESS_AIDED","expected_role":"screener","required":true},{"key":"BRAND_FAMILIARITY","expected_role":"segment_classifier","required":true},{"key":"BRAND_TRIAL","expected_role":"dynamic_source","required":true},{"key":"USAGE_PROFILE","expected_role":"segment_classifier","required":true},{"key":"FORTNITE_STATUS","expected_role":"branch_gate","required":true},{"key":"BRAND_ATTRIBUTES","expected_role":"segment_classifier","required":true},{"key":"COMPETITOR_RATING_GRID","expected_role":"dynamic_source","required":true},{"key":"BRAND_FUNNEL_CONSIDERATION","expected_role":"segment_classifier","required":true},{"key":"CURRENT_FORTNITE_ENGAGEMENT","expected_role":"branch_followup","required":true},{"key":"LAPSED_FORTNITE_RETURN","expected_role":"branch_followup","required":true},{"key":"COMPETITOR_CONQUEST","expected_role":"branch_followup","required":true},{"key":"BRAND_PERSONALITY","expected_role":"rejoin","required":true},{"key":"BRAND_EMOTION","expected_role":"segment_classifier","required":true},{"key":"ASPIRATION_GAP","expected_role":"segment_classifier","required":true},{"key":"CHURN_RISK","expected_role":"segment_classifier","required":true},{"key":"RECOMMEND_AND_INVITE","expected_role":"segment_classifier","required":true},{"key":"CONTINUE_AND_CHOOSE","expected_role":"segment_classifier","required":true},{"key":"PAYER_STATUS","expected_role":"branch_gate","required":true},{"key":"PAYER_PURCHASE_VALUE","expected_role":"branch_followup","required":true},{"key":"NON_PAYER_SPENDING_BARRIERS","expected_role":"branch_followup","required":true},{"key":"NPS_SCORE","expected_role":"close","required":true}],"rules":[{"id":"R1","source_question_key":"BRAND_AWARENESS_AIDED","condition":{"operator":"equals","values":["None of these"]},"action":{"type":"terminate"},"reason":"Terminate immediately when the respondent selects the exclusive non-awareness option and therefore recognises none of the tracked brands."}],"display_rules":[],"dynamic_filters":[{"target_question_key":"COMPETITOR_RATING_GRID","filter_from_question_key":"BRAND_TRIAL","mode":"selected","requires_same_option_order":true,"config":{"mode":"ranking","optMode":"choice","keepDeselectAll":true,"enforceMinMaxFromCount":false}}],"branch_blocks":[{"id":"BB1","s