[[4,69]],[[4,71]],[[4,72]],["UL",{},[[4,73]],["LI",{},[[4,75]]," Confirm current employment, paid-work status, expecting-parent or parent status, child-care responsibility, work recency, and current work model. This establishes eligibility without collecting demographic information already enforced by audience targeting."],[[4,78]],["LI",{},["STRONG",{},"Phase 2 — Work and Caregiving Context:"]," Capture actual work location, expected office attendance, schedule control, pregnancy stage or child age, caregiving role, childcare access, leave status, and typical work-care overlap."],"\n",["LI",{},["STRONG",{},"Phase 3 — Recent Workplace Experiences:"]," Measure concrete recent experiences involving interruptions, meetings, after-hours work, schedule changes, concentration, workspace, technology, workload, and ability to disconnect."],"\n",["LI",{},["STRONG",{},"Phase 4 — Manager, Team, and Career Experience:"]," Assess comfort requesting flexibility, manager responses, psychological safety, workload allocation, performance visibility, promotion confidence, access to important work, and career progression concerns."],"\n",["LI",{},"**Phase 5 — Employe"],"\n"]],[[40,513]]]]]],[[44,568]],[[44,569]]]]]]]],[[244,75]],[[534,191]]]]]],[[44,592]]]]]]]]]],[[550,507]],[[550,508]],[[550,509]]],[[550,656]],[[516,178]],[[534,236]],[[516,179]],[[146,599]],[[44,602]]]],"viewport":{"width":1280,"height":720},"timestamp":333429.782,"wallTime":1786695465454,"collectionTime":2.300000011920929,"resourceOverrides":[],"isMainFrame":true}}
