data: {"type":"final","sequence":0,"request_id":"24d0a32e-5d06-41ca-a2d4-7267dbec44e5","status":true,"message":"Chat turn processed successfully.","timestamp":"2026-08-14T08:26:16.055435+00:00","data":{"ai_message":"Mobile gaming habits and brand loyalty are clear; I have a few targeted questions to shape the right tracking study.","chat_id":"03a74ac5-bd15-459c-b9fe-f6417495eae6","guest_id":null,"chat_turn_id":"cc409768-291c-4744-9ed9-39a99083dbbe","chat_name":"New Chat (2026-08-14 08:26)","turn_number":0,"survey_turn_number":null,"questions":[],"media_request":null,"research_brief":null,"research_framework":null,"context_request":[{"question":"Which gaming brand, game, publisher, platform, or category should this survey track? Please describe the brand set and the market context.","options":null,"multi_select":false},{"question":"Which gaming behaviors should the survey cover? Select all that apply.","options":["Mobile game usage frequency and session patterns","Game genres, titles, and platform choices","In-app purchases and spending behavior","Reasons for switching, uninstalling, or returning","Social, multiplayer, and community behavior"],"multi_select":true},{"question":"Which brand-health measures matter most? Select all that apply.","options":["Unaided and aided awareness","Familiarity and consideration","Current usage and recent usage","Brand associations and differentiation","Loyalty, advocacy, and likelihood to continue"],"multi_select":true},{"question":"Who should answer the survey? Select all that apply.","options":["Current mobile gamers","Occasional or lapsed mobile gamers","Players of the tracked brand or game","Players of competing games","Parents or household decision-makers for younger players"],"multi_select":true},{"question":"What is the single most important decision this research should support?","options":["Establish a baseline for future tracking","Identify ways to improve retention and loyalty","Understand competitive brand position","Guide marketing, partnerships, or campaign strategy"],"multi_select":false},{"question":"Is this intended as a one-time study or a recurring tracking survey, and when do you need the first wave completed?","options":["One-time study","Monthly or quarterly tracking","Two or more planned waves","Not decided yet"],"multi_select":false}],"qna_context":null,"audience_payload":null,"cta_buttons":null,"end_message":null,"see_why":null,"superJSurveyId":null,"superJSurveyName":null,"businessId":null,"error":null,"changes_detected":true,"log_message":null,"exhausted":false,"usage_info":{"tier_type":"FREE","daily_limit":null,"tokens_used_today":0,"tokens_remaining":0,"chat_context_limit":400000,"chat_tokens_used":0,"chat_tokens_remaining":400000,"monthly_chat_limit":10,"chats_created_this_month":1,"chats_remaining":9,"exhausted":false,"exhausted_reason":null},"business_flow":null,"routing_logic":null,"route_logs":[],"urls_referred":[]},"require_auth":false}

