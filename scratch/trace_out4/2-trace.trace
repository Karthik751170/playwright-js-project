ont-normal leading-[140%] tracking-normal text-[#464646] whitespace-pre-wrap break-words mt-[2px] roboto_8068afc-module__EN1jzW__className","style":"user-select: text; cursor: text;"},"Yes, create the survey."]]]],["DIV",{"class":"flex-shrink-0 "},["DIV",{"class":""},["DIV",{"class":"w-6 h-6 ml-1 flex-shrink-0 rounded-full flex items-center justify-center bg-[#027AD3] text-white"},["DIV",{"class":"text-[14px] font-medium text-white"},"U"]]]]]]]]]],["DIV",{"class":"flex justify-start pointer-events-auto  w-full"},["DIV",{"class":"flex flex-col w-[96%] mx-[2%]"},["DIV",{"class":"flex w-full justify-start"}],["DIV",{"class":"flex w-full "},["DIV",{"class":"flex rounded-[8px] bg-transparent text-[#464646] w-full flex-shrink-0  mt-2"},["DIV",{"class":"flex flex-col w-full"},["DIV",{"class":"mb-8 pointer-events-auto"},["DIV",{"class":"w-full max-w-[800px] mt-[12px]"},["STYLE",{},"\n/* One sweep (~2.7s), then a ~0.3s rest, per 3s iteration. The travel is exactly one\n   tile period (background-size 200% → a 200% shift), so the loop point is\n   seamless. The rest frames hold at 200% ≡ 0%, where the visible window shows\n   only the gradient's flat #B8B8B8 half (highlight lives in the 50–100% stops),\n   so nothing is frozen mid-text during the pause — the text just sits gray. */\n@keyframes ws-shimmer-sweep { 0% { background-position: 0% 0; animation-timing-function: ease-in-out; } 90% { background-position: 200% 0; } 100% { background-position: 200% 0; } }\n@keyframes ws-spin { to { transform: rotate(360deg); } }\n@keyframes ws-fade-in { from { opacity: 0; } to { opacity: 1; } }\n.ws-fade-in { animation: ws-fade-in 0.45s ease-out both; }\n.ws-spin-anim { animation: ws-spin 0.7s linear infinite; }\n/* Header icon shimmer — exactly synced with the title ShimmerText: same gradient\n   (#B8B8B8 base, #464646 sweeping highlight), same background-size, same keyframe\n   and 3s timing. The icon SVG is the mask, so the gradient fills the icon's\n   shape (replaces its color while streaming, mirroring the text clip). */\n.ws-icon-shimmer {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-image: linear-gradient(90deg, #464646 0%, #464646 50%, #B8B8B8 75%, #464646 100%);\n  background-size: 200% 100%;\n  animation: ws-shimmer-sweep 3s linear infinite;\n}\n/* Recolorable icon — a single masked span whose background-color IS the icon\n   color. Two clear states: mid-gray #6B6B6B at rest, darkening to the text's\n   hover color #343434 on header hover. (Matching the text's #464646→#343434\n   exactly was imperceptible — text hover reads via font-weight, icons can't do\n   that, so they need a wider color gap.) One element for both states, so the\n   icon's size/position can't shift on hover. */\n.ws-icon-tint {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-color: #6B6B6B;\n  transition: background-color 0.2s ease;\n}\n.group:hover .ws-icon-tint { background-color: #343434; }\n.ws-scroll { scrollbar-width: thin; scrollbar-color: #B0B0B0 #ECECEC; overscroll-behavior-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; }\n.ws-scroll::-webkit-scrollbar { width: 8px; height: 8px; -webkit-appearance: none; }\n.ws-scroll::-webkit-scrollbar-track { background: #ECECEC; border-radius: 4px; }\n.ws-scroll::-webkit-scrollbar-thumb { background: #B0B0B0; border-radius: 4px; border: 2px solid #ECECEC; }\n.ws-scroll::-webkit-scrollbar-thumb:hover { background: #9A9A9A; }\n"],["BUTTON",{"type":"button","aria-expanded":"false","class":"group flex items-center cursor-pointer select-none"},["DIV",{"class":"flex items-center gap-[6px]"},["SPAN",{"class":"relative inline-block flex-shrink-0","style":"width: 13px; height: 13px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-tint","style":"mask-image: url(\"/icons/leaf.svg\");"}]],["SPAN",{"class":"roboto_mono_dc771075-module__pIk42a__className flex items-center gap-[3px] text-[13px] font-normal leading-[140%] tracking-normal allow-text-select"},["SPAN",{"class":"font-normal text-[#464646] group-hover:font-medium group-hover:text-[#343434] transition-colors duration-200"},"Branches being mapped to question IDs"]]],["SPAN",{"class":"relative inline-block self-center flex-shrink-0 ml-[4px] opacity-0 group-hover:opacity-100 scale-y-100 transition-[transform,opacity] duration-300","style":"width: 15px; height: 15px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-tint","style":"mask-image: url(\"/icons/down_chevron.svg\");"}]]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 0fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"ml-[16px] mt-4 mb-[10px] min-w-0"},["DIV",{"class":"flex flex-col min-w-0"},["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 pb-[10px]"},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"Goals, audience, methodology — all in one place."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"The survey flow is being mapped — Hercules is establishing the structure of the study: which sections will appear, in what order, and how the logical sequence of the instrument will serve the research objectives."]]]]]]],["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 pb-[10px]"},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"Everything the study will be held to — being defined right now."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"clas