0:{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is Hercules?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hercules is an AI-powered market research platform that gives you instant access to 20+ million verified consumers for surveys, A/B testing, sentiment analysis, and consumer behavior research.\"}},{\"@type\":\"Question\",\"name\":\"Who uses Hercules?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hercules is trusted by leading organizations including Unilever, Greenply, Government of Karnataka, and even Kantar. Our platform serves journalists, founders, and researchers.\"}},{\"@type\":\"Question\",\"name\":\"How does Hercules verify data integrity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hercules uses blockchain technology and Zero Knowledge Proofs (ZKP) to verify the identity of every respondent, ensuring 100% authentic human data without compromising privacy.\"}}]}"}}],["$","div",null,{"className":"sr-only md:pt-0 flex flex-col justify-center items-center","children":[["$","h1",null,{"children":"About Jupiter Meta Labs â€” The Team Behind Hercules AI"}],["$","div",null,{"className":"md:block hidden","children":["$","$L2",null,{"src":"/webp/bg_image.webp","alt":"Hercules â€” AI-powered market research platform by Jupiter Meta Labs","width":1200,"height":720,"className":"object-contain max-h-[720px] max-w-full","priority":true}]}],["$","div",null,{"className":"md:hidden relative flex items-center justify-center z-10 min-w-[296.9px] min-h-[243.31px]","children":["$","$L2",null,{"src":"/webp/mini-about.webp","alt":"Hercules â€” AI-powered market research platform by Jupiter Meta Labs","width":297,"height":243,"className":"object-contain min-w-[296.9px] min-h-[243.31px]","priority":true}]}],["$","div",null,{"className":"md:w-[801px] md:mx-auto md:px