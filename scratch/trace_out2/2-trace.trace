-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 pb-[10px]"},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"Questions, flow, routing — the survey is being built."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"The survey is being built — Hercules is generating questions from the research brief, sequencing them correctly, and calibrating them to the target audience."]]]]]]],["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 "},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"The survey is being designed — properly."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"The routing compilation step is running — Hercules is wiring the abstract routing rules to the real question IDs so that every conditional path through the survey is correctly implemented."]]]]]]]]]]]]],["DIV",{"class":"flex flex-col w-full overflow-x-visible"},["DIV",{"class":"text-[#22252A]","style":"user-select: text; cursor: text; opacity: 1; transform: none;"},["DIV",{"class":"hchat hchat-md w-full"},["H3",{},"Survey ready"],"\n",["P",{},["STRONG",{},"“Are Workplaces Ready for New Parents?”"]," is ready as a 20-question survey draft. It is designed for expecting parents and parents of young children across remote, hybrid, and office-based workplaces."],"\n",["H3",{},"Research strategy"],"\n",["P",{},"This is an ",["STRONG",{},"Employee Engagement and Organizational Health"]," study examining how workplace policies, manager practices, team norms, workload, and benefits affect the employee experience for new and expecting parents. The findings will help determine which flexible-work policies, management practices, and family-support benefits employers should prioritize to reduce workplace friction and improve retention, wellbeing, and career visibility."],"\n",["H3",{},"Survey structure"],"\n",["P",{},"Respondents will move through seven structured sections: ",["STRONG",{},"Overall Engagement"],", ",["STRONG",{},"Role & Growth"],", ",["STRONG",{},"Manager Relationship"],", ",["STRONG",{},"Team & Collaboration"],", ",["STRONG",{},"Culture & Values"],", ",["STRONG",{},"Wellbeing & Workload"],", and ",["STRONG",{},"Recognition & Fairness"],". The survey uses the combined ",["STRONG",{},"PARENT_STATUS"]," screener to identify expecting parents, current parents, people who are not currently working, and respondents who do not fit either parent group while maintaining the exact 20-question budget."],"\n",["H3",{},"Routing & logic"],"\n",["P",{},"Smart branching and screening logic have been built in. Respondents are routed based on their answers using ",["STRONG",{},"3 branching rules and screening gates"],", helping ensure that relevant questions are shown to eligible participants without adding unnecessary respondent-facing questions."],"\n",["H3",{},"Review and next steps"],"\n",["P",{},"Please review the wording, section flow, eligibility paths, and answer options. I’d be happy to incorporate any changes, such as refining the parent life-stage definitions, adjusting workplace examples, or emphasizing specific policy and manager-practice outcomes before launch."]]],["DIV",{"class":"flex w-full justify-start items-start flex-col mt-[8px] h-[24px] relative overflow-visible","style":"opacity: 1; transform: none;"},["DIV",{"class":"absolute inset-0 flex flex-col justify-between items-start pointer-events-none","style":"opacity: 1;"},["DIV",{"class":"flex items-center gap-[4px] -ml-[5px] pointer-events-auto"},["BUTTON",{"class":"relative group flex items-center justify-center w-[24px] h-[24px] rounded-[8px] overflow-visible cursor-pointer transition-all duration-300 ease-in-out hover:bg-[#F3F3F3]","tabindex":"0"},["SPAN",{"aria-hidden":"true","class":"flex-shrink-0 bg-[#808080] transition-colors duration-200 group-hover:bg-[#2C2C2C]","style":"width: 14px; height: 14px; mask-image: url(\"/icons/copy_2.svg\"); mask-size: contain; mask-repeat: no-repeat; mask-position: center center;"}]],["BUTTON",{"class":"relative group flex items-center justify-center w-[24px] h-[24p