{},"LearnSphere needs to understand why learners do not sustain engagement or complete courses, and which parts"]],["SPAN",{"class":"ml-0.5 inline-block w-[4px] h-[1em] bg-[#464646] animate-blink align-baseline"}]]]]],["DIV"],["DIV",{"style":"height: 5px; width: 100%;"}]]]]]]],[[240,141]],[[1509,191]]]]]],["DIV",{"id":"questionnaire-floating-anchor","class":"w-full relative flex flex-col items-center justify-center flex-shrink-0 mb-[19px] md:mt-0 "},["DIV",{"class":"border border-transparent w-full max-w-[800px] flex flex-col"},["DIV",{"class":"relative w-full flex justify-center"},["DIV",{"class":"relative w-full flex flex-col items-center justify-center"},[[1509,196]],["DIV",{"class":" w-full bg-white md:w-full shadow-[0px_1px_42px_0px_#00000012] border-[0.6px] border-[#BFBFBF] rounded-[12px] md:rounded-[20px] px-[10px] md:px-5 py-[10px] md:py-4 sticky bottom-5 z-10   overflow-visible max-w-[800px] max-h-[460px]"},[[1509,198]],["DIV",{"class":"flex items-center justify-between  mt-[24px]"},[[1509,210]],["DIV",{"class":"relative"},["DIV",{},["DIV",{"class":"relative inline-flex group"},["BUTTON",{"aria-label":"submit button","class":"flex w-9 h-9 md:w-8 md:h-8 items-center justify-center rounded-[10px] p-[7px_7.9px_7.6px_7px] shadow-none md:shadow-[0px_4px_8px_0px_#00000026] transition-transform will-change-transform ease-[cubic-bezier(0.165,0.85,0.45,1)] duration-150 hover:scale-y-[1.015] hover:scale-x-[1.005] active:scale-[0.985] hover:bg-[radial-gradient(at_bottom,hsla(0_0%_100%_/0.20),hsla(0_0%_100%_/0))] active:bg-[radial-gradient(at_bottom,hsla(0_0%_100%_/0.28),hsla(0_0%_100%_/0))] bg-[#C5C5C5] pointer-events-none -mb-[2px]"},["DIV",{"class":"flex items-center justify-center","style":"height: 14px; width: 14px; overflow: hidden;"},["svg",{"width":"16","height":"16","viewBox":"0 0 16 16","fill":"none","xmlns":"http://www.w3.org/2000/svg"},["path",{"d":"M8.7229 1.27884C8.32623 0.88101 7.67291 0.88101 7.27624 1.27884L0.777969 7.77601C0.381302 8.17384 0.381302 8.