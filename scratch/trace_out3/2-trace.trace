px; padding: 0px; will-change: transform;"}],["DIV",{},["STRONG",{},"Background & Context"]]]],"\n",["P",{},"Epic Games and Fortnite operate in a fast-moving mobile gaming environment where player attention can move between Fortnite, BGMI/PUBG, Free Fire, Apex Legends, and other live-service title..."]]],["DIV",{"class":"w-full absolute bottom-0 bg-gradient-to-b from-[#FFFFFF33] to-[#FFFFFFCC] h-20"}]],["DIV",{"class":"absolute right-[48%] -bottom-4 bg-white rounded-full w-8 h-8 flex items-center justify-center border border-[#BBBBBB] shadow-[0px_2px_4px_0px_#0000001F] hover:bg-[#E9E9E9] cursor-pointer"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fdown-arrow.svg&w=16&q=75","alt":"toggle","loading":"lazy","width":"10","height":"10","decoding":"async","data-nimg":"1","class":"rotate-0 transition-all duration-300","srcset":"/_next/image?url=%2Ficons%2Fdown-arrow.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fdown-arrow.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fdown-arrow.svg&w=32&q=75","style":"color: transparent; width: 10px; height: 10px;"}]]]],["DIV",{"class":"text-[15.5px] text-[#464646] whitespace-pre-wrap mt-16","style":"user-select: text; cursor: text; opacity: 1; transform: none;"},["DIV",{"class":"hchat hchat-md inline-block"},["P",{},"Please review the selected tracking methodology, city coverage, age structure, and behavioral audience filters. If the framework looks right, we can move forward to generate the survey instrument. You can still request changes to the sample, audience, wave structure, or methodology before launch."]]],["DIV"],["DIV",{"style":"height: 5px; width: 100%;"}]]]]]]],["DIV",{"class":"flex justify-end pointer-events-auto  w-full"},["DIV",{"class":"flex flex-col w-[96%] mx-[2%]"},["DIV",{"class":"flex w-full justify-end"},["DIV",{"class":"flex rounded-[8px] bg-transparent text-[#464646] items-start mb-4 mt-[24px]"},["DIV",{"class":"flex flex-col items-end w-full"},["DIV",{"class":"