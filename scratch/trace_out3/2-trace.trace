inter-events-none  w-full"},["DIV",{"class":"flex flex-col w-[96%] mx-[2%]"},[[2,3]],["DIV",{"class":"flex w-full "},["DIV",{"class":"flex rounded-[8px] bg-transparent text-[#464646] w-full flex-shrink-0  mt-2"},["DIV",{"class":"flex flex-col w-full"},[[2,440]],["DIV",{"class":"flex flex-col w-full overflow-x-visible"},["DIV",{"class":"text-[#22252A]","style":"user-select: text; cursor: text; opacity: 0; transform: translateY(9.12352px);"},["DIV",{"class":"hchat hchat-md w-full hchat-md--streaming"},["P",{},"I"]]],[[2,443]],[[2,444]]]]]]]],[[2,452]],[[82,75]],[[387,191]]]]]],[[2,469]]]]]]]]]],[[403,507]],[[403,508]],[[403,509]]],[[403,656]],[[369,151]],[[387,236]],[[369,152]],[[2,479]]]],"viewport":{"width":1280,"height":720},"timestamp":161211.773,"wallTime":1786696050188,"collectionTime":2,"resourceOverrides":[],"isMainFrame":true}}
