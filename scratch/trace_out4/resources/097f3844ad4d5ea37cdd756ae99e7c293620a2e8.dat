_key":"ALTERNATIVE_SHARE_OF_LEARNING_TIME","mode":"selected","requires_same_option_order":true},{"filter_from_question_key":"LEARNING_FORMATS_USED","target_question_key":"LEARNING_FORMAT_USEFULNESS","mode":"selected","requires_same_option_order":true}],"branch_blocks":[{"id":"BB1","source_question_key":"LEARNER_STATUS","selection_mode":"single","blocks":[{"option_label":"Current LearnSphere learner","member_question_keys":["COURSE_PROGRESS_STATUS"]},{"option_label":"Former or inactive LearnSphere learner","member_question_keys":["LEARNING_STOP_POINT"]},{"option_label":"Potential digital-learning user","member_question_keys":["ALTERNATIVE_LEARNING_USE"]}],"rejoin_question_key":"ALTERNATIVE_PLATFORMS_USED"},{"id":"BB2","source_question_key":"LEARNER_STATUS","selection_mode":"single","blocks":[{"option_label":"Current LearnSphere learner","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]},{"option_label":"Former or inactive LearnSphere learner","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]},{"option_label":"Potential digital-learning user","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]}],"rejoin_question_key":"NPS_RECOMMENDATION"}],"rejoin_rules":[{"branch_end_question_key":"COURSE_PROGRESS_STATUS","rejoin_question_key":"ALTERNATIVE_PLATFORMS_USED"},{"branch_end_question_key":"LEARNING_STOP_POINT","rejoin_question_key":"ALTERNATIVE_PLATFORMS_USED"},{"branch_end_question_key":"ALTERNATIVE_LEARNING_USE","rejoin_question_key":"ALTERNATIVE_PLATFORMS_USED"},{"branch_end_question_key":"LIFECYCLE_INTENT_AND_WINBACK","rejoin_question_key":"NPS_RECOMMENDATION"}],"completion_rules":[{"question_key":"MOST_IMPORTANT_IMPROVEMENT","condition":"always","outcome":"complete"}],"ambiguities":["The exact option labels for LEARNER_EXPERIENCE_ELIGIBILITY, RELEVANT_LEARNING_NEED, ALTERNATIVE_LEARNING_USE, and RECENT_LEARNSPHERE_ACTIVITY are not supplied; the gate rules use the declared semantic labels Yes and No.","The audience-system eligibility and Indian adult audience gate is external to the supplied flow_keys and therefore is not represented as a questionnaire routing rule.","The optional MaxDiff or forced-trade-off task has no flow_key and no validated candidate list, so no routing rule is emitted for it.","Quality-control mechanisms are declared as embedded controls without flow_keys; their terminate outcome must be implemented by the quality-control layer.","Role-specific multi-role sequencing is not specified. ROLE_SPECIFIC_SUCCESS_CRITERIA is protected for any applicable stakeholder role without creating separate role-specific question keys."],"validator_expectations":["All question_keys must exist in generated questions.","All routing references use flow_key values only; no qIds or UUIDs are permitted.","The declared branch_blocks are the authoritative lifecycle fan-out and must not be duplicated with per-member showIf or go_to rules.","All dynamic filters must use identical option text and option order between source and target questions.","Only conditionally visible non-branch targets have display rules.","No demographic routing is present.","Current, former or inactive, and potential-user paths rejoin the shared flow at ALTERNATIVE_PLATFORMS_USED.","The lifecycle branch rejoins at NPS_RECOMMENDATION.","Every valid respondent path reaches MOST_IMPORTANT_IMPROVEMENT and then the completion rule, while ineligible paths terminate at the declared screening gates."]},"route_logs":[],"urls_referred":[]},"require_auth":false}

