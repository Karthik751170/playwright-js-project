ssName text-[12px] leading-[140%] text-[#464646] font-normal"},"The brief has been partially built — but Hercules has flagged areas where more secondary context is needed, and is now searching for it before locking in the methodology."]]]]]]],["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 pb-[10px]"},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"Goals to brief — the full construction."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"Hercules is mapping the survey flow — laying out the sections, the order they'll appear, and the logic that will guide respondents through the study."]]]]]]],["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 "},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"The brief is being built before the survey is."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"Hercules is defining the routing — mapping the conditional paths through the survey and establishing the logic that determines which questions each respondent group sees."]]]]]]]]]]]]],["DIV",{"class":"flex flex-col w-full overflow-x-visible"},["DIV",{"class":"text-[#22252A]","style":"user-select: text; cursor: text; opacity: 1; transform: none;"},["DIV",{"class":"hchat hchat-md w-full"},["P",{},"Yes — I’ve converted the approved LearnSphere framework into a complete research brief. The study is designed to identify why learners disengage or fail to complete courses, while separating the needs of current learners, inactive learners, potential users, parents, teachers, and administrators. It combines learner-experience measurement, usage and attitude analysis, churn diagnosis, and feature-prioritization logic without introducing unsupported stimulus testing. Please review the brief below and let me know if you would like to adjust the audience, sample size, or methodology before the survey is generated."]]],["DIV",{"class":"relative w-full flex flex-col items-center"},["DIV",{"class":"flex flex-col w-full overflow-visible max-w-[800px] mt-8 rounded-[20px] bg-white border-[0.6px] border-[#BFBFBF] relative pb-11 cursor-pointer shadow-[0px_2px_18px_0px_#00000012]","style":"opacity: 1; transform: none;"},["DIV",{"class":"w-full rounded-tr-[20px] rounded-tl-[20px] border-b-[0.6px] border-[#BFBFBF] bg-[#F8F8F8] pt-[14px] pl-[40px] pr-6 overflow-visible z-0 relative flex justify-between"},["DIV",{"class":"bg-white rounded-tl-[12px] rounded-tr-[12px] border-[0.6px] border-b-0 border-[#BFBFBF] pl-3 pr-9 md:pr-[106px] pt-[9px] pb-1 w-fit relative z-[1] -bottom-[1px] flex items-center justify-between"},["P",{"class":"roboto_mono_6aa40c2c-module__nz6ssW__className text-[14px] font-normal text-[#8D8D8D] leading-[140%]"},"Version ","1"]],["DIV",{"class":"flex items-center gap-[10px] self-center h-full -mt-[10px]"},["BUTTON",{"disabled":"","aria-label":"Share brief","class":"flex-shrink-0 flex items-center justify-center px-[5px] py-[3px] bg-white border border-[#BBBBBB] rounded-[6px] shadow-[0px_2px_4px_0px_#0000001F] opacity-40 cursor-not-allowed"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fshare.svg&w=32&q=75","alt":"share","loading":"lazy","width":"20","height":"20","decoding":"async","data-nimg":"1","srcset":"/_next/image?url=%2Ficons%2Fshare.svg&w=32&q=75 1x, /_next/image?url=%2Ficons%2Fshare.svg&w=48&q=75 2x","src":"/_next/image?url=%2Ficons%2Fshare.svg&w=48&q=75","style":"color: transparent; width: 20px; height: 20px;"}]],["BUTTON",{"disabled":"","aria-label":"Download brief","class":"flex-shrink-0 flex items-center justify-center px-[5px] py-[3px] bg-white border border-[#BBBBBB] rounded-[6px] shadow-[0px_2px_4px_0p