"async","data-nimg":"1","class":"rotate-180 transition-all duration-300","srcset":"/_next/image?url=%2Ficons%2Fdown-arrow.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fdown-arrow.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fdown-arrow.svg&w=32&q=75","style":"color: transparent; width: 10px; height: 10px;"}]]]],[[7,500]],["DIV",{"class":"flex w-full justify-start items-start flex-col mt-[8px] h-[24px] relative overflow-visible","style":"opacity: 1; transform: none;"},["DIV",{"class":"absolute inset-0 flex flex-col justify-between items-start pointer-events-none","style":"opacity: 1;"},["DIV",{"class":"flex items-center gap-[4px] -ml-[5px] pointer-events-auto"},[[7,502]],["BUTTON",{"class":"relative group flex items-center justify-center w-[24px] h-[24px] rounded-[8px] overflow-visible opacity-40 cursor-not-allowed","disabled":""},["SPAN",{"aria-hidden":"true","class":"flex-shrink-0 bg-[#808080] transition-colors duration-200 ","style":"width: 14px; height: 14px; mask-image: url(\"/icons/retry_2.svg\"); mask-size: contain; mask-repeat: no-repeat; mask-position: center center;"}]]]]],["DIV",{"class":"flex flex-wrap gap-[10px] mt-[32px]","style":"opacity: 1; transform: translateY(-2.58604px);"},[[1,456]],[[7,511]]],[[115,498]]]]]]]],["DIV",{"class":"flex justify-end pointer-events-auto  w-full"},["DIV",{"class":"flex flex-col w-[96%] mx-[2%]"},["DIV",{"class":"flex w-full justify-end"},["DIV",{"class":"flex rounded-[8px] bg-transparent text-[#464646] items-start mb-4 mt-2"},["DIV",{"class":"flex flex-col items-end w-full"},["DIV",{"class":"flex justify-center items-center "},["DIV",{"class":"min-w-0"},["DIV",{"data-prompt-bubble":"true","class":"hchat bg-[var(--code-bg)] text-[var(--text)] rounded-[18px] px-[18px] py-[12px] font-medium text-[14px] leading-[1.5] max-w-[500px]","style":"font-family: var(--font-sans);"},["DIV",{"class":"relative w-full"},["P",{"class":"text-[14px] font-normal leading-[140%] tracking-normal text-[#464646] whitespace-pre-wrap break-words mt-[2px] roboto_8068afc-module__EN1jzW__className","style":"user-select: text; cursor: text;"},"Yes, create the survey."]]]],["DIV",{"class":"flex-shrink-0 "},["DIV",{"class":""},["DIV",{"class":"w-6 h-6 ml-1 flex-shrink-0 rounded-full flex items-center justify-center bg-[#027AD3] text-white"},["DIV",{"class":"text-[14px] font-medium text-white"},"U"]]]]]]]]]],["DIV",{"class":"mt-2 flex w-full min-w-0 max-w-full flex-col ml-0 sm:ml-[12px]","style":"opacity: 0; transform: translateY(5.58838px);"},["DIV",{"class":"min-w-0 w-full max-w-full"},["DIV",{"class":"w-full min-w-0 max-w-full mt-[12px]"},["STYLE",{},"\n/* One sweep (~2.7s), then a ~0.3s rest, per 3s iteration. The travel is exactly one\n   tile period (background-size 200% → a 200% shift), so the loop point is\n   seamless. The rest frames hold at 200% ≡ 0%, where the visible window shows\n   only the gradient's flat #B8B8B8 half (highlight lives in the 50–100% stops),\n   so nothing is frozen mid-text during the pause — the text just sits gray. */\n@keyframes ws-shimmer-sweep { 0% { background-position: 0% 0; animation-timing-function: ease-in-out; } 90% { background-position: 200% 0; } 100% { background-position: 200% 0; } }\n@keyframes ws-spin { to { transform: rotate(360deg); } }\n@keyframes ws-fade-in { from { opacity: 0; } to { opacity: 1; } }\n.ws-fade-in { animation: ws-fade-in 0.45s ease-out both; }\n.ws-spin-anim { animation: ws-spin 0.7s linear infinite; }\n/* Header icon shimmer — exactly synced with the title ShimmerText: same gradient\n   (#B8B8B8 base, #464646 sweeping highlight), same background-size, same keyframe\n   and 3s timing. The icon SVG is the mask, so the gradient fills the icon's\n   shape (replaces its color while streaming, mirroring the text clip). */\n.ws-icon-shimmer {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-image: linear-gradient(90deg, #464646 0%, #464646 50%, #B8B8B8 75%, #464646 100%);\n  background-size: 200% 100%;\n  animation: ws-shimmer-sweep 3s linear infinite;\n}\n/* Recolorable icon — a single masked span whose background-color IS the icon\n   color. Two clear states: mid-gray #6B6B6B at rest, darkening to the text's\n   hover color #343434 on header hover. (Matching the text's #464646→#343434\n   exactly was imperceptible — text hover reads via font-weight, icons can't do\n   that, so they need a wider color gap.) One element for both states, so the\n   icon's size/position can't shift on hover. */\n.ws-icon-tint {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-color: #6B6B6B;\n  transition: background-color 0.2s ease;\n}\n.group:hover .ws-icon-tint { background-color: #343434; }\n.ws-scroll { scrollbar-width: thin; scrollbar-color: #B0B0B0 #ECECEC; overscroll-behavior-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; }\n.ws-scroll::-webkit-scrollbar { width: 8px; height: 8px; -webkit-appearance: none; }\n.ws-scroll::-webkit-scrollbar-track { background: #ECECEC; border-radius: 4px; }\n.ws-scroll::-webkit-scrollbar-thumb { background: #B0B0B0; border-radius: 4px; border: 2px solid #ECECEC; }\n.ws-scroll::-webkit-scrollbar-thumb:hover { background: #9A9A9A; }\n"],["DIV",{"class":"flex items-center gap-[6px]"},["SPAN",{"class":"relative inline-block flex-shrink-0","style":"width: 13px; height: 13px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-shimmer","style":"mask-image: url(\"/icons/leaf.svg\");"}]],["SPAN",{"class":"roboto_mono_dc771075-module__pIk42a__className text-[13px] font-normal leading-[140%] tracking-normal"},["SPAN",{"class":"font-normal","style":"display: inline-block; background-image: linear-gradient(90deg, rgb(70, 70, 70) 0%, rgb(70, 70, 70) 50%, rgb(184, 184, 184) 75%, rgb(70, 70, 70) 100%); background-size: 200% 100%; background-repeat: repeat; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; animation: 3s linear 0s infinite normal none running ws-shimmer-sweep;"},"Gathering the infinity stones"]]]]]],[[299,75]],[[604,191]]]]]],["DIV",{"id":"questionnaire-floating-anchor","class":"w-full relative flex flex-col items-center justify-center flex-shrink-0 mb-[19px] md:mt-0 "},["DIV",{"class":"border border-transparent w-full max-w-[800px] flex flex-col"},["DIV",{"class":"relative w-full flex justify-center"},["DIV",{"class":"relative w-full flex flex-col items-center justify-center"},[[604,196]],["DIV",{"class":" w-full bg-white md:w-full shadow-[0px_1px_42px_0px_#00000012] border-[0.6px] border-[#BFBFBF] rounded-[12px] md:rounded-[20px] px-[10px] md:px-5 py-[10px] md:py-4 sticky bottom-5 z-10   overflow-visible max-w-[800px] max-h-[460px]"},[[604,198]],["DIV",{"class":"flex items-center justify-between  mt-[24px]"},[[604,210]],["DIV",{"class":"relative"},["DIV",{},["DIV",{"class":"relative inline-flex group"},["BUTTON",{"aria-label":"submit button","class":"flex w-9 h-9 md:w-8 md:h-8 items-center justify-center rounded-[10px] p-[7px_7.9px_7.6px_7px] shadow-none md:shadow-[0px_4px_8px_0px_#00000026] transition-transform will-change-transform ease-[cubic-bezier(0.165,0.85,0.45,1)] duration-150 hover:scale-y-[1.015] hover:scale-x-[1.005] active:scale-[0.985] hover:bg-[radial-gradient(at_bottom,hsla(0_0%_100%_/0.20),hsla(0_0%_100%_/0))] active:bg-[radial-gradient(at_bottom,hsla(0_0%_100%_/0.28),hsla(0_0%_100%_/0))] cursor-pointer caret-black bg-black -mb-[2px]"},["DIV",{"class":"w-4 h-4 bg-white rounded-full flex items-center justify-center","style":""},["DIV",{"class":"w-2 h-2 bg-black rounded-[1px]"}]]]]]]]]]]]]]]]]]]]],[[620,507]],[[620,508]],[[620,509]]],[[620,656]],[[586,151]],[[604,236]],[[586,152]],[[219,479]],[[115,531]]]],"viewport":{"