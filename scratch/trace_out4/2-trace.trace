ed","disabled":""},["SPAN",{"aria-hidden":"true","class":"flex-shrink-0 bg-[#808080] transition-colors duration-200 ","style":"width: 14px; height: 14px; mask-image: url(\"/icons/retry_2.svg\"); mask-size: contain; mask-repeat: no-repeat; mask-position: center center;"}]]]]],[[69,55]]]]]]]],["DIV",{"class":"flex justify-end pointer-events-auto  w-full"},["DIV",{"class":"flex flex-col w-[96%] mx-[2%]"},["DIV",{"class":"flex w-full "},["DIV",{"class":"flex rounded-[8px] bg-transparent text-[#464646] w-full flex-shrink-0 mb-4 mt-2"},["DIV",{"class":" justify-center mt-6 mb-6 items-start w-full bg-[#F7FBFF] rounded-[12px] border border-[#C4C7C780] "},["DIV",{"class":"border-b-[#C4C7C74D] px-5 md:px-4 py-2 border-b last:border-b-0"},["H2",{"class":"allow-text-select text-[16px] md:text-[18px] leading-[28px] lg:leading-[28px] text-[#1A1C1C] behindtheninetiesmd_75847852-module__RF1Ruq__className"},["SPAN",{},"1"],". ","What product, service, or experience should this survey focus on: Elevate, the digital workspace for remote teams, or a separate meal-planning and nutrition product? Please describe the correct subject and the features being considered."],["P",{"class":"allow-text-select text-[14px] md:text-[15px] leading-[24px] text-[#444748] mb-2 font-inter"},"The product in question is an e-learning platform called 'LearnSphere' that offers a comprehensive online education experience for students of all ages. Currently, LearnSphere provides access to a vast library of video courses, interactive quizzes, and personalized learning plans. It also features a social learning component that enables students to connect with peers and instructors, as well as a progress tracking system that helps students stay on top of their studies. The platform is designed to be user-friendly and accessible on both desktop and mobile devices, with a clean and intuitive interface that makes it easy for students to navigate and find the resources they need.     We are considering adding several new features to LearnSphere, including a virtual reality (VR) component that would allow students to immerse themselves in interactive 3D environments and simulations, a real-time language translation feature that would enable students to communicate with instructors and peers who speak different languages, and a personalized career coaching service that would help students identify their strengths and interests and create a customized career development plan. We also plan to integrate LearnSphere with popular productivity and organization tools, such as Google Calendar and Trello, to help students stay organized and manage their time more effectively."]],["DIV",{"class":"border-b-[#C4C7C74D] px-5 md:px-4 py-2 border-b last:border-b-0"},["H2",{"class":"allow-text-select text-[16px] md:text-[18px] leading-[28px] lg:leading-[28px] text-[#1A1C1C] behindtheninetiesmd_75847852-module__RF1Ruq__className"},["SPAN",{},"2"],". ","What is the primary decision this research should support?"],["P",{"class":"allow-text-select text-[14px] md:text-[15px] leading-[24px] text-[#444748] mb-2 font-inter"},"Identify unmet meal-preparation and nutrition needs"]]]]]]],["DIV",{"class":"mt-2 flex w-full min-w-0 max-w-full flex-col ml-0 sm:ml-[12px]","style":"opacity: 0; transform: translateY(9.22985px);"},["DIV",{"class":"min-w-0 w-full max-w-full"},["DIV",{"class":"w-full min-w-0 max-w-full mt-[12px]"},["STYLE",{},"\n/* One sweep (~2.7s), then a ~0.3s rest, per 3s iteration. The travel is exactly one\n   tile period (background-size 200% → a 200% shift), so the loop point is\n   seamless. The rest frames hold at 200% ≡ 0%, where the visible window shows\n   only the gradient's flat #B8B8B8 half (highlight lives in the 50–100% stops),\n   so nothing is frozen mid-text during the pause — the text just sits gray. */\n@keyframes ws-shimmer-sweep { 0% { background-position: 0% 0; animation-timing-function: ease-in-out; } 90% { background-position: 200% 0; } 100% { background-position: 200% 0; } }\n@keyframes ws-spin { to { transform: rotate(360deg); } }\n@keyframes ws-fade-in { from { opacity: 0; } to { opacity: 1; } }\n.ws-fade-in { animation: ws-fade-in 0.45s ease-out both; }\n.ws-spin-anim { animation: ws-spin 0.7s linear infinite; }\n/* Header icon shimmer — exactly synced with the title ShimmerText: same gradient\n   (#B8B8B8 base, #464646 sweeping highlight), same background-size, same keyframe\n   and 3s timing. The icon SVG is the mask, so the gradient fills the icon's\n   shape (replaces its color while streaming, mirroring the text clip). */\n.ws-icon-shimmer {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-image: linear-gradient(90deg, #464646 0%, #464646 50%, #B8B8B8 75%, #464646 100%);\n  background-size: 200% 100%;\n  animation: ws-shimmer-sweep 3s linear infinite;\n}\n/* Recolorable icon — a single masked span whose background-color IS the icon\n   color. Two clear states: mid-gray #6B6B6B at rest, darkening to the text's\n   hover color #343434 on header hover. (Matching the text's #464646→#343434\n   exactly was imperceptible — text hover reads via font-weight, icons can't do\n   that, so they need a wider color gap.) One element for both states, so the\n   icon's size/position can't shift on hover. */\n.ws-icon-tint {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-color: #6B6B6B;\n  transition: background-color 0.2s ease;\n}\n.group:hover .ws-icon-tint { background-color: #343434; }\n.ws-scroll { scrollbar-width: thin; scrollbar-color: #B0B0B0 #ECECEC; overscroll-behavior-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; }\n.ws-scroll::-webkit-scrollbar { width: 8px; height: 8px; -webkit-appearance: none; }\n.ws-scroll::-webkit-scrollbar-track { background: #ECECEC; border-radius: 4px; }\n.ws-scroll::-webkit-scrollbar-thumb { background: #B0B0B0; border-radius: 4px; border: 2px solid #ECECEC; }\n.ws-scroll::-webkit-scrollbar-thumb:hover { background: #9A9A9A; }\n"],["DIV",{"class":"flex items-center gap-[6px]"},["SPAN",{"class":"relative inline-block flex-shrink-0","style":"width: 13px; height: 13px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-shimmer","style":"mask-image: url(\"/icons/leaf.svg\");"}]],["SPAN",{"class":"roboto_mono_dc771075-module__pIk42a__className text-[13px] font-normal leading-[140%] tracking-normal"},["SPAN",{"class":"font-normal","style":"display: inline-block; background-image: linear-gradient(90deg, rgb(70, 70, 70) 0%, rgb(70, 70, 70) 50%, rgb(184, 184, 184) 75%, rgb(70, 70, 70) 100%); background-size: 200% 100%; background-repeat: repeat; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; animation: 3s linear 0s infinite normal none running ws-shimmer-sweep;"},"I am Hercules!"]]]]]],["DIV",{"style":"height: 300px;"}],[[377,191]]]]]],["DIV",{"id":"questionnaire-floating-anchor","class":"w-full relative flex flex-col items-center justify-center flex-shrink-0 mb-[19px] md:mt-0 "},["DIV",{"class":"border border-transparent w-full max-w-[800px] flex flex-col"},["DIV",{"class":"relative w-full flex justify-center"},["DIV",{"class":"relative w-full flex flex-col items-center justify-center"},[[377,196]],["DIV",{"class":" w-full bg-white md:w-full shadow-[0px_1px_42px_0px_#00000012] border-[0.6px] border-[#BFBFBF] rounded-[12px] md:rounded-[20px] px-[10px] md:px-5 py-[10px] md:py-4 sticky bottom-5 z-10   overflow-visible max-w-[800px] max-h-[460px]"},[[377,198]],["DIV",{"class":"flex items-center justify-between  mt-[24px]"},[[377,210]],["DIV",{"class":"relative"},["DIV",{},["DIV",{"class":"relative inline-flex group"},["BUTTON",{"aria-label":"submit button","c