]],[[4,42]],["UL",{},[[4,43]],[[4,47]],[[4,48]],["LI",{},[[4,50]]," Capture learning objective, course type, expected outcome, study frequency, and the role of parents, teachers, or administrators where relevant. This provides context for interpreting completion and engagement."],[[4,53]],["LI",{},["STRONG",{},"Phase 3 — Usage and Completion Behaviour:"]," Measure recent login or learning frequency, course starts, lesson completion, quiz participation, progress consistency, and the point at which learning stopped. This separates reported attitudes from observed behaviour."],"\n",["LI",{},["STRONG",{},"Phase 4 — Learning Journey and Experience Diagnosis:"]," Assess discovery, onboarding, course selection, navigation, lesson length, technical interruptions, scheduling friction, content relevance, curriculum fit, instructor quality, and resumption of unfinished learning."],"\n",["LI",{},["STRONG",{},"Phase 5 — Engagement Drivers and Learning Support:"]," Examine motivation, progress visibility, feedback, adaptive learning, AI recommendations, reminders, instructor support, social learning, gamification, workload, confidence, and perceived learning progress."],"\n",["LI",{},["STRONG",{},"Phase 6 — Role-Specific Modules:"]," Route potential users to awareness and trial barriers"],"\n"]],[[44,543]]]]]],[[44,548]],[[44,549]]]]]]]],[[284,141]],[[1553,191]]]]]],[[44,572]]]]]]]]]],[[1569,474]],[[1569,475]],[[1569,476]]],[[1569,623]],[[1530,151]],[[1553,236]],[[1530,152]],[[1245,116]],[[1168,78]],[[1068,144]],[[991,82]],[[684,160]],[[607,88]],[[138,601]],[[44,582]]]],"viewport":{"width":1280,"height":720},"timestamp":509636.931,"wallTime":1786698921213,"collectionTime":4.5999999940395355,"resourceOverrides":[],"isMainFrame":true}}
