# Copy to .env (git-ignored) and fill in. Nothing here has a default in source:
# every credential below was previously hardcoded in the repo and should be
# treated as compromised and rotated.

# --- Mailosaur (throwaway account provisioning) ---
MAILOSAUR_UI_EMAIL=
MAILOSAUR_UI_PASSWORD=
MAILOSAUR_SERVER_ID=

# --- Google SSO test account ---
GOOGLE_TEST_EMAIL=
GOOGLE_TEST_PASSWORD=

# --- Hercules admin (only needed by admin-facing tests) ---
HERCULES_ADMIN_USER=
HERCULES_ADMIN_PASSWORD=

# --- Password assigned to newly provisioned throwaway accounts.
#     Optional: a random one is generated per run when unset. ---
HERCULES_SIGNUP_PASSWORD=

# --- Security scan targets. Defaults are derived from ENV/hercules.config,
#     so override only to point at another environment. ---
# TARGET_URL=https://dev.hercules.works
# CORE_API_URL=https://devapi.hercules.works
# AI_API_URL=https://devapi-ai.hercules.works

# --- Path to a Playwright storage state for authenticated scanning.
#     Without it, authenticated controls report INCONCLUSIVE rather than PASS. ---
# SECURITY_STORAGE_STATE=/absolute/path/to/storage-state.json

# --- OWASP ZAP daemon (npm run zap:start) ---
# ZAP_URL=http://127.0.0.1:8080

# --- Password of a pre-existing standing Hercules test account, used by the
#     scratch specs that log back into an account from an earlier run. ---
HERCULES_TEST_ACCOUNT_PASSWORD=
