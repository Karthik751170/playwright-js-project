le__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"The research plan is being put together."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"The routing logic is being mapped — Hercules is establishing the branching paths through the instrument and defining the conditions that determine who gets routed where."]]]]]]],["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 pb-[10px]"},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"The survey is being built — deliberately and in full."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"Hercules is generating the questions — working from the brief and the research design to produce a survey calibrated to the target respondent."]]]]]]],["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 "},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"The instrument is being designed."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"The routing compilation layer is active — Hercules is translating abstract routing rules into concrete logic tied to actual question IDs, ensuring the survey behaves correctly in the field."]]]]]]]]]]]]],["DIV",{"class":"flex flex-col w-full overflow-x-visible"},["DIV",{"class":"text-[#22252A]","style":"user-select: text; cursor: text; opacity: 1; transform: none;"},["DIV",{"class":"hchat hchat-md w-full"},["H3",{},"Survey ready"],"\n",["P",{},"The survey draft ",["STRONG",{},"“Is Fortnite Winning India’s Gamers?”"]," is ready with ",["STRONG",{},"22 respondent-facing questions"],". It follows the approved zero-stimulus tracking design and is structured for consistent measurement across future waves."],"\n",["H3",{},"Research strategy"],"\n",["P",{},"This is a ",["STRONG",{},"brand health tracker"]," for Epic Games and Fortnite among Indian mobile gamers, combining brand equity, competitive benchmarking, usage, engagement, loyalty, advocacy, switching, social play, and monetisation measures. Wave-level results will help the business understand where Fortnite is gaining or losing salience, usage, preference, loyalty, advocacy, and competitive share—and guide acquisition, retention, win-back, and growth priorities."],"\n",["H3",{},"Survey structure"],"\n",["P",{},"Respondents move through the mandated brand-equity funnel: ",["STRONG",{},"unaided recall"],", followed by aided awareness and non-aware termination; ",["STRONG",{},"familiarity and usage"],"; ",["STRONG",{},"perception and equity"],"; ",["STRONG",{},"emotional connection"],"; and finally ",["STRONG",{},"loyalty and advocacy"],". The questionnaire is organised across Salience, Familiarity & Usage, Perception Equity, Emotional Connection, and Loyalty & Advocacy while keeping core wording, brand lists, scales, and KPI definitions stable for tracking."],"\n",["H3",{},"Routing & logic"],"\n",["P",{},"Smart branching and screening logic are built in: ",["STRONG",{},"1 routing rule"]," handles the required branching and screening gates, and ",["STRONG",{},"1 dynamic carry-forward filter"]," helps tailor follow-up responses based on earlier answers."],"\n",["H3",{},"Review invitation"],"\n",["P",{},"Please review the draft and let me know if you would like any wording, response options, brand lists, KPI treatment, or routing logic refined before launch."]]],["DIV"],["DIV",{"class":"flex flex-col w-full mb-[6px]"},["DIV",{},["DIV",{"class":"opacity-100 flex pt-[14px] pb-[14px] px-4  border-[.8px] cursor-pointer mt-7 rounded-[14px] w-full justify-between relative transition-colors duration-200 overflow-hidden ","tabindex":"0","style":"background-color: rgb(253, 246, 240); border-color: rgb(235, 213, 207);"},["DIV",{"class":"w-full"},["DIV",{"class":"flex w-full mb-[6px] md:mb-[4.5008px] justify-between items-center"},["P",{"class":"inter_62138810-module__rE0fQq__className text-[#BA804C] text-[19px] md:text-[16px] leading-[155%] font-medium "},"Your Research Study is in progress"],["BUTTON",{"class":"bg-[#F0DED0] rounded-[4px] h-5 w-5 flex items-center justify-center transition-colors duration-200"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fpause.svg&w=16&q=75","alt":"pause","loading":"lazy","width":"6.67","height":"8.48","decoding":"async","data-nimg":"1","srcset":"/_next/image?url=%2Ficons%2Fpause.svg&w=16&q=75 1x","src":"/_next/image?url=%2Ficons%2Fpause.svg&w=16&q=75","style":"color: transparent;"}]]],["DIV",{"class":"inter_62138810-module__rE0fQq__className text-[14px] text-[#7E7E7E] flex-col  leading-[155%] font-normal gap-[6px] items-center"},["SPAN",{"class":"font-inter font-normal    text-[#9B8572] text-[14px] md:text-[12px] leading-[155%] tracking-[0%] transition-colors duration-200"},"You will be notified when all responses are collected"],["DIV",{"class":"flex flex-col items-start gap-1 md:flex-row md:items-center md:justify-between md:gap-0 mt-[21px] md:mt-[10px]"},["SPAN",{"class":"text-[#BA804C] text-[13px] md:text-[12px] font-inter font-bold leading-[155%] tracking-[0%] whitespace-nowrap flex-shrink-0"},["SPAN",{"class":"text-[#988075] text-[13px] md:text-[12px] font-medium mr-[4px]"},"Completion:"]," 0%"],["SPAN",{"class":"text-[#BA804C] text-[13px] md:text-[12px] font-inter font-bold leading-[155%] tracking-[0%] whitespace-nowrap flex-shrink-0"},["SPAN",{"class":"