w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75","alt":"done","loading":"lazy","width":"14","height":"14","decoding":"async","data-nimg":"1","class":"ws-fade-in","srcset":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=16&q=75 1x, /_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75 2x","src":"/_next/image?url=%2Ficons%2Fws-tick.svg&w=32&q=75","style":"color: transparent; width: 14px; height: 14px;"}]],["SPAN",{"class":"w-px flex-1 my-[8px] min-h-[8px] bg-[#E1E1E1]"}]],["DIV",{"class":"min-w-0 flex-1 "},["DIV",{"class":"flex items-center gap-[4px] text-left min-h-4 cursor-default allow-text-select"},["SPAN",{"class":"roboto_9f186078-module__bqURWG__className ws-fade-in font-medium text-[12px] leading-[140%] tracking-normal text-[#464646]"},"Goals to brief — the full construction."]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"pt-[6px] allow-text-select"},["DIV",{"class":"flex flex-col gap-[2px] mb-[18px]"},["P",{"class":"roboto_9f186078-module__bqURWG__className text-[12px] leading-[140%] text-[#464646] font-normal"},"Hercules is building the routing architecture — defining who sees what, based on what criteria, and mapping the conditional logic that governs the survey flow."]]]]]]]]]]]]],["DIV",{"class":"flex flex-col w-full overflow-x-visible"},["DIV",{"class":"text-[#22252A]","style":"user-select: text; cursor: text; opacity: 1; transform: none;"},["DIV",{"class":"hchat hchat-md w-full"},["P",{},"This is a strong opportunity to establish a repeatable brand-health tracker for Epic Games and Fortnite among Indian mobile gamers. The brief below carries forward the approved framework, covering awareness, competitive usage, live-service engagement, loyalty, advocacy, switching, social play, and in-app spending. I have retained a zero-stimulus tracking design because the study measures existing brand and usage behavior rather than testing concepts or advertising assets. Please review the methodology and audience assumptions below and share any changes before we generate the survey."]]],["DIV",{"class":"relative w-full flex flex-col items-center"},["DIV",{"class":"flex flex-col w-full overflow-visible max-w-[800px] mt-8 rounded-[20px] bg-white border-[0.6px] border-[#BFBFBF] relative pb-11 cursor-pointer shadow-[0px_2px_18px_0px_#00000012]","style":"opacity: 1; transform: none;"},["DIV",{"class":"w-full rounded-tr-[20px] rounded-tl-[20px] border-b-[0.6px] border-[#BFBFBF] bg-[#F8F8F8] pt-[14px] pl-[40px] pr-6 overflow-visible z-0 relative flex justify-between"},["DIV",{"class":"bg-white rounded-tl-[12px] rounded-tr-[12px] border-[0.6px] border-b-0 border-[#BFBFBF] pl-3 pr-9 md:pr-[106px] pt-[9px] pb-1 w-fit relative z-[1] -bottom-[1px] flex items-center justify-between"},["P",{"class":"roboto_mono_6aa40c2c-module__nz6ssW__className text-[14px] font-normal text-[#8D8D8D] leading-[140%]"},"Version ","1"]],["DIV",{"class":"flex items-center gap-[10px] self-center h-full -mt-[10px]"},["BUTTON",{"aria-label":"Share brief","class":"flex-shrink-0 flex items-center justify-center px-[5px] py-[3px] bg-white border border-[#BBBBBB] rounded-[6px] shadow-[0px_2px_4px_0px_#0000001F] hover:bg-[#E9E9E9] cursor-pointer"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fshare.svg&w=32&q=75","alt":"share","loading":"lazy","width":"20","height":"20","decoding":"async","data-nimg":"1","srcset":"/_next/image?url=%2Ficons%2Fshare.svg&w=32&q=75 1x, /_next/image?url=%2Ficons%2Fshare.svg&w=48&q=75 2x","src":"/_next/image?url=%2Ficons%2Fshare.svg&w=48&q=75","style":"color: transparent; width: 20px; height: 20px;"}]],["BUTTON",{"aria-label":"Download brief","class":"flex-shrink-0 flex items-center justi