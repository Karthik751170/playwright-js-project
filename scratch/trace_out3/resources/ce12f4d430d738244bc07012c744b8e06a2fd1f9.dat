:null,"allow_multiple_answers":true,"start_range":null,"end_range":null,"low_rating_label":null,"high_rating_label":null,"options":[{"text":"Epic Games","index":0,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":1,"max_selection":7,"deselect_all":null},{"text":"Fortnite","index":1,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"BGMI/PUBG","index":2,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"Free Fire","index":3,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"Apex Legends","index":4,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"Other","index":5,"image_url":null,"video_url":null,"type":null,"is_explainable":true,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"None of these","index":6,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":true}],"dropdown_options":null,"fields":null,"super_j_question_id":null,"ranking_groups":null,"next":null,"complete":null,"terminate":[6],"expectedAnswer":[],"validationQuestion":false,"filterFrom":null,"filterOut":null,"filterFromConfig":null,"filterOutConfig":null,"showIf":null,"showIfElse":null,"showIfLogic":null,"shuffle":true,"break_heading":null,"break_message":null,"breakVariant":null,"progress_pe