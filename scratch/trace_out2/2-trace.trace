ext-[#464646] items-start mb-4 mt-2"},["DIV",{"class":"flex flex-col items-end w-full"},["DIV",{"class":"flex justify-center items-end "},["DIV",{"class":"min-w-0"},["DIV",{"data-prompt-bubble":"true","class":"hchat bg-[var(--code-bg)] text-[var(--text)] rounded-[18px] px-[18px] py-[12px] font-medium text-[14px] leading-[1.5] max-w-[500px]","style":"font-family: var(--font-sans);"},["DIV",{"class":"relative w-full"},["P",{"class":"text-[14px] font-normal leading-[140%] tracking-normal text-[#464646] whitespace-pre-wrap break-words mt-[2px] roboto_8068afc-module__EN1jzW__className","style":"user-select: text; cursor: text;"},"Create a short survey about remote work preferences to identify pain points among new parents."]]]],["DIV",{"class":"flex-shrink-0 mb-1"},["DIV",{"class":"mt-[10px]"},["DIV",{"class":"w-6 h-6 ml-1 flex-shrink-0 rounded-full flex items-center justify-center bg-[#027AD3] text-white"},["DIV",{"class":"text-[14px] font-medium text-white"},"U"]]]]]]]]]],["DIV",{"class":"mt-2 flex w-full min-w-0 max-w-full flex-col ml-0 sm:ml-[12px]","style":"opacity: 1; transform: none;"},["DIV",{"class":"min-w-0 w-full max-w-full"},["DIV",{"class":"w-full min-w-0 max-w-full mt-[12px]"},["STYLE",{},"\n/* One sweep (~2.7s), then a ~0.3s rest, per 3s iteration. The travel is exactly one\n   tile period (background-size 200% → a 200% shift), so the loop point is\n   seamless. The rest frames hold at 200% ≡ 0%, where the visible window shows\n   only the gradient's flat #B8B8B8 half (highlight lives in the 50–100% stops),\n   so nothing is frozen mid-text during the pause — the text just sits gray. */\n@keyframes ws-shimmer-sweep { 0% { background-position: 0% 0; animation-timing-function: ease-in-out; } 90% { background-position: 200% 0; } 100% { background-position: 200% 0; } }\n@keyframes ws-spin { to { transform: rotate(360deg); } }\n@keyframes ws-fade-in { from { opacity: 0; } to { opacity: 1; } }\n.ws-fade-in { animation: ws-fade-in 0.45s ease-out both; }\n.ws-spin-anim { animation: ws-spin 0.7s linear infinite; }\n/* Header icon shimmer — exactly synced with the title ShimmerText: same gradient\n   (#B8B8B8 base, #464646 sweeping highlight), same background-size, same keyframe\n   and 3s timing. The icon SVG is the mask, so the gradient fills the icon's\n   shape (replaces its color while streaming, mirroring the text clip). */\n.ws-icon-shimmer {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-image: linear-gradient(90deg, #464646 0%, #464646 50%, #B8B8B8 75%, #464646 100%);\n  background-size: 200% 100%;\n  animation: ws-shimmer-sweep 3s linear infinite;\n}\n/* Recolorable icon — a single masked span whose background-color IS the icon\n   color. Two clear states: mid-gray #6B6B6B at rest, darkening to the text's\n   hover color #343434 on header hover. (Matching the text's #464646→#343434\n   exactly was imperceptible — text hover reads via font-weight, icons can't do\n   that, so they need a wider color gap.) One element for both states, so the\n   icon's size/position can't shift on hover. */\n.ws-icon-tint {\n  position: absolute; inset: 0; pointer-events: none;\n  -webkit-mask-size: contain; mask-size: contain;\n  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;\n  -webkit-mask-position: center; mask-position: center;\n  background-color: #6B6B6B;\n  transition: background-color 0.2s ease;\n}\n.group:hover .ws-icon-tint { background-color: #343434; }\n.ws-scroll { scrollbar-width: thin; scrollbar-color: #B0B0B0 #ECECEC; overscroll-behavior-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; }\n.ws-scroll::-webkit-scrollbar { width: 8px; height: 8px; -webkit-appearance: none; }\n.ws-scroll::-webkit-scrollbar-track { background: #ECECEC; border-radius: 4px; }\n.ws-scroll::-webkit-scrollbar-thumb { background: #B0B0B0; border-radius: 4px; border: 2px solid #ECECEC; }\n.ws-scroll::-webkit-scrollbar-thumb:hover { background: #9A9A9A; }\n"],["BUTTON",{"type":"button","aria-expanded":"true","class":"group flex items-center cursor-pointer select-none"},["DIV",{"class":"flex items-center gap-[6px]"},["SPAN",{"class":"relative inline-block flex-shrink-0","style":"width: 13px; height: 13px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-tint","style":"mask-image: url(\"/icons/leaf.svg\");"}]],["SPAN",{"class":"roboto_mono_dc771075-module__pIk42a__className flex items-center gap-[3px] text-[13px] font-normal leading-[140%] tracking-normal allow-text-select"},["SPAN",{"class":"font-normal","style":"display: inline-block; background-image: linear-gradient(90deg, rgb(70, 70, 70) 0%, rgb(70, 70, 70) 50%, rgb(184, 184, 184) 75%, rgb(70, 70, 70) 100%); background-size: 200% 100%; background-repeat: repeat; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; animation: 3s linear 0s infinite normal none running ws-shimmer-sweep;"},"Reading what's been shared in full before proceeding"]]],["SPAN",{"class":"relative inline-block self-center flex-shrink-0 ml-[4px] opacity-100 -scale-y-100 transition-[transform,opacity] duration-300","style":"width: 15px; height: 15px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-shimmer","style":"mask-image: url(\"/icons/down_chevron.svg\");"}]]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 1fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"ml-[16px] pr-0 sm:pr-[12px] mt-4 mb-[10px] min-w-0"},["DIV",{"class":"flex flex-col min-w-0"},["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["SPAN",{"class":"ws-fade-in inline-flex"},["IMG",{"__playwright_current_src__":"https://dev.hercules.works/_next/image?url=%2Ficons%2Fws-loader.svg&w=16&q=75","