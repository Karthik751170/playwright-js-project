rnative_platform_usage"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null},{"id":"preview_question_22","qId":"47bc530e-bdfd-4aa3-82d9-7bc63f99ff64","text":"Imagine you are deciding whether to continue, return to, or try LearnSphere. Which outcome best describes you?","type":"multiple_choice","audio_url":null,"image_url":null,"video_url":null,"watch_only":null,"file_type":null,"validation_description":null,"subheading":"Select one outcome","placeholder":null,"minChar":null,"maxChar":null,"allow_multiple_answers":false,"start_range":null,"end_range":null,"low_rating_label":null,"high_rating_label":null,"options":[{"text":"I am very likely to continue using it","index":0,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"I am somewhat likely to continue using it","index":1,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"I would consider returning or trying it if the right improvement were made","index":2,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"I am unlikely to continue, return, or try it","index":3,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"I am not sure yet","index":4,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null}],"dropdown_options":null,"fields":null,"super_j_question_id":null,"ranking_groups":null,"next":null,"complete":null,"terminate":null,"expectedAnswer":[],"validationQuestion":false,"filterFrom":null,"filterOut":null,"filterFromConfig":null,"filterOutConfig":null,"showIf":{"900e0c62-94fa-4840-a822-8cfafbccf087":[0,1,2]},"showIfElse":"skip","showIfLogic":null,"shuffle":null,"break_heading":null,"break_message":null,"breakVariant":null,"progress_percent":null,"keyboardType":null,"flow_key":"LIFECYCLE_INTENT_AND_WINBACK","business_role":"branch_followup","route_group":"future_intent","analysis_tags":["continue_intent","return_intent","trial_intent","winback_potential","switching_cost","learnsphere_relationship","recommendation_intent"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null},{"id":"preview_question_23","qId":"932c7e94-42de-4276-afdc-5323680eb9bd","text":"How likely are you to recommend LearnSphere to a friend, colleague, or learner who wants to study online?","type":"number_rating","audio_url":null,"image_url":null,"video_url":null,"watch_only":null,"file_type":null,"validation_description":null,"subheading":"1 = Not at all likely, 10 = Extremely likely","placeholder":null,"minChar":null,"maxChar":null,"allow_multiple_answers":null,"start_range":1,"end_range":10,"low_rating_label":"Not at all likely","high_rating_label":"Extremely likely","options":null,"dropdown_options":null,"fields":null,"super_j_question_id":null,"ranking_groups":null,"next":null,"complete":null,"terminate":null,"expectedAnswer":[],"validationQuestion":false,"filterFrom":null,"filterOut":null,"filterFromConfig":null,"filterOutConfig":null,"showIf":null,"showIfElse":null,"showIfLogic":null,"shuffle":null,"break_heading":null,"break_message":null,"breakVariant":null,"progress_percent":null,"keyboardType":null,"flow_key":"NPS_RECOMMENDATION","business_role":"close","route_group":"future_intent","analysis_tags":["recommendation_intent","nps","learnsphere_relationship","continue_intent","return_intent","trial_intent"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null},{"id":"preview_question_24","qId":"22799ffa-7868-41dd-8c27-d0e6fa12f800","text":"If LearnSphere could improve only three areas, which would you put first?","type":"ranking","audio_url":null,"image_url":null,"video_url":null,"watch_only":null,"file_type":null,"validation_description":null,"subheading":"Rank your top three","placeholder":null,"minChar":null,"maxChar":null,"allow_multiple_answers":null,"start_range":null,"end_range":null,"low_rating_label":null,"high_rating_label":null,"options":[{"text":"More relevant and better-structured content","index":0,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":3,"max_selection":3,"deselect_all":null},{"text":"Easier course discovery and navigation","index":1,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"Shorter, more flexible lessons","index":2,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"Better progress tracking and feedback","index":3,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"More useful personalised recommendations","index":4,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"Stronger reminders and motivation tools","index":5,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"Better peer or instructor support","index":6,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null},{"text":"More reliable technology and performance","index":7,"image_url":null,"video_url":null,"type":null,"is_explainable":null,"placeholder":null,"minChar":null,"maxChar":null,"min_selection":null,"max_selection":null,"deselect_all":null}],"dropdown_options":null,"fields":null,"super_j_question_id":null,"ranking_groups":null,"next":null,"complete":null,"terminate":null,"expectedAnswer":[],"validationQuestion":false,"filterFrom":null,"filterOut":null,"filterFromConfig":null,"filterOutConfig":null,"showIf":null,"showIfElse":null,"showIfLogic":null,"shuffle":null,"break_heading":null,"break_message":null,"breakVariant":null,"progress_percent":null,"keyboardType":null,"flow_key":"IMPROVEMENT_PRIORITY","business_role":"close","route_group":"future_intent","analysis_tags":["feature_priority","maxdiff_utility","learnsphere_relationship","course_completion_stage","content_relevance","navigation_friction","motivation_barrier","feedback_usefulness","progress_visibility","continue_intent","return_intent","trial_intent","recommendation_intent"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null},{"id":"preview_question_25","qId":"34b87dba-bc1f-4d2f-af59-9e5ab77685a5","text":"What is the single most important improvement LearnSphere could make to help you keep learning or complete a course?","type":"text","audio_url":null,"image_url":null,"video_url":null,"watch_only":null,"file_type":null,"validation_description":null,"subheading":"Please be specific","placeholder":"Tell us what should change and why","minChar":15,"maxChar":500,"allow_multiple_answers":null,"start_range":null,"end_range":null,"low_rating_label":null,"high_rating_label":null,"options":null,"dropdown_options":null,"fields":null,"super_j_question_id":null,"ranking_groups":null,"next":null,"complete":["__ALWAYS__"],"terminate":null,"expectedAnswer":[],"validationQuestion":false,"filterFrom":null,"filterOut":null,"filterFromConfig":null,"filterOutConfig":null,"showIf":null,"showIfElse":null,"showIfLogic":null,"shuffle":null,"break_heading":null,"break_message":null,"breakVariant":null,"progress_percent":null,"keyboardType":null,"flow_key":"MOST_IMPORTANT_IMPROVEMENT","business_role":"close","route_group":"future_intent","analysis_tags":["open_end_theme","feature_priority","quality_status","learnsphere_relationship","learning_frequency","course_completion_stage","learning_stop_point","social_learning_value","alternative_share_of_learning_time","continue_intent","return_intent","trial_intent","recommendation_intent"],"stimulus_id":null,"cell_id":null,"randomization_group":null,"display_order_group":null,"exposure_acknowledged":null}],"media_request":null,"research_brief":null,"research_framework":null,"context_request":null,"qna_context":null,"audience_payload":{"Nccs":{"A1":"20%","A2":"30%","B1":"30%","B2":"20%"},"Pune":{"tier":"tier1","total":125},"male":250,"18-24":{"total":200},"24-35":{"total":180},"35-45":{"total":120},"Delhi":{"tier":"tier1","total":125},"title":"Keep Learning: The LearnSphere Experience","total":500,"Mumbai":{"tier":"tier1","total":125},"female":250,"Bangalore":{"tier":"tier1","total":125},"checkCity":true,"Attributes":{"Parents or guardians":"10%","Current LearnSphere learners":"40%","Potential digital-learning users":"20%","Former or inactive LearnSphere learners":"20%","Teachers, instructors, or academic administrators":"10%"},"created_by":"hercules","previousstate":{}},"cta_buttons":null,"end_message":null,"see_why":null,"superJSurveyId":"6a7edd0215203e92a622fda8","superJSurveyName":"Why Are Learners Leaving LearnSphere?","businessId":null,"error":null,"changes_detected":true,"log_message":null,"exhausted":false,"usage_info":{"tier_type":"FREE","daily_limit":null,"tokens_used_today":0,"tokens_remaining":0,"chat_context_limit":400000,"chat_tokens_used":0,"chat_tokens_remaining":400000,"monthly_chat_limit":10,"chats_created_this_month":1,"chats_remaining":9,"exhausted":false,"exhausted_reason":null},"business_flow":{"text":"{\n  \"version\": \"1.0\",\n  \"source\": \"generated\",\n  \"locked_predefined_design\": false,\n  \"study_type\": \"Mixed Methodology - Usage & Attitude, Learner Experience, Churn/Exit, Competitive, and Feature Prioritization\",\n  \"research_design\": {\n    \"design\": \"linear\",\n    \"stimulus_count\": 0,\n    \"cells\": [],\n    \"rotation\": \"none\",\n    \"justification\": \"The brief specifies a linear modular questionnaire with role-based routing and no discrete concepts, prototypes, screens, or competing assets. MaxDiff is conditional on receiving at least five defined improvement options and is not a stimulus-cell design.\"\n  },\n  \"business_goal\": \"Determine which learner-experience, content, motivation, feedback, technology, and journey problems LearnSphere should address first to increase sustained engagement, course completion, return usage, and recommendation. Results will set the next product-release priorities, identify recoverable inactive learners and win-back actions, and determine whether LearnSphere has sufficient evidence and capabilities for certification or institutional-partnership expansion.\",\n  \"questionnaire_intent\": \"Use a three-phase funnel: concise eligibility and lifecycle screening, a core of behavioural and experience diagnosis, and a closing phase covering stakeholder success criteria, future intent, prioritisation, advocacy, and the final improvement recommendation. Role and lifecycle routing prevents current learners, inactive learners, potential users, parents, educators, and administrators from being combined into misleading scores.\",\n  \"survey_objectives\": [\n    {\n      \"objective\": \"Measure recent learning frequency, course progress, completion status, and stopping points among current and former LearnSphere learners to identify where engagement pauses or ends.\",\n      \"importance\": \"This establishes the behavioural basis for completion and churn analysis rather than relying only on stated satisfaction.\"\n    },\n    {\n      \"objective\": \"Measure journey-stage experience and friction from discovery and onboarding through course participation, progress tracking, interruption, and resumption.\",\n      \"importance\": \"LearnSphere needs to identify the precise stages requiring product or process improvement.\"\n    },\n    {\n      \"objective\": \"Measure content relevance and the usefulness of instructional formats such as videos, quizzes, practice, plans, dashboards, and reminders.\",\n      \"importance\": \"This distinguishes content and learning-design problems from motivation, time, or technology barriers.\"\n    },\n    {\n      \"objective\": \"Measure primary and secondary engagement barriers, including content, time, motivation, navigation, technology, value, trust, and competition barriers.\",\n      \"importance\": \"Barrier segmentation is needed to match users with appropriate product fixes, content changes, or interventions.\"\n    },\n    {\n      \"objective\": \"Measure awareness and perceived value of AI recommendations, adaptive learning, feedback, reminders, progress visibility, social learning, and gamification among respondents with relevant exposure.\",\n      \"importance\": \"The business must distinguish feature awareness from trusted, useful mechanisms that create genuine learning momentum.\"\n    },\n    {\n      \"objective\": \"Measure usage of competing platforms, offline alternatives, creator-led content, coaching, institutional systems, and peer-learning routes, including their share of learning time.\",\n      \"importance\": \"This reveals where learning time is diverted and where competitive switching pressure originates.\"\n    },\n    {\n      \"objective\": \"Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups.\",\n      \"importance\": \"These indicators quantify retention, acquisition, recoverability, and advocacy potential.\"\n    },\n    {\n      \"objective\": \"Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators.\",\n      \"importance\": \"These requirements inform household adoption, educator use, institutional readiness, and partnership decisions.\"\n    },\n    {\n      \"objective\": \"Prioritise the improvement area most likely to increase engagement, completion, return usage, and recommendation, with a conditional forced-trade-off or MaxDiff exercise if a validated feature list is supplied.\",\n      \"importance\": \"LearnSphere needs a practical roadmap signal instead of an undifferentiated list of highly rated improvements.\"\n    },\n    {\n      \"objective\": \"Measure likelihood to recommend and the most important improvement respondents want LearnSphere to make.\",\n      \"importance\": \"Advocacy and an open-ended recommendation provide a benchmark and reveal unmet needs not captured in predefined categories.\"\n    }\n  ],\n  \"targeted_insights\": [\n    {\n      \"insight\": \"Identify which content, journey, feedback, progress-visibility, and friction factors are most associated with sustained learning and completion.\",\n      \"linked_objectives\": [\n        \"Measure recent learning frequency, course progress, completion status, and stopping points among current and former LearnSphere learners to identify where engagement pauses or ends.\",\n        \"Measure journey-stage experience and friction from discovery and onboarding through course participation, progress tracking, interruption, and resumption.\",\n        \"Measure content relevance and the usefulness of instructional formats such as videos, quizzes, practice, plans, dashboards, and reminders.\"\n      ],\n      \"decision_impact\": \"Set product and learning-design priorities most likely to improve sustained progress and completion.\"\n    },\n    {\n      \"insight\": \"Segment inactivity into content-led, time-led, motivation-led, technology-led, navigation-led, value-led, trust-led, and competition-led profiles.\",\n      \"linked_objectives\": [\n        \"Measure primary and secondary engagement barriers, including content, time, motivation, navigation, technology, value, trust, and competition barriers.\",\n        \"Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups.\"\n      ],\n      \"decision_impact\": \"Match each segment to an appropriate product fix, content intervention, reminder, offer, or win-back campaign.\"\n    },\n    {\n      \"insight\": \"Determine whether personalised tools and engagement mechanisms create momentum only when learners notice, understand, trust, and value them.\",\n      \"linked_objectives\": [\n        \"Measure awareness and perceived value of AI recommendations, adaptive learning, feedback, reminders, progress visibility, social learning, and gamification among respondents with relevant exposure.\"\n      ],\n      \"decision_impact\": \"Decide whether to improve capability, explainability, onboarding, visibility, trust messaging, social features, or gamification.\"\n    },\n    {\n      \"insight\": \"Map the alternatives competing for learning time and identify the routes most associated with switching or non-completion.\",\n      \"linked_objectives\": [\n        \"Measure usage of competing platforms, offline alternatives, creator-led content, coaching, institutional systems, and peer-learning routes, including their share of learning time.\"\n      ],\n      \"decision_impact\": \"Refine positioning, differentiation, retention strategy, and competitive response.\"\n    },\n    {\n      \"insight\": \"Compare continuation, return, trial, recommendation, and success criteria across current learners, former learners, potential users, parents, educators, and administrators.\",\n      \"linked_objectives\": [\n        \"Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups.\",\n        \"Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators.\"\n      ],\n      \"decision_impact\": \"Create separate learner, household, acquisition, educator, and institutional strategies rather than relying on one blended score.\"\n    },\n    {\n      \"insight\": \"Produce a prioritised improvement roadmap and identify unmet needs that predefined measures do not capture.\",\n      \"linked_objectives\": [\n        \"Prioritise the improvement area most likely to increase engagement, completion, return usage, and recommendation, with a conditional forced-trade-off or MaxDiff exercise if a validated feature list is supplied.\",\n        \"Measure likelihood to recommend and the most important improvement respondents want LearnSphere to make.\"\n      ],\n      \"decision_impact\": \"Allocate next-release investment toward improvements with the strongest stated or relative value.\"\n    },\n    {\n      \"insight\": \"Identify the evidence gaps that must be addressed before certification or institutional-partnership expansion.\",\n      \"linked_objectives\": [\n        \"Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators.\"\n      ],\n      \"decision_impact\": \"Decide whether to proceed with expansion or first invest in outcomes evidence, safety, monitoring, reporting, implementation, and institutional support.\"\n    }\n  ],\n  \"respondent_segments\": [\n    {\n      \"key\": \"current_learner\",\n      \"definition\": \"A respondent who currently uses LearnSphere and reports recent platform activity.\",\n      \"qualification_rule\": \"LEARNER_STATUS = \\\"Current LearnSphere learner\\\" and RECENT_LEARNSPHERE_ACTIVITY = \\\"Yes\\\".\",\n      \"expected_path\": \"Hook, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, Future Intent, and close.\"\n    },\n    {\n      \"key\": \"former_inactive_learner\",\n      \"definition\": \"A respondent who previously used LearnSphere but has stopped using it or failed to complete a course.\",\n      \"qualification_rule\": \"LEARNER_STATUS = \\\"Former or inactive LearnSphere learner\\\" and LEARNER_EXPERIENCE_ELIGIBILITY = \\\"Yes\\\".\",\n      \"expected_path\": \"Hook, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, win-back branch, Future Intent, and close.\"\n    },\n    {\n      \"key\": \"potential_user\",\n      \"definition\": \"A respondent with a relevant learning need who does not currently use LearnSphere and has used an alternative learning route.\",\n      \"qualification_rule\": \"LEARNER_STATUS = \\\"Potential digital-learning user\\\" and RELEVANT_LEARNING_NEED = \\\"Yes\\\" and ALTERNATIVE_LEARNING_USE = \\\"Yes\\\".\",\n      \"expected_path\": \"Hook, Usage context, Attitude & Motivation, Competitive, trial branch, Future Intent, and close.\"\n    },\n    {\n      \"key\": \"parent_guardian\",\n      \"definition\": \"A parent or guardian who influences a learner's education decision, payment, safety, or progress monitoring.\",\n      \"qualification_rule\": \"STAKEHOLDER_ROLE includes \\\"Parent or guardian\\\".\",\n      \"expected_path\": \"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close.\"\n    },\n    {\n      \"key\": \"teacher_instructor\",\n      \"definition\": \"A teacher or instructor involved in learning delivery, curriculum, learner support, or progress monitoring.\",\n      \"qualification_rule\": \"STAKEHOLDER_ROLE includes \\\"Teacher or instructor\\\".\",\n      \"expected_path\": \"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close.\"\n    },\n    {\n      \"key\": \"academic_administrator\",\n      \"definition\": \"An academic administrator involved in institutional learning decisions, implementation, monitoring, or partnership evaluation.\",\n      \"qualification_rule\": \"STAKEHOLDER_ROLE includes \\\"Academic administrator\\\".\",\n      \"expected_path\": \"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close.\"\n    }\n  ],\n  \"questionnaire_sections\": [\n    {\n      \"key\": \"hook_warm_up_and_screening\",\n      \"purpose\": \"Establish stakeholder role, LearnSphere relationship, relevant experience, recent activity, and potential-user eligibility. Supports lifecycle segmentation and early screen-out decisions.\",\n      \"question_keys\": [\n        \"STAKEHOLDER_ROLE\",\n        \"LEARNER_STATUS\",\n        \"LEARNER_EXPERIENCE_ELIGIBILITY\",\n        \"RECENT_LEARNSPHERE_ACTIVITY\",\n        \"RELEVANT_LEARNING_NEED\"\n      ]\n    },\n    {\n      \"key\": \"usage_and_behavior\",\n      \"purpose\": \"Measure recent learning behaviour, progress, stopping points, and alternative learning use before asking evaluative questions. Supports engagement, completion, churn, and competitive objectives.\",\n      \"question_keys\": [\n        \"LEARNING_FREQUENCY\",\n        \"COURSE_PROGRESS_STATUS\",\n        \"LEARNING_STOP_POINT\",\n        \"ALTERNATIVE_LEARNING_USE\",\n        \"ALTERNATIVE_PLATFORMS_USED\"\n      ]\n    },\n    {\n      \"key\": \"attitude_and_motivation\",\n      \"purpose\": \"Measure content relevance, instructional-format usage and usefulness, and barriers to engagement. Supports content, format, motivation, and churn objectives.\",\n      \"question_keys\": [\n        \"CONTENT_RELEVANCE\",\n        \"LEARNING_FORMATS_USED\",\n        \"LEARNING_FORMAT_USEFULNESS\",\n        \"ENGAGEMENT_BARRIERS\"\n      ]\n    },\n    {\n      \"key\": \"cx_satisfaction\",\n      \"purpose\": \"Diagnose journey-stage experience, friction, support-feature exposure and value, overall learner experience, and stakeholder-specific success requirements. Supports experience, feature, trust, and expansion-readiness objectives.\",\n      \"question_keys\": [\n        \"JOURNEY_STAGE_EXPERIENCE\",\n        \"LEARNING_FRICTION\",\n        \"SUPPORT_FEATURES_NOTICED\",\n        \"FEEDBACK_AND_PROGRESS_VALUE\",\n        \"LEARNER_EXPERIENCE_SATISFACTION\",\n        \"ROLE_SPECIFIC_SUCCESS_CRITERIA\"\n      ]\n    },\n    {\n      \"key\": \"competitive\",\n      \"purpose\": \"Quantify learning-time allocation across alternatives and capture comparative competitive pressure. Supports competitor, switching, and positioning objectives.\",\n      \"question_keys\": [\n        \"ALTERNATIVE_SHARE_OF_LEARNING_TIME\"\n      ]\n    },\n    {\n      \"key\": \"future_intent\",\n      \"purpose\": \"Capture lifecycle-specific continuation, return, trial, and win-back intent; advocacy; and roadmap prioritisation. Supports retention, acquisition, recommendation, and product-investment objectives.\",\n      \"question_keys\": [\n        \"LIFECYCLE_INTENT_AND_WINBACK\",\n        \"NPS_RECOMMENDATION\",\n        \"IMPROVEMENT_PRIORITY\",\n        \"MOST_IMPORTANT_IMPROVEMENT\"\n      ]\n    }\n  ],\n  \"business_rules\": [\n    {\n      \"id\": \"BR1\",\n      \"plain_english\": \"Ask stakeholder role and LearnSphere relationship before experience questions. Do not collect age, gender, city, residence, NCCS, income, or other database-targeting variables because these are supplied by the audience system.\"\n    },\n    {\n      \"id\": \"BR2\",\n      \"plain_english\": \"Terminate respondents who cannot demonstrate sufficient LearnSphere or comparable digital-learning experience for the path selected.\"\n    },\n    {\n      \"id\": \"BR3\",\n      \"plain_english\": \"Route current learners to the current path, former or inactive learners to the churn and win-back path, and potential users to the trial-barrier path.\"\n    },\n    {\n      \"id\": \"BR4\",\n      \"plain_english\": \"Potential users must report both a relevant learning need and experience with at least one alternative learning route; otherwise terminate.\"\n    },\n    {\n      \"id\": \"BR5\",\n      \"plain_english\": \"Role-specific success criteria must be shown using wording and response options appropriate to the selected stakeholder role. Multi-role respondents may answer the applicable role perspectives, but results must remain separately tagged.\"\n    },\n    {\n      \"id\": \"BR6\",\n      \"plain_english\": \"Only show format usefulness, support-feature value, journey experience, and learner-experience satisfaction to respondents with relevant experience.\"\n    },\n    {\n      \"id\": \"BR7\",\n      \"plain_english\": \"Former or inactive learners receive stopping-point and win-back diagnostics; current learners receive continuation and progress diagnostics; potential users receive trial and proof-point diagnostics.\"\n    },\n    {\n      \"id\": \"BR8\",\n      \"plain_english\": \"Use behavioural and usage measures before attitudes, satisfaction, and intent. Use recency anchors and last-active-stage reconstruction to reduce recall ambiguity.\"\n    },\n    {\n      \"id\": \"BR9\",\n      \"plain_english\": \"Use a shared barrier measure to classify content, time, motivation, navigation, technology, value, trust, and competition causes without adding an unbudgeted diagnostic battery.\"\n    },\n    {\n      \"id\": \"BR10\",\n      \"plain_english\": \"If at least five validated candidate improvements are supplied, show the optional forced-trade-off or MaxDiff task after IMPROVEMENT_PRIORITY; otherwise skip it and do not invent candidate options.\"\n    },\n    {\n      \"id\": \"BR11\",\n      \"plain_english\": \"Embed attention checks, speeder detection, straight-line detection, and open-ended quality checks. Failed quality controls terminate as quality failures, not as ordinary eligibility screen-outs.\"\n    },\n    {\n      \"id\": \"BR12\",\n      \"plain_english\": \"After the final applicable improvement response, complete the respondent.\"\n    }\n  ],\n  \"dynamic_lists\": [\n    {\n      \"id\": \"DL1\",\n      \"source_question_key\": \"ALTERNATIVE_PLATFORMS_USED\",\n      \"target_question_key\": \"ALTERNATIVE_SHARE_OF_LEARNING_TIME\",\n      \"mode\": \"selected\",\n      \"purpose\": \"Carry forward only the learning alternatives selected by the respondent so learning-time allocation is measured across routes actually used.\"\n    },\n    {\n      \"id\": \"DL2\",\n      \"source_question_key\": \"LEARNING_FORMATS_USED\",\n      \"target_question_key\": \"LEARNING_FORMAT_USEFULNESS\",\n      \"mode\": \"selected\",\n      \"purpose\": \"Rate only instructional formats the respondent reports using, avoiding ratings of unfamiliar formats.\"\n    }\n  ],\n  \"branch_blocks\": [\n    {\n      \"id\": \"BB1\",\n      \"source_question_key\": \"LEARNER_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Current LearnSphere learner\",\n          \"member_question_keys\": [\n            \"COURSE_PROGRESS_STATUS\"\n          ]\n        },\n        {\n          \"option_label\": \"Former or inactive LearnSphere learner\",\n          \"member_question_keys\": [\n            \"LEARNING_STOP_POINT\"\n          ]\n        },\n        {\n          \"option_label\": \"Potential digital-learning user\",\n          \"member_question_keys\": [\n            \"ALTERNATIVE_LEARNING_USE\"\n          ]\n        }\n      ],\n      \"rejoin_question_key\": \"ALTERNATIVE_PLATFORMS_USED\"\n    },\n    {\n      \"id\": \"BB2\",\n      \"source_question_key\": \"LEARNER_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Current LearnSphere learner\",\n          \"member_question_keys\": [\n            \"LIFECYCLE_INTENT_AND_WINBACK\"\n          ]\n        },\n        {\n          \"option_label\": \"Former or inactive LearnSphere learner\",\n          \"member_question_keys\": [\n            \"LIFECYCLE_INTENT_AND_WINBACK\"\n          ]\n        },\n        {\n          \"option_label\": \"Potential digital-learning user\",\n          \"member_question_keys\": [\n            \"LIFECYCLE_INTENT_AND_WINBACK\"\n          ]\n        }\n      ],\n      \"rejoin_question_key\": \"NPS_RECOMMENDATION\"\n    }\n  ],\n  \"termination_and_completion_policy\": [\n    {\n      \"condition\": \"Respondent fails the audience-system eligibility requirements or cannot confirm the required Indian adult audience status.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"LEARNER_EXPERIENCE_ELIGIBILITY indicates no sufficient LearnSphere or comparable digital-learning experience.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"A potential user reports no relevant learning need or no alternative learning-route experience.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"An embedded attention, speed, straight-line, or open-ended quality control fails.\",\n      \"outcome\": \"terminate\"\n    },\n    {\n      \"condition\": \"A question does not apply because the respondent has not used the relevant format, feature, platform, or learning route.\",\n      \"outcome\": \"skip\"\n    },\n    {\n      \"condition\": \"The optional MaxDiff or forced-trade-off prerequisite list contains fewer than five validated improvement options.\",\n      \"outcome\": \"skip\"\n    },\n    {\n      \"condition\": \"The respondent completes the final applicable improvement-priority and open-ended improvement responses.\",\n      \"outcome\": \"complete\"\n    }\n  ],\n  \"question_generation_instructions\": [\n    \"METHODOLOGY: Mixed Methodology - Multi-Objective Research Design. Use exactly 25 respondent-facing question keys, a linear modular structure, and a three-phase macro: Hook/screening 15-20%, Core behavioural and diagnostic modules 60-70%, and Close/future intent 15-20%. There are no discrete stimulus cells.\",\n    \"Preserve the section order: Hook and screening, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, and Future Intent/close.\",\n    \"Use behavioural measures before attitudes, satisfaction, and intent. Use recency anchors, last-active-stage reconstruction, friction surfacing, hypothetical win-back framing, and final open-ended improvement capture so at least 25% of flow keys use advanced techniques.\",\n    \"Maintain separate lifecycle and stakeholder analysis for current learners, former/inactive learners, potential users, parents or guardians, teachers/instructors, and academic administrators.\",\n    \"Do not generate age, gender, city, residence, NCCS, income, education, or other database-known targeting questions.\",\n    \"For potential users, measure learning need, alternatives, barriers, proof requirements, and trial intent without asking them to evaluate unexperienced LearnSphere features.\",\n    \"For former learners, use LIFECYCLE_INTENT_AND_WINBACK to capture return likelihood, recoverability, switching cost, and the intervention most likely to bring them back.\",\n    \"For current learners, use LIFECYCLE_INTENT_AND_WINBACK to capture continuation and return intent. For potential users, use it to capture trial intent.\",\n    \"Use dynamic lists only where the target preserves the source option text and order: alternatives to learning-time allocation and used formats to format usefulness.\",\n    \"Use compact, mobile-friendly measures and avoid long agree/disagree grids. Interleave behavioural, rating, forced-choice, and open-ended formats.\",\n    \"Show MaxDiff or Best-Worst Scaling only when a validated list of at least five candidate improvements is supplied; otherwise use the single improvement-priority measure and do not invent options.\",\n    \"Include quality controls at the specified ratio without creating additional questionnaire keys or sections.\"\n  ],\n  \"analysis_tags\": [\n    \"stakeholder_role\",\n    \"learnsphere_relationship\",\n    \"current_vs_former_vs_potential\",\n    \"recent_activity\",\n    \"learning_frequency\",\n    \"course_completion_stage\",\n    \"learning_stop_point\",\n    \"content_relevance\",\n    \"instructional_format_usage\",\n    \"instructional_format_usefulness\",\n    \"journey_stage_friction\",\n    \"technical_friction\",\n    \"navigation_friction\",\n    \"time_scheduling_barrier\",\n    \"motivation_barrier\",\n    \"value_barrier\",\n    \"trust_barrier\",\n    \"competitive_barrier\",\n    \"feedback_usefulness\",\n    \"progress_visibility\",\n    \"adaptive_tool_awareness\",\n    \"adaptive_tool_trust\",\n    \"adaptive_tool_usefulness\",\n    \"social_learning_value\",\n    \"gamification_value\",\n    \"alternative_platform_usage\",\n    \"alternative_share_of_learning_time\",\n    \"switching_cost\",\n    \"winback_potential\",\n    \"continue_intent\",\n    \"return_intent\",\n    \"trial_intent\",\n    \"recommendation_intent\",\n    \"nps\",\n    \"parent_success_criteria\",\n    \"educator_success_criteria\",\n    \"administrator_success_criteria\",\n    \"institutional_readiness\",\n    \"feature_priority\",\n    \"maxdiff_utility\",\n    \"open_end_theme\",\n    \"quality_status\"\n  ],\n  \"assumptions\": [\n    \"The 25-question budget applies across all declared questionnaire sections and includes conditional branch keys only once.\",\n    \"Role-specific stakeholder success criteria are captured through one shared flow key with role-appropriate display and response content.\",\n    \"The final stakeholder routing may permit multiple role tags, but analysis must keep learner, household, educator, and administrator perspectives separate.\",\n    \"Age, India residence, city, gender, NCCS, and quotas are enforced by the audience system and are not recaptured.\",\n    \"The MaxDiff task remains conditional because no validated candidate-improvement list was supplied.\"\n  ],\n  \"ambiguities\": [\n    \"The exact recency window defining current versus former/inactive LearnSphere use is not specified.\",\n    \"The exact option labels for LEARNER_EXPERIENCE_ELIGIBILITY, RELEVANT_LEARNING_NEED, and ALTERNATIVE_LEARNING_USE must be confirmed before scripting termination rules.\",\n    \"The brief describes overlapping stakeholder quotas but does not confirm whether multi-role respondents should answer one primary role module or multiple role perspectives.\",\n    \"The candidate improvement list required for MaxDiff has not been supplied.\"\n  ]\n}","model":"openai.gpt-5.6-luna","sources":[],"data":{"version":"1.0","source":"generated","locked_predefined_design":false,"study_type":"Mixed Methodology - Usage & Attitude, Learner Experience, Churn/Exit, Competitive, and Feature Prioritization","research_design":{"design":"linear","stimulus_count":0,"cells":[],"rotation":"none","justification":"The brief specifies a linear modular questionnaire with role-based routing and no discrete concepts, prototypes, screens, or competing assets. MaxDiff is conditional on receiving at least five defined improvement options and is not a stimulus-cell design."},"business_goal":"Determine which learner-experience, content, motivation, feedback, technology, and journey problems LearnSphere should address first to increase sustained engagement, course completion, return usage, and recommendation. Results will set the next product-release priorities, identify recoverable inactive learners and win-back actions, and determine whether LearnSphere has sufficient evidence and capabilities for certification or institutional-partnership expansion.","questionnaire_intent":"Use a three-phase funnel: concise eligibility and lifecycle screening, a core of behavioural and experience diagnosis, and a closing phase covering stakeholder success criteria, future intent, prioritisation, advocacy, and the final improvement recommendation. Role and lifecycle routing prevents current learners, inactive learners, potential users, parents, educators, and administrators from being combined into misleading scores.","survey_objectives":[{"objective":"Measure recent learning frequency, course progress, completion status, and stopping points among current and former LearnSphere learners to identify where engagement pauses or ends.","importance":"This establishes the behavioural basis for completion and churn analysis rather than relying only on stated satisfaction."},{"objective":"Measure journey-stage experience and friction from discovery and onboarding through course participation, progress tracking, interruption, and resumption.","importance":"LearnSphere needs to identify the precise stages requiring product or process improvement."},{"objective":"Measure content relevance and the usefulness of instructional formats such as videos, quizzes, practice, plans, dashboards, and reminders.","importance":"This distinguishes content and learning-design problems from motivation, time, or technology barriers."},{"objective":"Measure primary and secondary engagement barriers, including content, time, motivation, navigation, technology, value, trust, and competition barriers.","importance":"Barrier segmentation is needed to match users with appropriate product fixes, content changes, or interventions."},{"objective":"Measure awareness and perceived value of AI recommendations, adaptive learning, feedback, reminders, progress visibility, social learning, and gamification among respondents with relevant exposure.","importance":"The business must distinguish feature awareness from trusted, useful mechanisms that create genuine learning momentum."},{"objective":"Measure usage of competing platforms, offline alternatives, creator-led content, coaching, institutional systems, and peer-learning routes, including their share of learning time.","importance":"This reveals where learning time is diverted and where competitive switching pressure originates."},{"objective":"Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups.","importance":"These indicators quantify retention, acquisition, recoverability, and advocacy potential."},{"objective":"Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators.","importance":"These requirements inform household adoption, educator use, institutional readiness, and partnership decisions."},{"objective":"Prioritise the improvement area most likely to increase engagement, completion, return usage, and recommendation, with a conditional forced-trade-off or MaxDiff exercise if a validated feature list is supplied.","importance":"LearnSphere needs a practical roadmap signal instead of an undifferentiated list of highly rated improvements."},{"objective":"Measure likelihood to recommend and the most important improvement respondents want LearnSphere to make.","importance":"Advocacy and an open-ended recommendation provide a benchmark and reveal unmet needs not captured in predefined categories."}],"targeted_insights":[{"insight":"Identify which content, journey, feedback, progress-visibility, and friction factors are most associated with sustained learning and completion.","linked_objectives":["Measure recent learning frequency, course progress, completion status, and stopping points among current and former LearnSphere learners to identify where engagement pauses or ends.","Measure journey-stage experience and friction from discovery and onboarding through course participation, progress tracking, interruption, and resumption.","Measure content relevance and the usefulness of instructional formats such as videos, quizzes, practice, plans, dashboards, and reminders."],"decision_impact":"Set product and learning-design priorities most likely to improve sustained progress and completion."},{"insight":"Segment inactivity into content-led, time-led, motivation-led, technology-led, navigation-led, value-led, trust-led, and competition-led profiles.","linked_objectives":["Measure primary and secondary engagement barriers, including content, time, motivation, navigation, technology, value, trust, and competition barriers.","Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups."],"decision_impact":"Match each segment to an appropriate product fix, content intervention, reminder, offer, or win-back campaign."},{"insight":"Determine whether personalised tools and engagement mechanisms create momentum only when learners notice, understand, trust, and value them.","linked_objectives":["Measure awareness and perceived value of AI recommendations, adaptive learning, feedback, reminders, progress visibility, social learning, and gamification among respondents with relevant exposure."],"decision_impact":"Decide whether to improve capability, explainability, onboarding, visibility, trust messaging, social features, or gamification."},{"insight":"Map the alternatives competing for learning time and identify the routes most associated with switching or non-completion.","linked_objectives":["Measure usage of competing platforms, offline alternatives, creator-led content, coaching, institutional systems, and peer-learning routes, including their share of learning time."],"decision_impact":"Refine positioning, differentiation, retention strategy, and competitive response."},{"insight":"Compare continuation, return, trial, recommendation, and success criteria across current learners, former learners, potential users, parents, educators, and administrators.","linked_objectives":["Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups.","Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators."],"decision_impact":"Create separate learner, household, acquisition, educator, and institutional strategies rather than relying on one blended score."},{"insight":"Produce a prioritised improvement roadmap and identify unmet needs that predefined measures do not capture.","linked_objectives":["Prioritise the improvement area most likely to increase engagement, completion, return usage, and recommendation, with a conditional forced-trade-off or MaxDiff exercise if a validated feature list is supplied.","Measure likelihood to recommend and the most important improvement respondents want LearnSphere to make."],"decision_impact":"Allocate next-release investment toward improvements with the strongest stated or relative value."},{"insight":"Identify the evidence gaps that must be addressed before certification or institutional-partnership expansion.","linked_objectives":["Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators."],"decision_impact":"Decide whether to proceed with expansion or first invest in outcomes evidence, safety, monitoring, reporting, implementation, and institutional support."}],"respondent_segments":[{"key":"current_learner","definition":"A respondent who currently uses LearnSphere and reports recent platform activity.","qualification_rule":"LEARNER_STATUS = \"Current LearnSphere learner\" and RECENT_LEARNSPHERE_ACTIVITY = \"Yes\".","expected_path":"Hook, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, Future Intent, and close."},{"key":"former_inactive_learner","definition":"A respondent who previously used LearnSphere but has stopped using it or failed to complete a course.","qualification_rule":"LEARNER_STATUS = \"Former or inactive LearnSphere learner\" and LEARNER_EXPERIENCE_ELIGIBILITY = \"Yes\".","expected_path":"Hook, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, win-back branch, Future Intent, and close."},{"key":"potential_user","definition":"A respondent with a relevant learning need who does not currently use LearnSphere and has used an alternative learning route.","qualification_rule":"LEARNER_STATUS = \"Potential digital-learning user\" and RELEVANT_LEARNING_NEED = \"Yes\" and ALTERNATIVE_LEARNING_USE = \"Yes\".","expected_path":"Hook, Usage context, Attitude & Motivation, Competitive, trial branch, Future Intent, and close."},{"key":"parent_guardian","definition":"A parent or guardian who influences a learner's education decision, payment, safety, or progress monitoring.","qualification_rule":"STAKEHOLDER_ROLE includes \"Parent or guardian\".","expected_path":"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close."},{"key":"teacher_instructor","definition":"A teacher or instructor involved in learning delivery, curriculum, learner support, or progress monitoring.","qualification_rule":"STAKEHOLDER_ROLE includes \"Teacher or instructor\".","expected_path":"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close."},{"key":"academic_administrator","definition":"An academic administrator involved in institutional learning decisions, implementation, monitoring, or partnership evaluation.","qualification_rule":"STAKEHOLDER_ROLE includes \"Academic administrator\".","expected_path":"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close."}],"questionnaire_sections":[{"key":"hook_warm_up_and_screening","purpose":"Establish stakeholder role, LearnSphere relationship, relevant experience, recent activity, and potential-user eligibility. Supports lifecycle segmentation and early screen-out decisions.","question_keys":["STAKEHOLDER_ROLE","LEARNER_STATUS","LEARNER_EXPERIENCE_ELIGIBILITY","RECENT_LEARNSPHERE_ACTIVITY","RELEVANT_LEARNING_NEED"]},{"key":"usage_and_behavior","purpose":"Measure recent learning behaviour, progress, stopping points, and alternative learning use before asking evaluative questions. Supports engagement, completion, churn, and competitive objectives.","question_keys":["LEARNING_FREQUENCY","COURSE_PROGRESS_STATUS","LEARNING_STOP_POINT","ALTERNATIVE_LEARNING_USE","ALTERNATIVE_PLATFORMS_USED"]},{"key":"attitude_and_motivation","purpose":"Measure content relevance, instructional-format usage and usefulness, and barriers to engagement. Supports content, format, motivation, and churn objectives.","question_keys":["CONTENT_RELEVANCE","LEARNING_FORMATS_USED","LEARNING_FORMAT_USEFULNESS","ENGAGEMENT_BARRIERS"]},{"key":"cx_satisfaction","purpose":"Diagnose journey-stage experience, friction, support-feature exposure and value, overall learner experience, and stakeholder-specific success requirements. Supports experience, feature, trust, and expansion-readiness objectives.","question_keys":["JOURNEY_STAGE_EXPERIENCE","LEARNING_FRICTION","SUPPORT_FEATURES_NOTICED","FEEDBACK_AND_PROGRESS_VALUE","LEARNER_EXPERIENCE_SATISFACTION","ROLE_SPECIFIC_SUCCESS_CRITERIA"]},{"key":"competitive","purpose":"Quantify learning-time allocation across alternatives and capture comparative competitive pressure. Supports competitor, switching, and positioning objectives.","question_keys":["ALTERNATIVE_SHARE_OF_LEARNING_TIME"]},{"key":"future_intent","purpose":"Capture lifecycle-specific continuation, return, trial, and win-back intent; advocacy; and roadmap prioritisation. Supports retention, acquisition, recommendation, and product-investment objectives.","question_keys":["LIFECYCLE_INTENT_AND_WINBACK","NPS_RECOMMENDATION","IMPROVEMENT_PRIORITY","MOST_IMPORTANT_IMPROVEMENT"]}],"business_rules":[{"id":"BR1","plain_english":"Ask stakeholder role and LearnSphere relationship before experience questions. Do not collect age, gender, city, residence, NCCS, income, or other database-targeting variables because these are supplied by the audience system."},{"id":"BR2","plain_english":"Terminate respondents who cannot demonstrate sufficient LearnSphere or comparable digital-learning experience for the path selected."},{"id":"BR3","plain_english":"Route current learners to the current path, former or inactive learners to the churn and win-back path, and potential users to the trial-barrier path."},{"id":"BR4","plain_english":"Potential users must report both a relevant learning need and experience with at least one alternative learning route; otherwise terminate."},{"id":"BR5","plain_english":"Role-specific success criteria must be shown using wording and response options appropriate to the selected stakeholder role. Multi-role respondents may answer the applicable role perspectives, but results must remain separately tagged."},{"id":"BR6","plain_english":"Only show format usefulness, support-feature value, journey experience, and learner-experience satisfaction to respondents with relevant experience."},{"id":"BR7","plain_english":"Former or inactive learners receive stopping-point and win-back diagnostics; current learners receive continuation and progress diagnostics; potential users receive trial and proof-point diagnostics."},{"id":"BR8","plain_english":"Use behavioural and usage measures before attitudes, satisfaction, and intent. Use recency anchors and last-active-stage reconstruction to reduce recall ambiguity."},{"id":"BR9","plain_english":"Use a shared barrier measure to classify content, time, motivation, navigation, technology, value, trust, and competition causes without adding an unbudgeted diagnostic battery."},{"id":"BR10","plain_english":"If at least five validated candidate improvements are supplied, show the optional forced-trade-off or MaxDiff task after IMPROVEMENT_PRIORITY; otherwise skip it and do not invent candidate options."},{"id":"BR11","plain_english":"Embed attention checks, speeder detection, straight-line detection, and open-ended quality checks. Failed quality controls terminate as quality failures, not as ordinary eligibility screen-outs."},{"id":"BR12","plain_english":"After the final applicable improvement response, complete the respondent."}],"dynamic_lists":[{"id":"DL1","source_question_key":"ALTERNATIVE_PLATFORMS_USED","target_question_key":"ALTERNATIVE_SHARE_OF_LEARNING_TIME","mode":"selected","purpose":"Carry forward only the learning alternatives selected by the respondent so learning-time allocation is measured across routes actually used."},{"id":"DL2","source_question_key":"LEARNING_FORMATS_USED","target_question_key":"LEARNING_FORMAT_USEFULNESS","mode":"selected","purpose":"Rate only instructional formats the respondent reports using, avoiding ratings of unfamiliar formats."}],"branch_blocks":[{"id":"BB1","source_question_key":"LEARNER_STATUS","selection_mode":"single","blocks":[{"option_label":"Current LearnSphere learner","member_question_keys":["COURSE_PROGRESS_STATUS"]},{"option_label":"Former or inactive LearnSphere learner","member_question_keys":["LEARNING_STOP_POINT"]},{"option_label":"Potential digital-learning user","member_question_keys":["ALTERNATIVE_LEARNING_USE"]}],"rejoin_question_key":"ALTERNATIVE_PLATFORMS_USED"},{"id":"BB2","source_question_key":"LEARNER_STATUS","selection_mode":"single","blocks":[{"option_label":"Current LearnSphere learner","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]},{"option_label":"Former or inactive LearnSphere learner","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]},{"option_label":"Potential digital-learning user","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]}],"rejoin_question_key":"NPS_RECOMMENDATION"}],"termination_and_completion_policy":[{"condition":"Respondent fails the audience-system eligibility requirements or cannot confirm the required Indian adult audience status.","outcome":"terminate"},{"condition":"LEARNER_EXPERIENCE_ELIGIBILITY indicates no sufficient LearnSphere or comparable digital-learning experience.","outcome":"terminate"},{"condition":"A potential user reports no relevant learning need or no alternative learning-route experience.","outcome":"terminate"},{"condition":"An embedded attention, speed, straight-line, or open-ended quality control fails.","outcome":"terminate"},{"condition":"A question does not apply because the respondent has not used the relevant format, feature, platform, or learning route.","outcome":"skip"},{"condition":"The optional MaxDiff or forced-trade-off prerequisite list contains fewer than five validated improvement options.","outcome":"skip"},{"condition":"The respondent completes the final applicable improvement-priority and open-ended improvement responses.","outcome":"complete"}],"question_generation_instructions":["METHODOLOGY: Mixed Methodology - Multi-Objective Research Design. Use exactly 25 respondent-facing question keys, a linear modular structure, and a three-phase macro: Hook/screening 15-20%, Core behavioural and diagnostic modules 60-70%, and Close/future intent 15-20%. There are no discrete stimulus cells.","Preserve the section order: Hook and screening, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, and Future Intent/close.","Use behavioural measures before attitudes, satisfaction, and intent. Use recency anchors, last-active-stage reconstruction, friction surfacing, hypothetical win-back framing, and final open-ended improvement capture so at least 25% of flow keys use advanced techniques.","Maintain separate lifecycle and stakeholder analysis for current learners, former/inactive learners, potential users, parents or guardians, teachers/instructors, and academic administrators.","Do not generate age, gender, city, residence, NCCS, income, education, or other database-known targeting questions.","For potential users, measure learning need, alternatives, barriers, proof requirements, and trial intent without asking them to evaluate unexperienced LearnSphere features.","For former learners, use LIFECYCLE_INTENT_AND_WINBACK to capture return likelihood, recoverability, switching cost, and the intervention most likely to bring them back.","For current learners, use LIFECYCLE_INTENT_AND_WINBACK to capture continuation and return intent. For potential users, use it to capture trial intent.","Use dynamic lists only where the target preserves the source option text and order: alternatives to learning-time allocation and used formats to format usefulness.","Use compact, mobile-friendly measures and avoid long agree/disagree grids. Interleave behavioural, rating, forced-choice, and open-ended formats.","Show MaxDiff or Best-Worst Scaling only when a validated list of at least five candidate improvements is supplied; otherwise use the single improvement-priority measure and do not invent options.","Include quality controls at the specified ratio without creating additional questionnaire keys or sections."],"analysis_tags":["stakeholder_role","learnsphere_relationship","current_vs_former_vs_potential","recent_activity","learning_frequency","course_completion_stage","learning_stop_point","content_relevance","instructional_format_usage","instructional_format_usefulness","journey_stage_friction","technical_friction","navigation_friction","time_scheduling_barrier","motivation_barrier","value_barrier","trust_barrier","competitive_barrier","feedback_usefulness","progress_visibility","adaptive_tool_awareness","adaptive_tool_trust","adaptive_tool_usefulness","social_learning_value","gamification_value","alternative_platform_usage","alternative_share_of_learning_time","switching_cost","winback_potential","continue_intent","return_intent","trial_intent","recommendation_intent","nps","parent_success_criteria","educator_success_criteria","administrator_success_criteria","institutional_readiness","feature_priority","maxdiff_utility","open_end_theme","quality_status"],"assumptions":["The 25-question budget applies across all declared questionnaire sections and includes conditional branch keys only once.","Role-specific stakeholder success criteria are captured through one shared flow key with role-appropriate display and response content.","The final stakeholder routing may permit multiple role tags, but analysis must keep learner, household, educator, and administrator perspectives separate.","Age, India residence, city, gender, NCCS, and quotas are enforced by the audience system and are not recaptured.","The MaxDiff task remains conditional because no validated candidate-improvement list was supplied."],"ambiguities":["The exact recency window defining current versus former/inactive LearnSphere use is not specified.","The exact option labels for LEARNER_EXPERIENCE_ELIGIBILITY, RELEVANT_LEARNING_NEED, and ALTERNATIVE_LEARNING_USE must be confirmed before scripting termination rules.","The brief describes overlapping stakeholder quotas but does not confirm whether multi-role respondents should answer one primary role module or multiple role perspectives.","The candidate improvement list required for MaxDiff has not been supplied."]},"version":"1.0","source":"generated","locked_predefined_design":false,"study_type":"Mixed Methodology - Usage & Attitude, Learner Experience, Churn/Exit, Competitive, and Feature Prioritization","research_design":{"design":"linear","stimulus_count":0,"cells":[],"rotation":"none","justification":"The brief specifies a linear modular questionnaire with role-based routing and no discrete concepts, prototypes, screens, or competing assets. MaxDiff is conditional on receiving at least five defined improvement options and is not a stimulus-cell design."},"business_goal":"Determine which learner-experience, content, motivation, feedback, technology, and journey problems LearnSphere should address first to increase sustained engagement, course completion, return usage, and recommendation. Results will set the next product-release priorities, identify recoverable inactive learners and win-back actions, and determine whether LearnSphere has sufficient evidence and capabilities for certification or institutional-partnership expansion.","questionnaire_intent":"Use a three-phase funnel: concise eligibility and lifecycle screening, a core of behavioural and experience diagnosis, and a closing phase covering stakeholder success criteria, future intent, prioritisation, advocacy, and the final improvement recommendation. Role and lifecycle routing prevents current learners, inactive learners, potential users, parents, educators, and administrators from being combined into misleading scores.","survey_objectives":[{"objective":"Measure recent learning frequency, course progress, completion status, and stopping points among current and former LearnSphere learners to identify where engagement pauses or ends.","importance":"This establishes the behavioural basis for completion and churn analysis rather than relying only on stated satisfaction."},{"objective":"Measure journey-stage experience and friction from discovery and onboarding through course participation, progress tracking, interruption, and resumption.","importance":"LearnSphere needs to identify the precise stages requiring product or process improvement."},{"objective":"Measure content relevance and the usefulness of instructional formats such as videos, quizzes, practice, plans, dashboards, and reminders.","importance":"This distinguishes content and learning-design problems from motivation, time, or technology barriers."},{"objective":"Measure primary and secondary engagement barriers, including content, time, motivation, navigation, technology, value, trust, and competition barriers.","importance":"Barrier segmentation is needed to match users with appropriate product fixes, content changes, or interventions."},{"objective":"Measure awareness and perceived value of AI recommendations, adaptive learning, feedback, reminders, progress visibility, social learning, and gamification among respondents with relevant exposure.","importance":"The business must distinguish feature awareness from trusted, useful mechanisms that create genuine learning momentum."},{"objective":"Measure usage of competing platforms, offline alternatives, creator-led content, coaching, institutional systems, and peer-learning routes, including their share of learning time.","importance":"This reveals where learning time is diverted and where competitive switching pressure originates."},{"objective":"Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups.","importance":"These indicators quantify retention, acquisition, recoverability, and advocacy potential."},{"objective":"Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators.","importance":"These requirements inform household adoption, educator use, institutional readiness, and partnership decisions."},{"objective":"Prioritise the improvement area most likely to increase engagement, completion, return usage, and recommendation, with a conditional forced-trade-off or MaxDiff exercise if a validated feature list is supplied.","importance":"LearnSphere needs a practical roadmap signal instead of an undifferentiated list of highly rated improvements."},{"objective":"Measure likelihood to recommend and the most important improvement respondents want LearnSphere to make.","importance":"Advocacy and an open-ended recommendation provide a benchmark and reveal unmet needs not captured in predefined categories."}],"targeted_insights":[{"insight":"Identify which content, journey, feedback, progress-visibility, and friction factors are most associated with sustained learning and completion.","linked_objectives":["Measure recent learning frequency, course progress, completion status, and stopping points among current and former LearnSphere learners to identify where engagement pauses or ends.","Measure journey-stage experience and friction from discovery and onboarding through course participation, progress tracking, interruption, and resumption.","Measure content relevance and the usefulness of instructional formats such as videos, quizzes, practice, plans, dashboards, and reminders."],"decision_impact":"Set product and learning-design priorities most likely to improve sustained progress and completion."},{"insight":"Segment inactivity into content-led, time-led, motivation-led, technology-led, navigation-led, value-led, trust-led, and competition-led profiles.","linked_objectives":["Measure primary and secondary engagement barriers, including content, time, motivation, navigation, technology, value, trust, and competition barriers.","Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups."],"decision_impact":"Match each segment to an appropriate product fix, content intervention, reminder, offer, or win-back campaign."},{"insight":"Determine whether personalised tools and engagement mechanisms create momentum only when learners notice, understand, trust, and value them.","linked_objectives":["Measure awareness and perceived value of AI recommendations, adaptive learning, feedback, reminders, progress visibility, social learning, and gamification among respondents with relevant exposure."],"decision_impact":"Decide whether to improve capability, explainability, onboarding, visibility, trust messaging, social features, or gamification."},{"insight":"Map the alternatives competing for learning time and identify the routes most associated with switching or non-completion.","linked_objectives":["Measure usage of competing platforms, offline alternatives, creator-led content, coaching, institutional systems, and peer-learning routes, including their share of learning time."],"decision_impact":"Refine positioning, differentiation, retention strategy, and competitive response."},{"insight":"Compare continuation, return, trial, recommendation, and success criteria across current learners, former learners, potential users, parents, educators, and administrators.","linked_objectives":["Measure continuation, return, trial, win-back, and recommendation intent across relevant lifecycle and stakeholder groups.","Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators."],"decision_impact":"Create separate learner, household, acquisition, educator, and institutional strategies rather than relying on one blended score."},{"insight":"Produce a prioritised improvement roadmap and identify unmet needs that predefined measures do not capture.","linked_objectives":["Prioritise the improvement area most likely to increase engagement, completion, return usage, and recommendation, with a conditional forced-trade-off or MaxDiff exercise if a validated feature list is supplied.","Measure likelihood to recommend and the most important improvement respondents want LearnSphere to make."],"decision_impact":"Allocate next-release investment toward improvements with the strongest stated or relative value."},{"insight":"Identify the evidence gaps that must be addressed before certification or institutional-partnership expansion.","linked_objectives":["Measure role-specific success criteria and evidence requirements among parents or guardians, teachers or instructors, and academic administrators."],"decision_impact":"Decide whether to proceed with expansion or first invest in outcomes evidence, safety, monitoring, reporting, implementation, and institutional support."}],"respondent_segments":[{"key":"current_learner","definition":"A respondent who currently uses LearnSphere and reports recent platform activity.","qualification_rule":"LEARNER_STATUS = \"Current LearnSphere learner\" and RECENT_LEARNSPHERE_ACTIVITY = \"Yes\".","expected_path":"Hook, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, Future Intent, and close."},{"key":"former_inactive_learner","definition":"A respondent who previously used LearnSphere but has stopped using it or failed to complete a course.","qualification_rule":"LEARNER_STATUS = \"Former or inactive LearnSphere learner\" and LEARNER_EXPERIENCE_ELIGIBILITY = \"Yes\".","expected_path":"Hook, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, win-back branch, Future Intent, and close."},{"key":"potential_user","definition":"A respondent with a relevant learning need who does not currently use LearnSphere and has used an alternative learning route.","qualification_rule":"LEARNER_STATUS = \"Potential digital-learning user\" and RELEVANT_LEARNING_NEED = \"Yes\" and ALTERNATIVE_LEARNING_USE = \"Yes\".","expected_path":"Hook, Usage context, Attitude & Motivation, Competitive, trial branch, Future Intent, and close."},{"key":"parent_guardian","definition":"A parent or guardian who influences a learner's education decision, payment, safety, or progress monitoring.","qualification_rule":"STAKEHOLDER_ROLE includes \"Parent or guardian\".","expected_path":"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close."},{"key":"teacher_instructor","definition":"A teacher or instructor involved in learning delivery, curriculum, learner support, or progress monitoring.","qualification_rule":"STAKEHOLDER_ROLE includes \"Teacher or instructor\".","expected_path":"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close."},{"key":"academic_administrator","definition":"An academic administrator involved in institutional learning decisions, implementation, monitoring, or partnership evaluation.","qualification_rule":"STAKEHOLDER_ROLE includes \"Academic administrator\".","expected_path":"Hook, applicable Usage context, role-specific success criteria, Future Intent, and close."}],"questionnaire_sections":[{"key":"hook_warm_up_and_screening","purpose":"Establish stakeholder role, LearnSphere relationship, relevant experience, recent activity, and potential-user eligibility. Supports lifecycle segmentation and early screen-out decisions.","question_keys":["STAKEHOLDER_ROLE","LEARNER_STATUS","LEARNER_EXPERIENCE_ELIGIBILITY","RECENT_LEARNSPHERE_ACTIVITY","RELEVANT_LEARNING_NEED"]},{"key":"usage_and_behavior","purpose":"Measure recent learning behaviour, progress, stopping points, and alternative learning use before asking evaluative questions. Supports engagement, completion, churn, and competitive objectives.","question_keys":["LEARNING_FREQUENCY","COURSE_PROGRESS_STATUS","LEARNING_STOP_POINT","ALTERNATIVE_LEARNING_USE","ALTERNATIVE_PLATFORMS_USED"]},{"key":"attitude_and_motivation","purpose":"Measure content relevance, instructional-format usage and usefulness, and barriers to engagement. Supports content, format, motivation, and churn objectives.","question_keys":["CONTENT_RELEVANCE","LEARNING_FORMATS_USED","LEARNING_FORMAT_USEFULNESS","ENGAGEMENT_BARRIERS"]},{"key":"cx_satisfaction","purpose":"Diagnose journey-stage experience, friction, support-feature exposure and value, overall learner experience, and stakeholder-specific success requirements. Supports experience, feature, trust, and expansion-readiness objectives.","question_keys":["JOURNEY_STAGE_EXPERIENCE","LEARNING_FRICTION","SUPPORT_FEATURES_NOTICED","FEEDBACK_AND_PROGRESS_VALUE","LEARNER_EXPERIENCE_SATISFACTION","ROLE_SPECIFIC_SUCCESS_CRITERIA"]},{"key":"competitive","purpose":"Quantify learning-time allocation across alternatives and capture comparative competitive pressure. Supports competitor, switching, and positioning objectives.","question_keys":["ALTERNATIVE_SHARE_OF_LEARNING_TIME"]},{"key":"future_intent","purpose":"Capture lifecycle-specific continuation, return, trial, and win-back intent; advocacy; and roadmap prioritisation. Supports retention, acquisition, recommendation, and product-investment objectives.","question_keys":["LIFECYCLE_INTENT_AND_WINBACK","NPS_RECOMMENDATION","IMPROVEMENT_PRIORITY","MOST_IMPORTANT_IMPROVEMENT"]}],"business_rules":[{"id":"BR1","plain_english":"Ask stakeholder role and LearnSphere relationship before experience questions. Do not collect age, gender, city, residence, NCCS, income, or other database-targeting variables because these are supplied by the audience system."},{"id":"BR2","plain_english":"Terminate respondents who cannot demonstrate sufficient LearnSphere or comparable digital-learning experience for the path selected."},{"id":"BR3","plain_english":"Route current learners to the current path, former or inactive learners to the churn and win-back path, and potential users to the trial-barrier path."},{"id":"BR4","plain_english":"Potential users must report both a relevant learning need and experience with at least one alternative learning route; otherwise terminate."},{"id":"BR5","plain_english":"Role-specific success criteria must be shown using wording and response options appropriate to the selected stakeholder role. Multi-role respondents may answer the applicable role perspectives, but results must remain separately tagged."},{"id":"BR6","plain_english":"Only show format usefulness, support-feature value, journey experience, and learner-experience satisfaction to respondents with relevant experience."},{"id":"BR7","plain_english":"Former or inactive learners receive stopping-point and win-back diagnostics; current learners receive continuation and progress diagnostics; potential users receive trial and proof-point diagnostics."},{"id":"BR8","plain_english":"Use behavioural and usage measures before attitudes, satisfaction, and intent. Use recency anchors and last-active-stage reconstruction to reduce recall ambiguity."},{"id":"BR9","plain_english":"Use a shared barrier measure to classify content, time, motivation, navigation, technology, value, trust, and competition causes without adding an unbudgeted diagnostic battery."},{"id":"BR10","plain_english":"If at least five validated candidate improvements are supplied, show the optional forced-trade-off or MaxDiff task after IMPROVEMENT_PRIORITY; otherwise skip it and do not invent candidate options."},{"id":"BR11","plain_english":"Embed attention checks, speeder detection, straight-line detection, and open-ended quality checks. Failed quality controls terminate as quality failures, not as ordinary eligibility screen-outs."},{"id":"BR12","plain_english":"After the final applicable improvement response, complete the respondent."}],"dynamic_lists":[{"id":"DL1","source_question_key":"ALTERNATIVE_PLATFORMS_USED","target_question_key":"ALTERNATIVE_SHARE_OF_LEARNING_TIME","mode":"selected","purpose":"Carry forward only the learning alternatives selected by the respondent so learning-time allocation is measured across routes actually used."},{"id":"DL2","source_question_key":"LEARNING_FORMATS_USED","target_question_key":"LEARNING_FORMAT_USEFULNESS","mode":"selected","purpose":"Rate only instructional formats the respondent reports using, avoiding ratings of unfamiliar formats."}],"branch_blocks":[{"id":"BB1","source_question_key":"LEARNER_STATUS","selection_mode":"single","blocks":[{"option_label":"Current LearnSphere learner","member_question_keys":["COURSE_PROGRESS_STATUS"]},{"option_label":"Former or inactive LearnSphere learner","member_question_keys":["LEARNING_STOP_POINT"]},{"option_label":"Potential digital-learning user","member_question_keys":["ALTERNATIVE_LEARNING_USE"]}],"rejoin_question_key":"ALTERNATIVE_PLATFORMS_USED"},{"id":"BB2","source_question_key":"LEARNER_STATUS","selection_mode":"single","blocks":[{"option_label":"Current LearnSphere learner","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]},{"option_label":"Former or inactive LearnSphere learner","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]},{"option_label":"Potential digital-learning user","member_question_keys":["LIFECYCLE_INTENT_AND_WINBACK"]}],"rejoin_question_key":"NPS_RECOMMENDATION"}],"termination_and_completion_policy":[{"condition":"Respondent fails the audience-system eligibility requirements or cannot confirm the required Indian adult audience status.","outcome":"terminate"},{"condition":"LEARNER_EXPERIENCE_ELIGIBILITY indicates no sufficient LearnSphere or comparable digital-learning experience.","outcome":"terminate"},{"condition":"A potential user reports no relevant learning need or no alternative learning-route experience.","outcome":"terminate"},{"condition":"An embedded attention, speed, straight-line, or open-ended quality control fails.","outcome":"terminate"},{"condition":"A question does not apply because the respondent has not used the relevant format, feature, platform, or learning route.","outcome":"skip"},{"condition":"The optional MaxDiff or forced-trade-off prerequisite list contains fewer than five validated improvement options.","outcome":"skip"},{"condition":"The respondent completes the final applicable improvement-priority and open-ended improvement responses.","outcome":"complete"}],"question_generation_instructions":["METHODOLOGY: Mixed Methodology - Multi-Objective Research Design. Use exactly 25 respondent-facing question keys, a linear modular structure, and a three-phase macro: Hook/screening 15-20%, Core behavioural and diagnostic modules 60-70%, and Close/future intent 15-20%. There are no discrete stimulus cells.","Preserve the section order: Hook and screening, Usage & Behavior, Attitude & Motivation, CX/Satisfaction, Competitive, and Future Intent/close.","Use behavioural measures before attitudes, satisfaction, and intent. Use recency anchors, last-active-stage reconstruction, friction surfacing, hypothetical win-back framing, and final open-ended improvement capture so at least 25% of flow keys use advanced techniques.","Maintain separate lifecycle and stakeholder analysis for current learners, former/inactive learners, potential users, parents or guardians, teachers/instructors, and academic administrators.","Do not generate age, gender, city, residence, NCCS, income, education, or other database-known targeting questions.","For potential users, measure learning need, alternatives, barriers, proof requirements, and trial intent without asking them to evaluate unexperienced LearnSphere features.","For former learners, use LIFECYCLE_INTENT_AND_WINBACK to capture return likelihood, recoverability, switching cost, and the intervention most likely to bring them back.","For current learners, use LIFECYCLE_INTENT_AND_WINBACK to capture continuation and return intent. For potential users, use it to capture trial intent.","Use dynamic lists only where the target preserves the source option text and order: alternatives to learning-time allocation and used formats to format usefulness.","Use compact, mobile-friendly measures and avoid long agree/disagree grids. Interleave behavioural, rating, forced-choice, and open-ended formats.","Show MaxDiff or Best-Worst Scaling only when a validated list of at least five candidate improvements is supplied; otherwise use the single improvement-priority measure and do not invent options.","Include quality controls at the specified ratio without creating additional questionnaire keys or sections."],"analysis_tags":["stakeholder_role","learnsphere_relationship","current_vs_former_vs_potential","recent_activity","learning_frequency","course_completion_stage","learning_stop_point","content_relevance","instructional_format_usage","instructional_format_usefulness","journey_stage_friction","technical_friction","navigation_friction","time_scheduling_barrier","motivation_barrier","value_barrier","trust_barrier","competitive_barrier","feedback_usefulness","progress_visibility","adaptive_tool_awareness","adaptive_tool_trust","adaptive_tool_usefulness","social_learning_value","gamification_value","alternative_platform_usage","alternative_share_of_learning_time","switching_cost","winback_potential","continue_intent","return_intent","trial_intent","recommendation_intent","nps","parent_success_criteria","educator_success_criteria","administrator_success_criteria","institutional_readiness","feature_priority","maxdiff_utility","open_end_theme","quality_status"],"assumptions":["The 25-question budget applies across all declared questionnaire sections and includes conditional branch keys only once.","Role-specific stakeholder success criteria are captured through one shared flow key with role-appropriate display and response content.","The final stakeholder routing may permit multiple role tags, but analysis must keep learner, household, educator, and administrator perspectives separate.","Age, India residence, city, gender, NCCS, and quotas are enforced by the audience system and are not recaptured.","The MaxDiff task remains conditional because no validated candidate-improvement list was supplied."],"ambiguities":["The exact recency window defining current versus former/inactive LearnSphere use is not specified.","The exact option labels for LEARNER_EXPERIENCE_ELIGIBILITY, RELEVANT_LEARNING_NEED, and ALTERNATIVE_LEARNING_USE must be confirmed before scripting termination rules.","The brief describes overlapping stakeholder quotas but does not confirm whether multi-role respondents should answer one primary role module or multiple role perspectives.","The candidate improvement list required for MaxDiff has not been supplied."]},"routing_logic":{"text":"{\n  \"version\": \"1.0\",\n  \"source_business_flow_version\": \"1.0\",\n  \"question_keys\": [\n    {\n      \"key\": \"STAKEHOLDER_ROLE\",\n      \"expected_role\": \"screener\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNER_STATUS\",\n      \"expected_role\": \"segment_classifier\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNER_EXPERIENCE_ELIGIBILITY\",\n      \"expected_role\": \"screener\",\n      \"required\": true\n    },\n    {\n      \"key\": \"RECENT_LEARNSPHERE_ACTIVITY\",\n      \"expected_role\": \"screener\",\n      \"required\": true\n    },\n    {\n      \"key\": \"RELEVANT_LEARNING_NEED\",\n      \"expected_role\": \"screener\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNING_FREQUENCY\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"COURSE_PROGRESS_STATUS\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNING_STOP_POINT\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"ALTERNATIVE_LEARNING_USE\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"ALTERNATIVE_PLATFORMS_USED\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"CONTENT_RELEVANCE\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNING_FORMATS_USED\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNING_FORMAT_USEFULNESS\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"ENGAGEMENT_BARRIERS\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"JOURNEY_STAGE_EXPERIENCE\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNING_FRICTION\",\n      \"expected_role\": \"dynamic_source\",\n      \"required\": true\n    },\n    {\n      \"key\": \"SUPPORT_FEATURES_NOTICED\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"FEEDBACK_AND_PROGRESS_VALUE\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LEARNER_EXPERIENCE_SATISFACTION\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"ROLE_SPECIFIC_SUCCESS_CRITERIA\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"ALTERNATIVE_SHARE_OF_LEARNING_TIME\",\n      \"expected_role\": \"rejoin\",\n      \"required\": true\n    },\n    {\n      \"key\": \"LIFECYCLE_INTENT_AND_WINBACK\",\n      \"expected_role\": \"branch_followup\",\n      \"required\": true\n    },\n    {\n      \"key\": \"NPS_RECOMMENDATION\",\n      \"expected_role\": \"close\",\n      \"required\": true\n    },\n    {\n      \"key\": \"IMPROVEMENT_PRIORITY\",\n      \"expected_role\": \"close\",\n      \"required\": true\n    },\n    {\n      \"key\": \"MOST_IMPORTANT_IMPROVEMENT\",\n      \"expected_role\": \"close\",\n      \"required\": true\n    }\n  ],\n  \"rules\": [\n    {\n      \"id\": \"R1\",\n      \"source_question_key\": \"LEARNER_EXPERIENCE_ELIGIBILITY\",\n      \"condition\": {\n        \"operator\": \"equals\",\n        \"values\": [\n          \"No\"\n        ]\n      },\n      \"action\": {\n        \"type\": \"terminate\"\n      },\n      \"reason\": \"Terminate respondents who cannot demonstrate sufficient LearnSphere or comparable digital-learning experience.\"\n    },\n    {\n      \"id\": \"R2\",\n      \"source_question_key\": \"RECENT_LEARNSPHERE_ACTIVITY\",\n      \"condition\": {\n        \"operator\": \"and_group\",\n        \"conditions\": [\n          {\n            \"operator\": \"equals\",\n            \"values\": [\n              \"No\"\n            ]\n          },\n          {\n            \"operator\": \"equals\",\n            \"values\": [\n              \"Current LearnSphere learner\"\n            ]\n          }\n        ]\n      },\n      \"action\": {\n        \"type\": \"terminate\"\n      },\n      \"reason\": \"A respondent classified as a current LearnSphere learner must report recent LearnSphere activity.\"\n    },\n    {\n      \"id\": \"R3\",\n      \"source_question_key\": \"RELEVANT_LEARNING_NEED\",\n      \"condition\": {\n        \"operator\": \"and_group\",\n        \"conditions\": [\n          {\n            \"operator\": \"equals\",\n            \"values\": [\n              \"No\"\n            ]\n          },\n          {\n            \"operator\": \"equals\",\n            \"values\": [\n              \"Potential digital-learning user\"\n            ]\n          }\n        ]\n      },\n      \"action\": {\n        \"type\": \"terminate\"\n      },\n      \"reason\": \"Potential users must report a relevant learning need.\"\n    },\n    {\n      \"id\": \"R4\",\n      \"source_question_key\": \"ALTERNATIVE_LEARNING_USE\",\n      \"condition\": {\n        \"operator\": \"and_group\",\n        \"conditions\": [\n          {\n            \"operator\": \"equals\",\n            \"values\": [\n              \"No\"\n            ]\n          },\n          {\n            \"operator\": \"equals\",\n            \"values\": [\n              \"Potential digital-learning user\"\n            ]\n          }\n        ]\n      },\n      \"action\": {\n        \"type\": \"terminate\"\n      },\n      \"reason\": \"Potential users must report experience with at least one alternative learning route.\"\n    },\n    {\n      \"id\": \"R5\",\n      \"source_question_key\": \"LEARNER_EXPERIENCE_ELIGIBILITY\",\n      \"condition\": {\n        \"operator\": \"equals\",\n        \"values\": [\n          \"No\"\n        ]\n      },\n      \"action\": {\n        \"type\": \"terminate\"\n      },\n      \"reason\": \"The declared eligibility gate fails before experience and satisfaction modules.\"\n    },\n    {\n      \"id\": \"R6\",\n      \"source_question_key\": \"MOST_IMPORTANT_IMPROVEMENT\",\n      \"condition\": {\n        \"operator\": \"answered\",\n        \"values\": []\n      },\n      \"action\": {\n        \"type\": \"complete\"\n      },\n      \"reason\": \"The respondent has completed the final applicable improvement response.\"\n    }\n  ],\n  \"display_rules\": [\n    {\n      \"target_question_key\": \"LEARNING_FORMAT_USEFULNESS\",\n      \"show_if\": {\n        \"LEARNER_EXPERIENCE_ELIGIBILITY\": [\n          \"Yes\"\n        ]\n      },\n      \"show_if_else\": \"skip\"\n    },\n    {\n      \"target_question_key\": \"JOURNEY_STAGE_EXPERIENCE\",\n      \"show_if\": {\n        \"LEARNER_EXPERIENCE_ELIGIBILITY\": [\n          \"Yes\"\n        ]\n      },\n      \"show_if_else\": \"skip\"\n    },\n    {\n      \"target_question_key\": \"SUPPORT_FEATURES_NOTICED\",\n      \"show_if\": {\n        \"LEARNER_EXPERIENCE_ELIGIBILITY\": [\n          \"Yes\"\n        ]\n      },\n      \"show_if_else\": \"skip\"\n    },\n    {\n      \"target_question_key\": \"FEEDBACK_AND_PROGRESS_VALUE\",\n      \"show_if\": {\n        \"LEARNER_EXPERIENCE_ELIGIBILITY\": [\n          \"Yes\"\n        ]\n      },\n      \"show_if_else\": \"skip\"\n    },\n    {\n      \"target_question_key\": \"LEARNER_EXPERIENCE_SATISFACTION\",\n      \"show_if\": {\n        \"LEARNER_EXPERIENCE_ELIGIBILITY\": [\n          \"Yes\"\n        ]\n      },\n      \"show_if_else\": \"skip\"\n    },\n    {\n      \"target_question_key\": \"ROLE_SPECIFIC_SUCCESS_CRITERIA\",\n      \"show_if\": {\n        \"STAKEHOLDER_ROLE\": [\n          \"Parent or guardian\",\n          \"Teacher or instructor\",\n          \"Academic administrator\"\n        ]\n      },\n      \"show_if_else\": \"skip\"\n    }\n  ],\n  \"dynamic_filters\": [\n    {\n      \"target_question_key\": \"ALTERNATIVE_SHARE_OF_LEARNING_TIME\",\n      \"filter_from_question_key\": \"ALTERNATIVE_PLATFORMS_USED\",\n      \"mode\": \"selected\",\n      \"requires_same_option_order\": true,\n      \"config\": {\n        \"mode\": \"choice\",\n        \"optMode\": \"choice\",\n        \"keepDeselectAll\": true,\n        \"enforceMinMaxFromCount\": false,\n        \"rankIn\": [],\n        \"alwaysKeep\": []\n      }\n    },\n    {\n      \"target_question_key\": \"LEARNING_FORMAT_USEFULNESS\",\n      \"filter_from_question_key\": \"LEARNING_FORMATS_USED\",\n      \"mode\": \"selected\",\n      \"requires_same_option_order\": true,\n      \"config\": {\n        \"mode\": \"choice\",\n        \"optMode\": \"choice\",\n        \"keepDeselectAll\": true,\n        \"enforceMinMaxFromCount\": false,\n        \"rankIn\": [],\n        \"alwaysKeep\": []\n      }\n    }\n  ],\n  \"branch_blocks\": [\n    {\n      \"id\": \"BB1\",\n      \"source_question_key\": \"LEARNER_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Current LearnSphere learner\",\n          \"member_question_keys\": [\n            \"COURSE_PROGRESS_STATUS\"\n          ]\n        },\n        {\n          \"option_label\": \"Former or inactive LearnSphere learner\",\n          \"member_question_keys\": [\n            \"LEARNING_STOP_POINT\"\n          ]\n        },\n        {\n          \"option_label\": \"Potential digital-learning user\",\n          \"member_question_keys\": [\n            \"ALTERNATIVE_LEARNING_USE\"\n          ]\n        }\n      ],\n      \"rejoin_question_key\": \"ALTERNATIVE_PLATFORMS_USED\"\n    },\n    {\n      \"id\": \"BB2\",\n      \"source_question_key\": \"LEARNER_STATUS\",\n      \"selection_mode\": \"single\",\n      \"blocks\": [\n        {\n          \"option_label\": \"Current LearnSphere learner\",\n          \"member_question_keys\": [\n            \"LIFECYCLE_INTENT_AND_WINBACK\"\n          ]\n        },\n        {\n          \"option_label\": \"Former or inactive LearnSphere learner\",\n          \"member_question_keys\": [\n            \"LIFECYCLE_INTENT_AND_WINBACK\"\n          ]\n        },\n        {\n          \"option_label\": \"Potential digital-learning user\",\n          \"member_question_keys\": [\n            \"LIFECYCLE_INTENT_AND_WINBACK\"\n          ]\n        }\n      ],\n      \"rejoin_question_key\": \"NPS_RECOMMENDATION\"\n    }\n  ],\n  \"rejoin_rules\": [\n    {\n      \"branch_end_question_key\": \"COURSE_PROGRESS_STATUS\",\n      \"rejoin_question_key\": \"ALTERNATIVE_PLATFORMS_USED\"\n    },\n    {\n      \"branch_end_question_key\": \"LEARNING_STOP_POINT\",\n      \"rejoin_question_key\": \"ALTERNATIVE_PLATFORMS_USED\"\n    },\n    {\n      \"branch_end_question_key\": \"ALTERNATIVE_LEARNING_USE\",\n      \"rejoin_question_key\": \"ALTERNATIVE_PLATFORMS_USED\"\n    },\n    {\n      \"branch_end_question_key\": \"LIFECYCLE_INTENT_AND_WINBACK\",\n      \"rejoin_question_key\": \"NPS_RECOMMENDATION\"\n    }\n  ],\n  \"completion_rules\": [\n    {\n      \"question_key\": \"MOST_IMPORTANT_IMPROVEMENT\",\n      \"condition\": \"always\",\n      \"outcome\": \"complete\"\n    }\n  ],\n  \"ambiguities\": [\n    \"The exact option labels for LEARNER_EXPERIENCE_ELIGIBILITY, RELEVANT_LEARNING_NEED, ALTERNATIVE_LEARNING_USE, and RECENT_LEARNSPHERE_ACTIVITY are not supplied; the gate rules use the declared semantic labels Yes and No.\",\n    \"The audience-system eligibility and Indian adult audience gate is external to the supplied flow_keys and therefore is not represented as a questionnaire routing rule.\",\n    \"The optional MaxDiff or forced-trade-off task has no flow_key and no validated candidate list, so no routing rule is emitted for it.\",\n    \"Quality-control mechanisms are declared as embedded controls without flow_keys; their terminate outcome must be implemented by the quality-control layer.\",\n    \"Role-specific multi-role sequencing is not specified. ROLE_SPECIFIC_SUCCESS_CRITERIA is protected for any applicable stakeholder role without creating separate role-specific question keys.\"\n  ],\n  \"validator_expectations\": [\n    \"All question_keys must exist in generated questions.\",\n    \"All routing references use flow_key values only; no qIds or UUIDs are permitted.\",\n    \"The declared branch_blocks are the authoritative lifecycle fan-out and must not be duplicated with per-member showIf or go_to rules.\",\n    \"All dynamic filters must use identical option text and option order between source and target questions.\",\n    \"Only conditionally visible non-branch targets have display rules.\",\n    \"No demographic routing is present.\",\n    \"Current, former or inactive, and potential-user paths rejoin the shared flow at ALTERNATIVE_PLATFORMS_USED.\",\n    \"The lifecycle branch rejoins at NPS_RECOMMENDATION.\",\n    \"Every valid respondent path reaches MOST_IMPORTANT_IMPROVEMENT and then the completion rule, while ineligible paths terminate at the declared screening gates.\"\n  ]\n}","model":"openai.gpt-5.6-luna","sources":[],"data":{"version":"1.0","source_business_flow_version":"1.0","question_keys":[{"key":"STAKEHOLDER_ROLE","expected_role":"screener","required":true},{"key":"LEARNER_STATUS","expected_role":"segment_classifier","required":true},{"key":"LEARNER_EXPERIENCE_ELIGIBILITY","expected_role":"screener","required":true},{"key":"RECENT_LEARNSPHERE_ACTIVITY","expected_role":"screener","required":true},{"key":"RELEVANT_LEARNING_NEED","expected_role":"screener","required":true},{"key":"LEARNING_FREQUENCY","expected_role":"dynamic_source","required":true},{"key":"COURSE_PROGRESS_STATUS","expected_role":"branch_followup","required":true},{"key":"LEARNING_STOP_POINT","expected_role":"branch_followup","required":true},{"key":"ALTERNATIVE_LEARNING_USE","expected_role":"branch_followup","required":true},{"key":"ALTERNATIVE_PLATFORMS_USED","expected_role":"dynamic_source","required":true},{"key":"CONTENT_RELEVANCE","expected_role":"dynamic_source","required":true},{"key":"LEARNING_FORMATS_USED","expected_role":"dynamic_source","required":true},{"key":"LEARNING_FORMAT_USEFULNESS","expected_role":"branch_followup","required":true},{"key":"ENGAGEMENT_BARRIERS","expected_role":"dynamic_source","required":true},{"key":"JOURNEY_STAGE_EXPERIENCE","expected_role":"branch_followup","required":tr