nd-color: #343434; }\n.ws-scroll { scrollbar-width: thin; scrollbar-color: #B0B0B0 #ECECEC; overscroll-behavior-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; }\n.ws-scroll::-webkit-scrollbar { width: 8px; height: 8px; -webkit-appearance: none; }\n.ws-scroll::-webkit-scrollbar-track { background: #ECECEC; border-radius: 4px; }\n.ws-scroll::-webkit-scrollbar-thumb { background: #B0B0B0; border-radius: 4px; border: 2px solid #ECECEC; }\n.ws-scroll::-webkit-scrollbar-thumb:hover { background: #9A9A9A; }\n"],["BUTTON",{"type":"button","aria-expanded":"false","class":"group flex items-center cursor-pointer select-none"},["DIV",{"class":"flex items-center gap-[6px]"},["SPAN",{"class":"relative inline-block flex-shrink-0","style":"width: 13px; height: 13px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-tint","style":"mask-image: url(\"/icons/leaf.svg\");"}]],["SPAN",{"class":"roboto_mono_dc771075-module__pIk42a__className flex items-center gap-[3px] text-[13px] font-normal leading-[140%] tracking-normal allow-text-select"},["SPAN",{"class":"font-normal text-[#464646] group-hover:font-medium group-hover:text-[#343434] transition-colors duration-200"},"Hypotheses and constructs — being formalised"]]],["SPAN",{"class":"relative inline-block self-center flex-shrink-0 ml-[4px] opacity-0 group-hover:opacity-100 scale-y-100 transition-[transform,opacity] duration-300","style":"width: 15px; height: 15px;"},["SPAN",{"aria-hidden":"true","class":"ws-icon-tint","style":"mask-image: url(\"/icons/down_chevron.svg\");"}]]],["DIV",{"class":"grid transition-[grid-template-rows] duration-300 ease-out","style":"grid-template-rows: 0fr;"},["DIV",{"class":"overflow-hidden min-w-0"},["DIV",{"class":"ml-[16px] mt-4 mb-[10px] min-w-0"},["DIV",{"class":"flex flex-col min-w-0"},["DIV",{"class":"flex gap-[8px] min-w-0"},["DIV",{"class":"flex flex-col items-center flex-shrink-0 w-4"},["SPAN",{"class":"flex items-center justify-center w-4 h-4"},["IMG",{"__playwright_current_src__