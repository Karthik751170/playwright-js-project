appearance: none !important;\n  height: 13px;\n  width: 13px;\n  border: 0;\n  border-radius: 50%;\n  background: #0fccce;\n  cursor: pointer;\n}\n.lf-progress::-ms-track {\n  width: 100%;\n  height: 3px;\n  cursor: pointer;\n  background: transparent;\n  border-color: transparent;\n  color: transparent;\n}\n.lf-progress::-ms-fill-lower {\n  background: #ccc;\n  border-radius: 3px;\n}\n.lf-progress::-ms-fill-upper {\n  background: #ccc;\n  border-radius: 3px;\n}\n.lf-progress::-ms-thumb {\n  border: 0;\n  height: 15px;\n  width: 15px;\n  border-radius: 50%;\n  background: #0fccce;\n  cursor: pointer;\n}\n.lf-progress:focus::-ms-fill-lower {\n  background: #ccc;\n}\n.lf-progress:focus::-ms-fill-upper {\n  background: #ccc;\n}\n.lf-player-container :focus {\n  outline: 0;\n}\n.lf-popover {\n  position: relative;\n}\n\n.lf-popover-content {\n  display: inline-block;\n  position: absolute;\n  opacity: 1;\n  visibility: visible;\n  transform: translate(0, -10px);\n  box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.26);\n  transition: all 0.3s cubic-bezier(0.75, -0.02, 0.2, 0.97);\n}\n\n.lf-popover-content.hidden {\n  opacity: 0;\n  visibility: hidden;\n  transform: translate(0, 0px);\n}\n\n.lf-player-btn-container {\n  display: flex;\n  align-items: center;\n}\n.lf-player-btn {\n  cursor: pointer;\n  fill: #999;\n  width: 14px;\n}\n\n.lf-player-btn.active {\n  fill: #555;\n}\n\n.lf-popover {\n  position: relative;\n}\n\n.lf-popover-content {\n  display: inline-block;\n  position: absolute;\n  background-color: #ffffff;\n  opacity: 1;\n\n  transform: translate(0, -10px);\n  box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.26);\n  transition: all 0.3s cubic-bezier(0.75, -0.02, 0.2, 0.97);\n  padding: 10px;\n}\n\n.lf-popover-content.hidden {\n  opacity: 0;\n  visibility: hidden;\n  transform: translate(0, 0px);\n}\n\n.lf-arrow {\n  position: absolute;\n  z-index: -1;\n  content: '';\n  bottom: -9px;\n  border-style: solid;\n  border-width: 10px 10px 0px 10px;\n}\n\n.lf-left-align,\n.lf-left-align .lfarrow {\n  left: 0;\n  right: unset;\n}\n\n.lf-right-align,\n.lf-right-align .lf-arrow {\n  right: 0;\n  left: unset;\n}\n\n.lf-text-input {\n  border: 1px #ccc solid;\n  border-radius: 5px;\n  padding: 3px;\n  width: 60px;\n  margin: 0;\n}\n\n.lf-color-picker {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  height: 90px;\n}\n\n.lf-color-selectors {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.lf-color-component {\n  display: flex;\n  flex-direction: row;\n  font-size: 12px;\n  align-items: center;\n  justify-content: center;\n}\n\n.lf-color-component strong {\n  width: 40px;\n}\n\n.lf-color-component input[type='range'] {\n  margin: 0 0 0 10px;\n}\n\n.lf-color-component input[type='number'] {\n  width: 50px;\n  margin: 0 0 0 10px;\n}\n\n.lf-color-preview {\n  font-size: 12px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: space-between;\n  padding-left: 5px;\n}\n\n.lf-preview {\n  height: 60px;\n  width: 60px;\n}\n\n.lf-popover-snapshot {\n  width: 150px;\n}\n.lf-popover-snapshot h5 {\n  margin: 5px 0 10px 0;\n  font-size: 0.75rem;\n}\n.lf-popover-snapshot a {\n  display: block;\n  text-decoration: none;\n}\n.lf-popover-snapshot a:before {\n  content: '⥼';\n  margin-right: 5px;\n}\n.lf-popover-snapshot .lf-note {\n  display: block;\n  margin-top: 10px;\n  color: #999;\n}\n.lf-player-controls > div {\n  margin-right: 5px;\n  margin-left: 5px;\n}\n.lf-player-controls > div:first-child {\n  margin-left: 0px;\n}\n.lf-player-controls > div:last-child {\n  margin-right: 0px;\n}\n"],["LINK",{"rel":"stylesheet","href":"/_next/static/chunks/3jk2anbhg3a05.css"}]],["BODY",{"class":"inter_ad991c7-module__LhgUwq__className inter_ad991c7-module__LhgUwq__variable roboto_20913b7b-module__RNtCNq__variable jetbrains_mono_68d574a-module__ggYvfa__variable","style":""},["DIV",{"hidden":""}]," ",["DIV",{"id":"main-content"},["DIV",{},["H1",{"class":"sr-only"},"Hercules AI Research Assistant"],["DIV",{"class":"sr-only max-w-4xl mx-auto px-4 py-16 text-gray-700 text-sm leading-relaxed space-y-10"},["SECTION",{},["H2",{"class":"text-2xl font-bold text-gray-900 mb-3"},"Hercules AI Research Agent"],["P",{},"Hercules is an AI-powered market research platform giving you instant access to 20+ million verified consumers. Run surveys, A/B tests, sentiment analysis, and consumer behavior research in minutes — not weeks."]],["SECTION",{},["H2",{"class":"text-xl font-semibold text-gray-900 mb-3"},"What You Can Do with Hercules AI"],["UL",{"class":"list-disc list-inside space-y-1"},["LI",{},"Create surveys from a single prompt using AI"],["LI",{},"Access 20+ million verified, bot-free respondents globally"],["LI",{},"Get real-time analytics and AI-summarized insights"],["LI",{},"Run concept testing, brand tracking, and NPS studies"],["LI",{},"Export data directly to your CRM or data lake"]]],["SECTION",{},["H2",{"class":"text-xl font-semibold text-gray-900 mb-3"},"Trusted by Leading Research Teams"],["P",{},"Used by organizations including Unilever, Greenply, ICICI, SBI, and Amul for fast, high-fidelity market research. Trusted by FMCG brands, BFSI companies, government bodies, and hundreds of Indian startups."]],["SECTION",{},["H2",{"class":"text-xl font-semibold text-gray-900 mb-3"},"AI-Powered Features"],["UL",{"class":"list-disc list-inside space-y-1"},["LI",{},"Natural language survey builder"],["LI",{},"Zero-Knowledge Proof (ZKP) participant verification"],["LI",{},"Automated sentiment and open-text analysis"],["LI",{},"Dynamic branching logic powered by AI"]]],["SECTION",{},["H2",{"class":"text-xl font-semibold text-gray-900 mb-3"},"How Hercules AI Works"],["P",{},"Describe your research goal in plain English and Hercules AI generates a complete, unbiased survey in seconds. Surveys are deployed to the SuperJ verified consumer panel via WhatsApp for maximum response rates across India. Poseidon — our analytics engine — automatically summarises open-text responses, detects sentiment trends, and surfaces actionable insights segmented by city, age, income, and behaviour."]],["SECTION",{},["H2",{"class":"text-xl font-semibold text-gray-900 mb-3"},"Why Verified Respondents Matter"],["P",{},"Every SuperJ respondent is identity-verified using Zero Knowledge Proof cryptography — ensuring each response comes from a real, unique human with no bots, no click-farms, and no duplicate submissions. This makes Hercules the most fraud-proof consumer research platform in India, and the only platform where you can trust every single data point in your results."]],["SECTION",{},["H2",{"class":"text-xl font-semibold text-gray-900 mb-3"},"Pricing"],["P",{},"Hercules AI is available on a free plan with 10 surveys per month and access to 300 verified SuperJ users. Paid plans start at ₹1,119 per month for unlimited AI access and the full 20M+ respondent panel. Pro plans at ₹30,000 per quarter include a dedicated account manager and custom research campaigns."]]],["DIV",{"class":"w-full overflow-hidden md:overflow-visible md:w-auto"},["DIV",{"class":"min-h-screen","style":"opacity: 1; transform: none;"},["DIV",{"class":"w-full overflow-x-hidden"},["DIV",{"class":"fixed top-0 left-0 right-0 z-[51] bg-white   border-[#E9E9E9] pl-[37px] pr-[36px] pt-[28px] pb-4 flex justify-between items-center transition-transform duration-300 ease-in-out translate-y-0 "},["DIV",{"class":"flex items-center gap-[18px]"},["DIV",{"class":"cursor-pointer lg:flex-shrink-0 flex items-center justify-center "},["DIV",{"class":"flex items-center lg:hidden"},["BUTTON",{"class":"focus:outline-none"},["DIV",{"class":"w-6 h-6 flex flex-col items-start gap-y-[5px]","aria-label":"Toggle menu"},["SPAN",{"class":"block w-[24px] h-[2.57px] rounded-full transition-transform duration-300 ease-in-out bg-[linear-gradient(180deg,#FD6700_0%,#FFCE00_700%)]"}],["SPAN",{"class":"block w-[16px] h-[2.57px] rounded-full transition-transform duration-300 ease-in-out 